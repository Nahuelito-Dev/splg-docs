sequenceDiagram
    title DSD — CU-163 Consultar El Vehiculo En Uso De Un Chofer
autonumber
participant CTRL as DeliveryVehicleController
participant DSRV as DeliveryService
participant VSRV as VehicleAssignmentService
participant FSRV as FleetTaskService
participant AREP as RepositoryVehicleAssignment

opt consulta el propio chofer (GET /delivery/me/vehicle)
    CTRL->>DSRV: findOneByUserId(user.user_id)
    DSRV-->>CTRL: Delivery o NotFoundException
end
CTRL->>VSRV: vehiculoEnUso(deliveryId, distributorId)
activate VSRV
VSRV->>VSRV: assertChoferDelTenant(deliveryId, distributorId)
alt chofer inexistente o de otra distribuidora
    VSRV-->>CTRL: NotFoundException
else chofer del tenant
    VSRV->>AREP: findOne(where delivery_id y released_at nulo, relations car)
    activate AREP
    AREP-->>VSRV: asignación abierta o null
    deactivate AREP
    VSRV-->>CTRL: asignación o null
end
deactivate VSRV
alt no hay asignación abierta
    CTRL-->>CTRL: null, respuesta sin cuerpo
else hay asignación abierta
    CTRL->>FSRV: motivosDeInhabilitacionDeVehiculo(carId, distributorId)
    activate FSRV
    FSRV-->>CTRL: lista de motivos
    deactivate FSRV
    CTRL->>CTRL: VehicleAssignmentMapper.toVehicleInUseDto(asignación, motivos no vacíos)
end
