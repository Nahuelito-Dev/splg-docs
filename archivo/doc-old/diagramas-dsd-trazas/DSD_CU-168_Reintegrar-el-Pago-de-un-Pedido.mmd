sequenceDiagram
    title DSD — CU-168 Reintegrar El Pago De Un Pedido
autonumber
participant CAN as CancelOrderUseCase
participant BUS as EventEmitter2
participant LIS as ReintegroListener
participant UC as RefundPaymentUseCase
participant PAY as PaymentsService
participant GW as PaymentGatewayPort
participant PREP as RepositoryPayment
participant RT as RealtimeDispatchPort

CAN->>BUS: emit(pedido.cancelado, pedidoId)
BUS->>LIS: onPedidoCancelado(evento)
activate LIS
LIS->>UC: execute(pedidoId, importe)
activate UC
UC->>PAY: findApprovedByOrder(pedidoId)
activate PAY
PAY->>PREP: find(order_id, status APPROVED, gateway distinto de CASH)
PREP-->>PAY: lista de Payment
PAY-->>UC: pagos aprobados por pasarela
deactivate PAY
alt no hay pagos aprobados por pasarela
    UC-->>LIS: sin devolución
else hay pagos aprobados
    loop por cada pago aprobado
        UC->>GW: refundPayment(gatewayPaymentId, importe, claveDeIdempotencia)
        alt la pasarela acepta
            GW-->>UC: devolución aceptada
            UC->>PAY: markRefunded(paymentId)
            PAY->>PREP: save(payment con status REFUNDED)
            PREP-->>PAY: Payment
            PAY-->>UC: Payment reintegrado
            UC->>RT: notifyAdmins(payment:refunded, datos, distributorId)
            UC->>RT: notifyCustomer(customerId, payment:refunded, datos)
        else la pasarela rechaza o no responde
            GW-->>UC: error de la pasarela
            UC->>RT: notifyAdmins(payment:refund-failed, datos, distributorId)
        end
    end
    UC-->>LIS: resultado de la devolución
end
deactivate UC
deactivate LIS
