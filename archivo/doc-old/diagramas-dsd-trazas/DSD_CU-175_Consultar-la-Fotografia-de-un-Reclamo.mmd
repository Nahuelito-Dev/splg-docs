sequenceDiagram
    title DSD — CU-175 Consultar La Fotografía De Un Reclamo
autonumber
participant CTRL as ClaimsController
participant SRV as ClaimsService
participant STO as StoragePort

CTRL->>SRV: getPhoto(id, user, distributorId)
activate SRV
SRV->>SRV: findOne(id, distributorId)
alt el reclamo no existe o es de otra distribuidora
    SRV-->>CTRL: NotFoundException Reclamo no encontrado
else el reclamo existe
    SRV->>SRV: assertEsDelCliente(claim, user)
    alt el solicitante es un cliente y el reclamo no es suyo
        SRV-->>CTRL: NotFoundException Reclamo no encontrado
    else el solicitante puede ver el reclamo
        alt el reclamo no tiene fotografia
            SRV-->>CTRL: NotFoundException El reclamo no tiene fotografia
        else la fotografia es una direccion externa
            SRV-->>CTRL: redireccion a la direccion registrada
        else la fotografia esta en el almacenamiento
            SRV->>STO: getDownloadUrl(key)
            STO-->>SRV: URL firmada o null
            alt el adaptador entrega una URL firmada
                SRV-->>CTRL: redireccion a la URL firmada
            else el adaptador es el disco local
                SRV->>STO: getStream(key)
                STO-->>SRV: stream y contentType
                SRV-->>CTRL: archivo con su tipo original
            end
        end
    end
end
deactivate SRV
