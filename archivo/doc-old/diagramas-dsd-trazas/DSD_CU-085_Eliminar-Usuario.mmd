sequenceDiagram
    title DSD — CU-085 Eliminar Usuario
autonumber
participant RG as RolesGuard
participant CTRL as UsersController
participant SRV as UsersService
participant REP as RepositoryUser
participant OLS as OrderLookupService
participant EV as EventEmitter2
participant LIS as VehicleReleaseOnBajaListener
participant FB as FirebaseAuthPort

RG->>RG: canActivate(ctx) contra Roles ADMIN y SUPER_ADMIN
alt Rol insuficiente
    RG-->>CTRL: ForbiddenException Acceso denegado
else Autorizado
    RG-->>CTRL: true
    Note over CTRL: «include» CU-083 Buscar y Listar Usuarios
    CTRL->>CTRL: assertPuedeAdministrar(id, user, distributorId)
    opt Hay distribuidora en contexto
        CTRL->>SRV: perteneceA(id, distributorId)
        SRV-->>CTRL: true o false
    end
    opt user.role es ADMIN, administrador de empresa
        CTRL->>SRV: findAlcance(id)
        SRV-->>CTRL: rol del usuario destino
    end
    alt No es de la distribuidora, o es un super admin
        CTRL-->>RG: NotFoundException User with ID not found
    else Un admin de empresa sobre la cuenta de un cliente
        CTRL-->>RG: ForbiddenException La cuenta de un cliente la administra el administrador general
    else Puede administrarlo
        CTRL->>SRV: remove(id)
        activate SRV
        SRV->>REP: findOne(user_id, relations customer delivery addresses)
        activate REP
        alt No existe
            REP-->>SRV: null
            SRV-->>CTRL: NotFoundException User with ID not found
        else Existe
            REP-->>SRV: User con perfil y direcciones
            deactivate REP
            SRV->>SRV: dataSource.transaction
            opt El usuario tiene perfil de chofer
                SRV->>OLS: countActiveByDelivery(deliveryId, manager)
                OLS-->>SRV: cantidad de pedidos en curso
            end
            alt Es un chofer con pedidos aceptados o en camino
                SRV-->>CTRL: ConflictException El chofer tiene pedidos en curso, la transaccion se revierte
            else Puede darse de baja
                SRV->>REP: softRemove(user)
                Note over SRV,REP: baja logica en cascada, sin tocar los vehiculos
                opt El usuario tiene perfil de chofer
                    SRV->>EV: emitAsync(chofer.dado-de-baja, deliveryId, manager)
                    EV->>LIS: handle(evento)
                    Note over LIS: libera el vehiculo en uso en la misma transaccion
                end
                SRV->>SRV: confirmar la transaccion
                opt El usuario tiene firebase_uid
                    SRV->>FB: updateUser(firebase_uid, disabled true)
                    activate FB
                    alt Firebase falla tras los reintentos
                        FB-->>SRV: error
                        SRV->>SRV: logger.error con la cuenta a deshabilitar a mano, la baja queda hecha
                    else Cuenta deshabilitada
                        FB-->>SRV: cuenta deshabilitada
                    end
                    deactivate FB
                end
                SRV-->>CTRL: message Usuario dado de baja
            end
        end
        deactivate SRV
    end
end
