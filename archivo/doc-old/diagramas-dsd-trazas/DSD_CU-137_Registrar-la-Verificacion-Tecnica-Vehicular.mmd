sequenceDiagram
    title DSD — CU-137 Registrar la Verificacion Tecnica Vehicular
    autonumber
    participant CTRL as FleetTaskController
    participant SRV as FleetTaskService
    participant PREP as RepositoryMaintenancePlan
    participant CARS as CarService
    participant TREP as RepositoryMaintenanceTask

    CTRL->>SRV: create(dto con planId del plan VTV, carId, dueAt, distribuidora)
    activate SRV
    SRV->>PREP: findOne(where plan_id y distributor_id)
    activate PREP
    alt el plan no existe o es de otra distribuidora
        PREP-->>SRV: null
        SRV-->>CTRL: NotFoundException Plan no encontrado
    else el plan existe
        PREP-->>SRV: MaintenancePlan con subject vehicle
        deactivate PREP
        SRV->>SRV: assertSujetoCoherente, exige carId y no deliveryId
        SRV->>CARS: findOne(carId, distribuidora)
        activate CARS
        alt el vehiculo no existe o es de otra distribuidora
            CARS-->>SRV: NotFoundException
            SRV-->>CTRL: NotFoundException
        else el vehiculo existe
            CARS-->>SRV: Car
            deactivate CARS
            SRV->>TREP: save(MaintenanceTask en estado scheduled, con carId y dueAt)
            activate TREP
            TREP-->>SRV: MaintenanceTask programada
            deactivate TREP
            SRV-->>CTRL: MaintenanceTask
            CTRL->>CTRL: FleetTaskMapper.toDto a FleetTaskResponseDto, con expirationStatus (calcularEstadoDeVencimiento) y blocks (criticidad del plan)
        end
    end
    deactivate SRV
