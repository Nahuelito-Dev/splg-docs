sequenceDiagram
    title DSD — CU-174 Adjuntar La Fotografía De Un Reclamo
autonumber
participant CTRL as ClaimsController
participant SRV as ClaimsService
participant STO as StoragePort
participant CREP as RepositoryClaim

CTRL->>SRV: attachPhoto(id, file, user, distributorId)
activate SRV
SRV->>SRV: findOne(id, distributorId)
alt el reclamo no existe o es de otra distribuidora
    SRV-->>CTRL: NotFoundException Reclamo no encontrado
else el reclamo existe
    SRV->>SRV: assertEsDelCliente(claim, user)
    alt el solicitante es un cliente y el reclamo no es suyo
        SRV-->>CTRL: NotFoundException Reclamo no encontrado
    else el solicitante puede modificar el reclamo
        alt no vino ningun archivo
            SRV-->>CTRL: BadRequestException Falta el archivo
        else el tipo no esta permitido
            SRV-->>CTRL: UnsupportedMediaTypeException
        else el archivo supera 5 MB
            SRV-->>CTRL: PayloadTooLargeException
        else el archivo es valido
            SRV->>STO: put(key, body, contentType)
            STO-->>SRV: archivo guardado
            SRV->>CREP: save(claim con photoUrl igual a la clave)
            alt guardar la referencia falla
                CREP-->>SRV: error de base
                SRV->>STO: remove(key)
            else se guardo
                CREP-->>SRV: Claim
                SRV->>STO: remove(claveAnterior) si la habia
                SRV-->>CTRL: Claim
                CTRL->>CTRL: ClaimMapper.toDto(claim) a ClaimResponseDto
            end
        end
    end
end
deactivate SRV
