sequenceDiagram
    title DSD — CU-155 Adjuntar Archivo A Una Tarea De Flota
autonumber
participant CTRL as FleetTaskController
participant SRV as FleetAttachmentService
participant TSRV as FleetTaskService
participant STO as StoragePort
participant AREP as RepositoryMaintenanceTaskAttachment

CTRL->>SRV: upload(taskId, distributorId, file, uploadedByUserId)
activate SRV
SRV->>TSRV: findOne(taskId, distributorId)
activate TSRV
alt la tarea no existe o es de otra distribuidora
    TSRV-->>SRV: NotFoundException
    SRV-->>CTRL: NotFoundException
else la tarea existe
    TSRV-->>SRV: MaintenanceTask
    deactivate TSRV
    alt no vino ningun archivo
        SRV-->>CTRL: BadRequestException Falta el archivo
    else el mime type no esta permitido
        SRV-->>CTRL: UnsupportedMediaTypeException
    else el archivo supera el maximo
        SRV-->>CTRL: PayloadTooLargeException
    else el archivo es valido
        SRV->>SRV: arma la clave fleet slash distributorId slash taskId slash uuid punto extension
        SRV->>STO: put(key, body, contentType)
        activate STO
        STO-->>SRV: archivo guardado
        deactivate STO
        SRV->>AREP: save(MaintenanceTaskAttachment con la clave y la metadata)
        activate AREP
        alt guardar la referencia falla
            AREP-->>SRV: error de base
            SRV->>STO: remove(key)
            activate STO
            deactivate STO
        else se guardo
            AREP-->>SRV: MaintenanceTaskAttachment
            deactivate AREP
            SRV-->>CTRL: MaintenanceTaskAttachment
            CTRL->>CTRL: FleetAttachmentMapper.toDto a FleetTaskAttachmentResponseDto
        end
    end
end
deactivate SRV
