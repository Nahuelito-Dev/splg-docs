sequenceDiagram
    title DSD — CU-162 Liberar El Vehiculo En Uso De Un Chofer
autonumber
participant CTRL as DeliveryVehicleController
participant VSRV as VehicleAssignmentService
participant AREP as RepositoryVehicleAssignment

CTRL->>VSRV: liberar(id, distributorId, user.user_id)
activate VSRV
VSRV->>VSRV: assertChoferDelTenant(id, distributorId)
alt chofer inexistente o de otra distribuidora
    VSRV-->>CTRL: NotFoundException
else chofer del tenant
    VSRV->>VSRV: assertSinViajeEnCurso(id)
    alt el chofer tiene un pedido ACCEPTED u ON_THE_WAY
        VSRV-->>CTRL: ConflictException
    else sin viaje en curso
        VSRV->>AREP: findOne(where delivery_id y released_at nulo)
        activate AREP
        AREP-->>VSRV: asignación abierta o null
        deactivate AREP
        alt no tiene vehículo en uso
            VSRV-->>CTRL: NotFoundException El chofer no tiene un vehículo en uso
        else tiene vehículo en uso
            VSRV->>AREP: save(released_at igual ahora, released_by igual user.user_id)
            activate AREP
            AREP-->>VSRV: asignación cerrada
            deactivate AREP
            VSRV-->>CTRL: void
            CTRL->>CTRL: MessageResponseDto Vehículo liberado
        end
    end
end
deactivate VSRV
