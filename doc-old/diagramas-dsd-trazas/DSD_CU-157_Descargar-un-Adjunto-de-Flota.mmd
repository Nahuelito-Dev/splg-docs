sequenceDiagram
    title DSD — CU-157 Descargar Un Adjunto De Flota
autonumber
participant CTRL as FleetTaskController
participant SRV as FleetAttachmentService
participant AREP as RepositoryMaintenanceTaskAttachment
participant STO as StoragePort

CTRL->>SRV: getDownload(taskId, attachmentId, distributorId)
activate SRV
SRV->>AREP: findOne(where attachment_id, task_id y distributor_id)
activate AREP
alt no existe
    AREP-->>SRV: null
    SRV-->>CTRL: NotFoundException
else existe
    AREP-->>SRV: MaintenanceTaskAttachment
    deactivate AREP
    SRV->>STO: getDownloadUrl(storageKey)
    activate STO
    alt el adaptador activo ofrece URL directa (S3)
        STO-->>SRV: URL firmada
        deactivate STO
        SRV-->>CTRL: kind redirect, url
        CTRL->>CTRL: 302 a la URL firmada
    else no la ofrece (disco local)
        STO-->>SRV: null
        SRV->>STO: getStream(storageKey)
        activate STO
        STO-->>SRV: flujo de lectura, tipo de contenido y tamaño
        deactivate STO
        SRV-->>CTRL: kind stream, fileName, mimeType, stream, sizeBytes
        CTRL->>CTRL: set Content-Type, Content-Disposition y Content-Length, y stream.pipe(res)
    end
end
deactivate SRV
