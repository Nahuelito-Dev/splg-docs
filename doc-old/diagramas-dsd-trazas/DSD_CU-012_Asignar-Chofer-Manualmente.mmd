sequenceDiagram
    title DSD — CU-012 Asignar Chofer Manualmente
autonumber
participant RG as RolesGuard
participant CTRL as OrderController
participant SRV as OrderService
participant ORD as OrderRepositoryPort
participant DSRV as DeliveryService
participant FLK as FleetDispatchLockService
participant QR as QueryRunner
participant FSM as OrderStatusMachine
participant OFR as DispatchOfferRepositoryPort
participant RT as RealtimeDispatchPort
participant MAP as OrderMapper

RG->>RG: canActivate(ctx) contra Roles ADMIN y SUPER_ADMIN
alt Rol insuficiente
    RG-->>CTRL: ForbiddenException Acceso denegado
else Autorizado
    RG-->>CTRL: true
    CTRL->>SRV: assertDeLaDistribuidora(id, distributorId)
    SRV->>ORD: findById(id)
    ORD-->>SRV: Order o null
    alt Pedido de otra distribuidora que la del contexto
        SRV-->>CTRL: NotFoundException Order with ID not found
    else Misma distribuidora o sin distribuidora en contexto
        SRV-->>CTRL: sin error
        CTRL->>SRV: assignDelivery(id, deliveryId)
        activate SRV
        SRV->>DSRV: findById(deliveryId)
        alt Chofer inexistente
            DSRV-->>SRV: null
            SRV-->>CTRL: NotFoundException Repartidor no encontrado
        else Chofer encontrado
            DSRV-->>SRV: Delivery
            SRV->>QR: connect() y startTransaction()
            SRV->>QR: leer el pedido con bloqueo pesimista
            alt Pedido inexistente
                SRV-->>CTRL: NotFoundException Order with ID not found
            else Chofer de otra distribuidora que la del pedido
                SRV-->>CTRL: NotFoundException Repartidor no encontrado
            else Chofer de la distribuidora del pedido
                SRV->>DSRV: assertElegibleParaAsignacion(delivery)
                alt Chofer deshabilitado
                    SRV-->>CTRL: BadRequestException El repartidor esta deshabilitado
                else Chofer no validado
                    SRV-->>CTRL: BadRequestException El repartidor no esta validado
                else Chofer habilitado y validado
                    SRV->>FLK: assertChoferHabilitado(delivery.user_id, distributorId)
                    Note over SRV,FLK: sin vehiculo en uso o con documentacion vencida, BadRequestException No se puede asignar
                    SRV->>FLK: vehiculoEnUsoDelChofer(delivery.user_id, distributorId)
                    FLK-->>SRV: patente, marca y modelo del vehiculo en uso
                    SRV->>SRV: guardar previousDriverUserId, delivery_id igual a deliveryId y copia del vehiculo
                    SRV->>FSM: transitionOrder(order, ACCEPTED)
                    alt Transicion ilegal desde el estado actual
                        FSM-->>SRV: InvalidOrderTransitionError
                        SRV-->>CTRL: error 400 via GlobalExceptionFilter
                    else Transicion valida o reasignacion de un pedido ya aceptado
                        FSM-->>SRV: pedido con el estado ACCEPTED
                        SRV->>SRV: acceptedAt igual a new Date y generateDeliveryCode
                        SRV->>QR: save(order) y commitTransaction()
                        SRV->>OFR: closeAllActiveOffers(orderId, EXPIRED)
                        opt Habia otro chofer asignado
                            SRV->>RT: stopTracking(previousDriverUserId)
                            SRV->>RT: notifyDriverOrderCancelled(previousDriverUserId, payload de reasignacion)
                        end
                        SRV->>RT: notifyAdmins(order accepted, payload, distributorId)
                        SRV->>RT: notifyDriverNewOrder(driverUserId, payload NEW_ORDER)
                        SRV->>SRV: findOne(orderId)
                        SRV-->>CTRL: Order en estado ACCEPTED
                        CTRL->>MAP: toDto(order)
                        MAP-->>CTRL: OrderResponseDto
                    end
                end
            end
        end
        deactivate SRV
    end
end
