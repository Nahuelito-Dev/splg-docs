sequenceDiagram
    title DSD — CU-173 Configurar La Frecuencia De Las Tareas Programadas
autonumber
participant CTRL as ModuleConfigController
participant SRV as ModuleConfigService
participant CREP as RepositoryModuleConfig
participant GATE as ScheduledTaskGate
participant RDS as RedisService

CTRL->>SRV: actualizar(distributorId, scheduled_tasks, intervalos, actorUserId)
activate SRV
SRV->>SRV: validarParametros(scheduled_tasks, intervalos)
alt algún intervalo es inválido
    SRV-->>CTRL: BadRequestException con el detalle del campo
else los intervalos son válidos
    SRV->>CREP: findOne(where distributor_id y module)
    CREP-->>SRV: ModuleConfig o null
    SRV->>CREP: save(distributor_id, module, params, updated_by_user_id)
    CREP-->>SRV: ModuleConfig
    SRV->>GATE: reprogramar(distributorId)
    activate GATE
    GATE->>RDS: del(marca de última ejecución de cada tarea y la distribuidora)
    GATE-->>SRV: tareas reprogramadas
    deactivate GATE
    SRV-->>CTRL: ModuleConfig
    CTRL->>CTRL: ModuleConfigMapper.toDto(config)
end
deactivate SRV
