@startuml
title Modelo físico — Gastos de la flota
!include ../../../diagramas/estilo-vp.iuml
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}

hide circle
skinparam linetype polyline

entity "tire" as e_tire {
  {field} **tire_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} serial_number : varchar(60) *
  {field} brand : varchar(60) *
  {field} size : varchar(40) *
  {field} cost : numeric(12,2) *
  {field} status : tire_status_enum *
  {field} //car_id// : uuid <<FK>>
  {field} position : varchar(6)
  {field} mounted_odometer_km : integer
  {field} km_traveled : integer *
  {field} retread_count : integer *
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
}
entity "vehicle_accident" as e_vehicle_accident {
  {field} **accident_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //car_id// : uuid * <<FK>>
  {field} //employee_id// : uuid <<FK>>
  {field} occurred_at : timestamptz *
  {field} location : geometry
  {field} address : text
  {field} description : text *
  {field} injuries : boolean *
  {field} third_parties_involved : boolean *
  {field} hazmat_release : boolean *
  {field} police_report_number : varchar(40)
  {field} insurer_claim_number : varchar(40)
  {field} status : vehicle_accident_status_enum *
  {field} vehicle_unusable : boolean *
  {field} repair_cost : numeric(12,2)
  {field} insurer_reimbursement : numeric(12,2)
  {field} deductible_amount : numeric(12,2)
  {field} closed_at : timestamptz
  {field} //created_by_user_id// : uuid * <<FK>>
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
}
entity "fuel_load" as e_fuel_load {
  {field} **fuel_load_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //car_id// : uuid * <<FK>>
  {field} //employee_id// : uuid <<FK>>
  {field} loaded_at : timestamptz *
  {field} fuel_type : fuel_type_enum *
  {field} liters : numeric(10,2) *
  {field} unit_price : numeric(12,3) *
  {field} total_amount : numeric(12,2) *
  {field} odometer_km : integer *
  {field} is_full_tank : boolean *
  {field} station : varchar(120)
  {field} payment_method : fuel_payment_method_enum *
  {field} receipt_number : varchar(40)
  {field} anomaly : boolean *
  {field} notes : text
  {field} odometer_correction_note : text
  {field} //created_by_user_id// : uuid * <<FK>>
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
  {field} deletedAt : timestamptz
  {field} //cash_movement_id// : uuid <<FK>>
  {field} registered_by_driver : boolean *
  {field} cash_payment_legacy : boolean *
}
entity "tire_event" as e_tire_event {
  {field} **event_id** : uuid * <<PK>>
  {field} //tire_id// : uuid * <<FK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} type : tire_event_type_enum *
  {field} //car_id// : uuid <<FK>>
  {field} position : varchar(6)
  {field} odometer_km : integer *
  {field} //created_by_user_id// : uuid * <<FK>>
  {field} createdAt : timestamptz *
}
entity "traffic_fine" as e_traffic_fine {
  {field} **fine_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //car_id// : uuid * <<FK>>
  {field} //employee_id// : uuid <<FK>>
  {field} occurred_at : timestamptz *
  {field} jurisdiction : varchar(80) *
  {field} act_number : varchar(40) *
  {field} infraction : text *
  {field} amount : numeric(12,2) *
  {field} voluntary_payment_amount : numeric(12,2)
  {field} due_date : date
  {field} status : traffic_fine_status_enum *
  {field} paid_at : timestamptz
  {field} paid_amount : numeric(12,2)
  {field} charged_to_employee : boolean *
  {field} void_reason : text
  {field} voided_at : timestamptz
  {field} alerted_at : timestamptz
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
  {field} //cash_movement_id// : uuid <<FK>>
}
entity "car" as e_car #F1F1F1 {
}
entity "employee" as e_employee #F1F1F1 {
}
entity "user" as e_user #F1F1F1 {
}
entity "cash_movement" as e_cash_movement #F1F1F1 {
}

e_car |o--o{ e_tire : car_id
e_employee |o--o{ e_vehicle_accident : employee_id
e_user ||--o{ e_vehicle_accident : created_by_user_id
e_car ||--o{ e_vehicle_accident : car_id
e_car ||--o{ e_fuel_load : car_id
e_user ||--o{ e_fuel_load : created_by_user_id
e_employee |o--o{ e_fuel_load : employee_id
e_cash_movement |o--o{ e_fuel_load : cash_movement_id
e_tire ||--o{ e_tire_event : tire_id
e_car |o--o{ e_tire_event : car_id
e_user ||--o{ e_tire_event : created_by_user_id
e_car ||--o{ e_traffic_fine : car_id
e_employee |o--o{ e_traffic_fine : employee_id
e_cash_movement |o--o{ e_traffic_fine : cash_movement_id

legend bottom
|<#F1F1F1> **tabla de otro contexto** | solo se muestra su nombre; sus columnas están en su propio contexto |
|<#FFFFFF> **distributor_id** | la tabla pertenece a una distribuidora (FK a distributor); la línea no se dibuja |
endlegend
note as N
  Los nombres reflejan la base real: conviven camelCase (paymentMethod, createdAt, isActive) y snake_case
  (scheduled_date, delivery_mode) porque las columnas más antiguas se crearon así y las posteriores siguieron
  otra convención; la tabla claims está en plural y el resto en singular.
end note
@enduml