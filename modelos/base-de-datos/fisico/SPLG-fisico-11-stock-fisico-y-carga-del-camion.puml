@startuml
title Modelo físico — Stock físico y carga del camión
!include ../../../diagramas/estilo-vp.iuml
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}

hide circle
skinparam linetype polyline

entity "warehouse" as e_warehouse {
  {field} **warehouse_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} name : varchar(80) *
  {field} code : varchar(12) *
  {field} kind : warehouse_kind_enum *
  {field} address : text
  {field} is_default : boolean *
  {field} is_active : boolean *
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
  {field} deletedAt : timestamptz
}
entity "stock_threshold" as e_stock_threshold {
  {field} **threshold_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //warehouse_id// : uuid * <<FK>>
  {field} //gas_cylinder_id// : uuid * <<FK>>
  {field} min_full : integer *
  {field} alerted_at : timestamptz
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
}
entity "stock_location" as e_stock_location {
  {field} **location_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} kind : stock_location_kind_enum *
  {field} //warehouse_id// : uuid <<FK>>
  {field} //car_id// : uuid <<FK>>
  {field} createdAt : timestamptz *
}
entity "stock_adjustment" as e_stock_adjustment {
  {field} **adjustment_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} number : integer *
  {field} //location_id// : uuid * <<FK>>
  {field} reason : stock_adjustment_reason_enum *
  {field} notes : text *
  {field} batch_id : uuid *
  {field} //created_by_user_id// : uuid * <<FK>>
  {field} createdAt : timestamptz *
}
entity "stock_balance" as e_stock_balance {
  {field} **balance_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //location_id// : uuid * <<FK>>
  {field} //gas_cylinder_id// : uuid * <<FK>>
  {field} condition : stock_condition_enum *
  {field} quantity : integer *
  {field} updatedAt : timestamptz *
}
entity "stock_movement" as e_stock_movement {
  {field} **movement_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //gas_cylinder_id// : uuid * <<FK>>
  {field} batch_id : uuid *
  {field} quantity : integer *
  {field} //from_location_id// : uuid <<FK>>
  {field} from_condition : stock_condition_enum
  {field} //to_location_id// : uuid <<FK>>
  {field} to_condition : stock_condition_enum
  {field} reason : stock_movement_reason_enum *
  {field} reference_type : stock_movement_reference_type_enum *
  {field} reference_id : uuid
  {field} //reversed_movement_id// : uuid <<FK>>
  {field} notes : varchar(300)
  {field} //actor_user_id// : uuid <<FK>>
  {field} occurred_at : timestamptz *
  {field} createdAt : timestamptz *
}
entity "truck_load" as e_truck_load {
  {field} **load_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} number : integer *
  {field} //car_id// : uuid * <<FK>>
  {field} //delivery_id// : uuid * <<FK>>
  {field} //helper_employee_id// : uuid <<FK>>
  {field} //origin_location_id// : uuid * <<FK>>
  {field} business_date : date *
  {field} status : truck_load_status_enum *
  {field} opened_at : timestamptz *
  {field} departed_at : timestamptz
  {field} returned_at : timestamptz
  {field} closed_at : timestamptz
  {field} //opened_by_user_id// : uuid * <<FK>>
  {field} //closed_by_user_id// : uuid <<FK>>
  {field} difference_note : text
  {field} cancel_reason : text
  {field} notes : text
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
}
entity "stock_adjustment_item" as e_stock_adjustment_item {
  {field} **item_id** : uuid * <<PK>>
  {field} //adjustment_id// : uuid * <<FK>>
  {field} //gas_cylinder_id// : uuid * <<FK>>
  {field} condition : stock_condition_enum *
  {field} quantity_delta : integer *
}
entity "truck_load_item" as e_truck_load_item {
  {field} **item_id** : uuid * <<PK>>
  {field} //load_id// : uuid * <<FK>>
  {field} //gas_cylinder_id// : uuid * <<FK>>
  {field} loaded_full : integer *
  {field} reloaded_full : integer *
  {field} loaded_empty : integer *
  {field} declared_return_full : integer
  {field} declared_return_empty : integer
  {field} delivered_full : integer
  {field} collected_empty : integer
  {field} expected_full : integer
  {field} expected_empty : integer
  {field} difference_full : integer
  {field} difference_empty : integer
}
entity "gas_cylinder" as e_gas_cylinder #F1F1F1 {
}
entity "car" as e_car #F1F1F1 {
}
entity "user" as e_user #F1F1F1 {
}
entity "delivery" as e_delivery #F1F1F1 {
}
entity "employee" as e_employee #F1F1F1 {
}

e_gas_cylinder ||--o{ e_stock_threshold : gas_cylinder_id
e_warehouse ||--o{ e_stock_threshold : warehouse_id
e_car |o--o| e_stock_location : car_id
e_warehouse |o--o| e_stock_location : warehouse_id
e_user ||--o{ e_stock_adjustment : created_by_user_id
e_stock_location ||--o{ e_stock_adjustment : location_id
e_gas_cylinder ||--o{ e_stock_balance : gas_cylinder_id
e_stock_location ||--o{ e_stock_balance : location_id
e_user |o--o{ e_stock_movement : actor_user_id
e_stock_location |o--o{ e_stock_movement : from_location_id
e_gas_cylinder ||--o{ e_stock_movement : gas_cylinder_id
e_stock_movement |o--o{ e_stock_movement : reversed_movement_id
e_stock_location |o--o{ e_stock_movement : to_location_id
e_car ||--o{ e_truck_load : car_id
e_user |o--o{ e_truck_load : closed_by_user_id
e_delivery ||--o{ e_truck_load : delivery_id
e_employee |o--o{ e_truck_load : helper_employee_id
e_user ||--o{ e_truck_load : opened_by_user_id
e_stock_location ||--o{ e_truck_load : origin_location_id
e_stock_adjustment ||--o{ e_stock_adjustment_item : adjustment_id
e_gas_cylinder ||--o{ e_stock_adjustment_item : gas_cylinder_id
e_gas_cylinder ||--o{ e_truck_load_item : gas_cylinder_id
e_truck_load ||--o{ e_truck_load_item : load_id

legend bottom
|<#F1F1F1> **tabla de otro contexto** | solo se muestra su nombre; sus columnas están en su propio contexto |
|<#FFFFFF> **distributor_id** | la tabla pertenece a una distribuidora (FK a distributor); la línea no se dibuja |
endlegend
note as N
  Los nombres reflejan la base real: conviven camelCase (paymentMethod, createdAt, isActive) y snake_case
  (scheduled_date, delivery_mode) porque las columnas más antiguas se crearon así y las posteriores siguieron
  otra convención; la tabla claims está en plural y el resto en singular.
end note
@enduml