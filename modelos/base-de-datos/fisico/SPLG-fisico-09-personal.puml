@startuml
title Modelo físico — Personal
!include ../../../diagramas/estilo-vp.iuml
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}

hide circle
skinparam linetype polyline

entity "job_position" as e_job_position {
  {field} **position_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} name : varchar(80) *
  {field} category : job_position_category_enum *
  {field} is_active : boolean *
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
  {field} deletedAt : timestamptz
}
entity "attachment" as e_attachment {
  {field} **attachment_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} owner_type : attachment_owner_type_enum *
  {field} owner_id : uuid *
  {field} label : varchar(80)
  {field} storage_key : varchar(255) *
  {field} original_name : varchar(255) *
  {field} mime_type : varchar(100) *
  {field} size_bytes : integer *
  {field} //uploaded_by_user_id// : uuid * <<FK>>
  {field} uploaded_at : timestamptz *
  {field} deleted_at : timestamptz
}
entity "employee" as e_employee {
  {field} **employee_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //user_id// : uuid <<FK>>
  {field} //position_id// : uuid * <<FK>>
  {field} file_number : varchar(20) *
  {field} first_name : varchar(80) *
  {field} last_name : varchar(80) *
  {field} document_type : employee_document_type_enum *
  {field} document_number : varchar(20) *
  {field} cuil : varchar(11)
  {field} birth_date : date
  {field} address_line : varchar(200)
  {field} city : varchar(80)
  {field} province : varchar(80)
  {field} postal_code : varchar(10)
  {field} phone : varchar(30)
  {field} personal_email : varchar(120)
  {field} emergency_contact_name : varchar(120)
  {field} emergency_contact_phone : varchar(30)
  {field} emergency_contact_relationship : varchar(40)
  {field} hire_date : date *
  {field} termination_date : date
  {field} termination_reason : employee_termination_reason_enum
  {field} employment_type : employment_type_enum *
  {field} status : employee_status_enum *
  {field} bank_cbu : varchar(22)
  {field} notes : text
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
  {field} deletedAt : timestamptz
  {field} photo_key : varchar(512)
}
entity "employee_attendance" as e_employee_attendance {
  {field} **attendance_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //employee_id// : uuid * <<FK>>
  {field} work_date : date *
  {field} check_in_at : timestamptz *
  {field} check_out_at : timestamptz
  {field} source : employee_attendance_source_enum *
  {field} //recorded_by_user_id// : uuid <<FK>>
  {field} notes : text
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
}
entity "employee_leave" as e_employee_leave {
  {field} **leave_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //employee_id// : uuid * <<FK>>
  {field} type : employee_leave_type_enum *
  {field} start_date : date *
  {field} end_date : date *
  {field} days : integer *
  {field} status : employee_leave_status_enum *
  {field} reason : text
  {field} rejection_reason : text
  {field} //requested_by_user_id// : uuid <<FK>>
  {field} //decided_by_user_id// : uuid <<FK>>
  {field} decided_at : timestamptz
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
}
entity "user" as e_user #F1F1F1 {
}

e_user ||--o{ e_attachment : uploaded_by_user_id
e_job_position ||--o{ e_employee : position_id
e_user |o--o{ e_employee : user_id
e_employee ||--o{ e_employee_attendance : employee_id
e_user |o--o{ e_employee_attendance : recorded_by_user_id
e_user |o--o{ e_employee_leave : decided_by_user_id
e_employee ||--o{ e_employee_leave : employee_id
e_user |o--o{ e_employee_leave : requested_by_user_id

legend bottom
|<#F1F1F1> **tabla de otro contexto** | solo se muestra su nombre; sus columnas están en su propio contexto |
|<#FFFFFF> **distributor_id** | la tabla pertenece a una distribuidora (FK a distributor); la línea no se dibuja |
endlegend
note as N
  Los nombres reflejan la base real: conviven camelCase (paymentMethod, createdAt, isActive) y snake_case
  (scheduled_date, delivery_mode) porque las columnas más antiguas se crearon así y las posteriores siguieron
  otra convención; la tabla claims está en plural y el resto en singular.
end note
@enduml