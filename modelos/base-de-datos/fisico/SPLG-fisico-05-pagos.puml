@startuml
title Modelo físico — Pagos
!include ../../../diagramas/estilo-vp.iuml
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}

hide circle
skinparam linetype polyline

entity "payment" as e_payment {
  {field} **payment_id** : uuid * <<PK>>
  {field} //order_id// : uuid * <<FK>>
  {field} //distributor_id// : uuid <<FK>>
  {field} gateway : payment_gateway_enum *
  {field} integration : payment_integration_enum *
  {field} method : varchar(50)
  {field} gateway_payment_id : varchar(100)
  {field} external_reference : varchar
  {field} amount : numeric(10,2) *
  {field} currency : varchar(10) *
  {field} status : payment_status_enum *
  {field} payment_url : text
  {field} is_deposit : boolean *
  {field} metadata : jsonb
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
}
entity "payment_refund" as e_payment_refund {
  {field} **refund_id** : uuid * <<PK>>
  {field} //payment_id// : uuid * <<FK>>
  {field} //order_id// : uuid * <<FK>>
  {field} //distributor_id// : uuid <<FK>>
  {field} kind : payment_refund_kind_enum *
  {field} amount : numeric(10,2) *
  {field} status : payment_refund_status_enum *
  {field} gateway_refund_id : varchar(100)
  {field} error_message : text
  {field} attempts : integer *
  {field} refunded_at : timestamptz
  {field} requested_by_user_id : uuid
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
  {field} refunded_baseline : numeric(10,2)
}
entity "order" as e_order #F1F1F1 {
}

e_order ||--o{ e_payment : order_id
e_order ||--o{ e_payment_refund : order_id
e_payment ||--o{ e_payment_refund : payment_id

legend bottom
|<#F1F1F1> **tabla de otro contexto** | solo se muestra su nombre; sus columnas están en su propio contexto |
|<#FFFFFF> **distributor_id** | la tabla pertenece a una distribuidora (FK a distributor); la línea no se dibuja |
endlegend
note as N
  Los nombres reflejan la base real: conviven camelCase (paymentMethod, createdAt, isActive) y snake_case
  (scheduled_date, delivery_mode) porque las columnas más antiguas se crearon así y las posteriores siguieron
  otra convención; la tabla claims está en plural y el resto en singular.
end note
@enduml