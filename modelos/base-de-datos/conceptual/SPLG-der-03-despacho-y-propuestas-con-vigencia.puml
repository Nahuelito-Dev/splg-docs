@startuml
title Modelo entidad-relación conceptual — Despacho y propuestas con vigencia
!include ../../../diagramas/estilo-vp.iuml
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}

hide circle

skinparam nodesep 25
skinparam ranksep 45

entity OfertaDespacho {
  * identificador
  --
  {field} estado
  {field} vence
}
entity OfertaLote {
  * identificador
  --
  {field} estado
  {field} vence
}
entity LoteRecorrido {
  * identificador
  --
  {field} estado
  {field} /peso total
}
entity ParadaLote {
  * identificador
  --
  {field} orden
}
entity Pedido #F1F1F1 {
}
entity Chofer #F1F1F1 {
}

Chofer |o--o{ LoteRecorrido : acepta >
OfertaDespacho }o--|| Chofer : se dirige a >
Pedido ||--o{ OfertaDespacho : genera >
LoteRecorrido ||--o{ OfertaLote : genera >
OfertaLote }o--|| Chofer : se dirige a >
ParadaLote }o--|| Pedido : atiende >
LoteRecorrido ||--|{ ParadaLote : se compone de >

legend bottom right
  * identificador: atributo que identifica a cada instancia.  /atributo: atributo derivado.
  Las entidades en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml