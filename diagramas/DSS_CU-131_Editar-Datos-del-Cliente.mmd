sequenceDiagram
    autonumber
    actor ADM as Administrador
    participant SIS as Sistema

    ADM->>SIS: editarDatosDelCliente(clienteId, cambios)
    activate SIS
    alt el cliente existe
        SIS-->>ADM: ficha actualizada
    else el cliente no existe
        SIS-->>ADM: recurso no encontrado
    end
    deactivate SIS
