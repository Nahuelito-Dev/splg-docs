        + aceptar()
        + assertVigente()
    }

    class UbicacionGPS {
        - latitud: Decimal
        - longitud: Decimal
        + «create» UbicacionGPS(latitud: Decimal, longitud: Decimal)
        + abrirSeguimiento(pedido: Pedido)
        + actualizar(latitud: Decimal, longitud: Decimal)
        + cerrarSeguimiento()
        + eliminar()
    }

    class RegistroUsoVehiculo {
        - dia: Fecha
        - kilometros: Entero
        - pedidos: Entero
    }

    class Reclamo {
        - motivo: Cadena
        - descripcion: Cadena
        - estado: EstadoDelReclamo
        - resolucion: Cadena
        - fotografia: Cadena
        + «create» Reclamo(pedido: Pedido, motivo: Cadena, evidencia: Archivo)
        + adjuntarFoto(clave: Cadena): Cadena
        + esDelCliente(cliente: Cliente): Booleano
        + getFoto(): Cadena
        + getResumen()
        + reabrir(motivo: Cadena)
        + resolver(resolucion: Cadena, estadoDestino: EstadoDelReclamo)
        + tomar()
        + validarTransicion(estadoDestino: EstadoDelReclamo)
    }

    class Incidencia {
        - tipo: TipoDeIncidencia
        - momento: MomentoDeIncidencia
        - descripcion: Cadena
        - estado: EstadoDeIncidencia
        - resolucion: Cadena
        - fotografia: Cadena
        + «create» Incidencia(usuario: Usuario, tipo: Cadena, descripcion: Cadena, foto: Archivo)
        + getResumen()
        + resolver(notaDeResolucion: Cadena)
    }

    class Calificacion {
        - puntaje: Entero
        - comentario: Cadena
        + «create» Calificacion(pedido: Pedido, calificado: Usuario, estrellas: Entero, comentario: Cadena)
        + getEstrellas()
    }


