classDiagram
    direction TB

    class Order {
        +orderId: UUID
        +status: OrderStatus
        +paymentMethod: PaymentMethod
        +paymentType: PaymentType
        +paymentStatus: PaymentStatus
        +totalAmount: Decimal
        +depositAmount: Decimal
        +depositPaid: boolean
        +scheduledDate: Date
        +deliveryPoint: Point
        +deliveryCode: string
        +gatewayPaymentId: string
        +cancellationReason: string
        +acceptedAt: Date
        +onTheWayAt: Date
        +deliveredAt: Date
        +createdAt: Date
    }

    class OrderItem {
        +orderItemId: UUID
        +quantity: int
        +unitPrice: Decimal
        +subtotal: Decimal
    }

    class GasCylinder {
        +gasCylinderId: UUID
        +type: string
        +weight: Decimal
        +price: Decimal
        +stock: int
        +isActive: boolean
        +promotions: Promotion[]
    }

    class Promotion {
        +quantity: int
        +discountPercentage: Decimal
    }

    class Delivery {
        +deliveryId: UUID
        +validated: boolean
        +isActive: boolean
        +calification: double
        +balance: double
        +location: Point
        +actualLocation: string
        +notificationToken: string
    }

    class Claim {
        +claimId: UUID
        +reason: string
        +description: string
        +status: ClaimStatus
        +photoUrl: string
        +resolutionNote: string
        +createdAt: Date
    }

    class Customer {
        +customerId: UUID
        +notificationToken: string
        +location: Point
    }

    class User {
        +userId: UUID
        +firebaseUid: string
        +fullName: string
        +email: string
        +phoneNumber: string
        +phoneVerified: boolean
        +emailVerified: boolean
        +blocked: boolean
    }

    class Distributor {
        +distributorId: UUID
    }
    class TimeSlot {
        +timeSlotId: UUID
    }
    class UserAddress {
        +addressId: UUID
    }
    class Role {
        +roleId: UUID
    }

    class OrderStatus {
        <<enumeration>>
        PENDING
        ACCEPTED
        ON_THE_WAY
        DELIVERED
        CANCELLED
        RESERVED
    }
    class PaymentMethod {
        <<enumeration>>
        CASH
        MERCADOPAGO
        TRANSFER
    }
    class ClaimStatus {
        <<enumeration>>
        PENDING
        IN_PROCESS
        RESOLVED
        REJECTED
    }

    Order "0..*" --> "1" Distributor : pertenece a
    Order "0..*" --> "1" User : lo pide
    Order "0..*" --> "0..1" Delivery : lo lleva
    Order "0..*" --> "0..1" TimeSlot : se programa en
    Order "0..*" --> "1" UserAddress : se entrega en
    Order "1" *-- "1..*" OrderItem : compone

    OrderItem "0..*" --> "1" GasCylinder : refiere a
    GasCylinder "0..*" --> "1" Distributor : pertenece a
    GasCylinder "1" *-- "0..*" Promotion : define

    Delivery "0..*" --> "1" Distributor : pertenece a
    Delivery "1" --> "1" User : es un

    Claim "0..*" --> "1" Distributor : pertenece a
    Claim "0..*" --> "1" Order : reclama sobre
    Claim "0..*" --> "1" User : lo presenta

    Customer "1" --> "1" User : es un
    User "0..*" --> "0..1" Role : tiene
    User "1" --> "0..*" UserAddress : registra

    Order ..> OrderStatus : usa
    Order ..> PaymentMethod : usa
    Claim ..> ClaimStatus : usa

    %% Lo que sigue está especificado en la documentación pero todavía no
    %% implementado. Va marcado para no confundir el diseño con lo construido.
    class Cart {
        <<propuesto>>
        +cartId: UUID
        +updatedAt: Date
    }
    class CartItem {
        <<propuesto>>
        +cartItemId: UUID
        +quantity: int
        +unitPrice: Decimal
    }
    class CylinderInspection {
        <<propuesto>>
        +inspectionId: UUID
        +inspectedAt: Date
        +result: InspectionResult
        +nextDueAt: Date
        +notes: string
    }
    class MaintenancePlan {
        <<propuesto>>
        +planId: UUID
        +name: string
        +subject: MaintenanceSubject
        +trigger: MaintenanceTrigger
        +intervalKm: int
        +intervalMonths: int
        +leadTimeDays: int
        +criticality: MaintenanceCriticality
    }
    class MaintenanceTask {
        <<propuesto>>
        +taskId: UUID
        +status: MaintenanceTaskStatus
        +dueAt: Date
        +predictedDueAt: Date
        +scheduledAt: Date
        +performedAt: Date
        +odometerKm: int
        +cost: Decimal
        +provider: string
        +referenceNumber: string
        +alertedAt: Date
    }
    class OrderAddressChange {
        <<propuesto>>
        +changeId: UUID
        +changedAt: Date
        +reason: string
    }
    class Cylinder {
        +cylinderId: UUID
        +serialNumber: string
    }
    class Car {
        +carId: UUID
        +patente: string
    }

    Cart "1" --> "1" User : pertenece a
    Cart "0..*" --> "1" Distributor : pertenece a
    Cart "1" *-- "0..*" CartItem : compone
    CartItem "0..*" --> "1" GasCylinder : refiere a
    CylinderInspection "0..*" --> "1" Cylinder : revisa
    CylinderInspection "0..*" --> "1" Distributor : pertenece a
    MaintenanceTask "0..*" --> "1" MaintenancePlan : sale de
    MaintenanceTask "0..*" --> "0..1" Car : habilita o mantiene
    MaintenanceTask "0..*" --> "0..1" Delivery : habilita al chofer
    MaintenancePlan "0..*" --> "1" Distributor : pertenece a
    Car "0..*" --> "1" User : es conducido por
    OrderAddressChange "0..*" --> "1" Order : cambia el destino de
    OrderAddressChange "0..*" --> "2" UserAddress : de una dirección a otra
    OrderAddressChange "0..*" --> "1" User : lo pide
