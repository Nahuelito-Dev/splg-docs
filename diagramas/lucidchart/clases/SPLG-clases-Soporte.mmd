classDiagram
    direction LR

    %% Reportes, salud y almacenamiento. Lo genera material-de-trabajo/generar-clases-diseno.py desde los DSD:
    %% no se edita a mano.

    class ReportsService {
        <<fachada>>
        + agruparPorChofer(pedidos: Pedido[*])
        + agruparPorMetodoDePago(pedidos: Pedido[*])
        + agruparPorPeriodo(pedidos: Pedido[*], granularidad: Cadena)
        + agruparPorProducto(items: ItemPedido[*])
        + consultarEvolucionDeVentas(fechaDesde: Fecha, fechaHasta: Fecha, granularidad: Cadena): Registro
        + consultarVentasPorChofer(fechaDesde: Fecha, fechaHasta: Fecha): Registro
        + consultarVentasPorMetodoDePago(fechaDesde: Fecha, fechaHasta: Fecha): Registro
        + consultarVentasPorProducto(fechaDesde: Fecha, fechaHasta: Fecha): Registro
    }

    class HealthCheckService {
        <<fachada>>
        + verificarDisponibilidad()
        + verificarSalud()
        + verificarVida()
    }

    class RedisHealthIndicator {
        <<fabricación pura>>
        + isHealthy(redis: Registro)
    }

    class RedisService {
        <<fabricación pura>>
        + del(marcasDeUltimaEjecucion: Registro)
        + ping(): Booleano
    }

    class StoragePort {
        <<interface>>
        + getDownloadUrl(adjunto: AdjuntoTarea): Cadena
        + getDownloadUrl(clave: Cadena): Cadena
        + getStream(adjunto: AdjuntoTarea): Archivo
        + getStream(clave: Cadena): Archivo
        + put(clave: Cadena, archivo: Archivo)
        + put(clave: Cadena, imagen: Archivo)
        + put(clave: Cadena, contenido: Archivo, tipo: Cadena)
        + remove(adjunto: AdjuntoTarea)
        + remove(claveAnterior: Cadena)
    }

    class List_Pedido["List<Pedido>"] {
        <<colección>>
    }
    class Pedido
    class ItemPedido

    HealthCheckService --> "1" RedisHealthIndicator : redisHealthIndicator
    RedisHealthIndicator --> "1" RedisService : redisService
    ReportsService --> "1" List_Pedido : list<Pedido>
    ReportsService ..> ItemPedido
    ReportsService ..> Pedido
