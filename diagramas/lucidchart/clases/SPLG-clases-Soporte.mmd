        + consultarVentasPorMetodoDePago(fechaDesde: Fecha, fechaHasta: Fecha): Registro
        + consultarVentasPorProducto(fechaDesde: Fecha, fechaHasta: Fecha): Registro
    }

    class FleetCostReportService {
        <<fachada>>
        + consultarCostoDeUnVehiculo(vehiculoId: Identificador, fechaDesde: Fecha, fechaHasta: Fecha): Registro
        + consultarTableroDeCostosDeLaFlota(fechaDesde: Fecha, fechaHasta: Fecha): Registro
        + ordenarPorCostoPorKilometro(costos: Registro)
    }

    class HealthCheckService {
        <<fachada>>
        + verificarDisponibilidad()
        + verificarSalud()
        + verificarVida()
    }

    class RedisHealthIndicator {
        <<fabricación pura>>
        + isHealthy(redis: Registro)
    }

    class RedisService {
        <<fabricación pura>>
        + del(marcasDeUltimaEjecucion: Registro)
        + ping(): Booleano
    }

    class StoragePort {
        <<interface>>
        + getDownloadUrl(adjunto: AdjuntoTarea): Cadena
        + getDownloadUrl(clave: Cadena): Cadena
        + getStream(adjunto: AdjuntoTarea): Archivo
        + getStream(clave: Cadena): Archivo
        + put(clave: Cadena, imagen: Archivo)
        + put(clave: Cadena, contenido: Archivo, tipo: Cadena)
        + put(clave: Cadena, archivo: Archivo, tipo: Cadena)
        + remove(adjunto: AdjuntoTarea)
        + remove(claveAnterior: Cadena)
    }

