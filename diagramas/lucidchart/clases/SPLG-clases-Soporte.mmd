    class ReportsService {
        <<fachada>>
        + agruparPorChofer(pedidos: Pedido[*])
        + agruparPorMetodoDePago(pedidos: Pedido[*])
        + agruparPorPeriodo(pedidos: Pedido[*], granularidad: Cadena)
        + agruparPorProducto(items: Registro)
        + consultarEvolucionDeVentas(fechaDesde: Fecha, fechaHasta: Fecha, granularidad: Cadena): Registro
