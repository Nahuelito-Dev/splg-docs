    %% Productos y franjas horarias. Lo genera material-de-trabajo/generar-clases-diseno.py desde los DSD:
    %% no se edita a mano.

    class GasCylinderService {
        <<fachada>>
        + actualizarProducto(productoId: Identificador, datos: Registro): Producto
        + consultarCatalogo(pagina: Entero, limite: Entero, distribuidora: Cadena, out total: Entero): Producto[*]
        + consultarProducto(productoId: Identificador): Producto
        + consultarProductosDisponibles(distribuidora: Cadena, out mediosDePago: MetodoDePago[*]): Producto[*]
        + consultarProductosInactivos(): Producto[*]
        + crearProducto(tipo: Cadena, peso: Decimal, precio: Moneda, stockInicial: Entero, descripcion: Cadena, promociones: Lista): Producto
        + desactivarProducto(productoId: Identificador): Cadena
        + reactivarProducto(productoId: Identificador): Producto
    }

    class Map_String_Producto["Map<String, Producto>"] {
        <<colección>>
        + get(clave: Cadena): Producto
    }

    class List_Producto["List<Producto>"] {
        <<colección>>
        + buscarInactivos(): Producto[*]
        + getTodos(): Producto[*]
    }

    class TimeSlotService {
        <<fachada>>
        + consultarDisponibilidadDeFranjas(fecha: Fecha, distribuidora: Cadena): Registro
        + consultarFranjasHorarias(): FranjaHoraria[*]
        + crearFranjaHoraria(nombre: Cadena, horaInicio: Hora, horaFin: Hora, capacidad: Entero): FranjaHoraria
        + eliminarFranjaHoraria(franjaId: Identificador): FranjaHoraria
        + listarFranjas(distribuidora: Cadena): FranjaHoraria[*]
        + modificarFranjaHoraria(franjaId: Identificador, nombre: Cadena, horaInicio: Hora, horaFin: Hora, capacidad: Entero): FranjaHoraria
    }

    class Map_String_FranjaHoraria["Map<String, FranjaHoraria>"] {
        <<colección>>
        + get(clave: Cadena): FranjaHoraria
    }

