        + registrarCargaDeCombustible(vehiculoId: Identificador, datos: Registro): CargaCombustible
    }

    class Map_String_CargaCombustible["Map<String, CargaCombustible>"] {
        <<colección>>
        + get(clave: Cadena): CargaCombustible
    }

    class List_CargaCombustible["List<CargaCombustible>"] {
        <<colección>>
        + getVigentes(filtros: Registro): CargaCombustible[*]
    }

    class FuelConsumptionCalculator {
        <<fabricación pura>>
        + calcularConsumo(cargas: CargaCombustible[*]): Registro
        + calcularDesvio(cargaCombustible: CargaCombustible, vehiculo: Vehiculo): Decimal
    }

    class TrafficFineService {
        <<fachada>>
        + anularMultaDeTransito(multaId: Identificador, motivo: Cadena): MultaTransito
        + consultarMultasDeTransito(filtros: Registro): MultaTransito[*]
