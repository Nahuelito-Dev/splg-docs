classDiagram
    direction LR

    %% Choferes y vehículos. Lo genera material-de-trabajo/generar-clases-diseno.py desde los DSD:
    %% no se edita a mano.

    class DeliveryService {
        <<fachada>>
        + actualizarPerfilDelChofer(choferId: Identificador, datos: Registro): Chofer
        + ajustarSaldoDelChofer(choferId: Identificador, monto: Moneda): Chofer
        + buscarChoferPorUsuario(usuario: Usuario): Chofer
        + cambiarDisponibilidad(usuario: Usuario, disponible: Booleano): Registro
        + cambiarEstadoDelChofer(choferId: Identificador, activo: Booleano): Chofer
        + consultarDetalleDelChofer(choferId: Identificador, out usuario: Usuario, out rol: Rol): Chofer
        + consultarPerfilDelChofer(usuario: Usuario, out saldo: Moneda): Chofer
        + eliminarChofer(choferId: Identificador)
        + findById(choferId: Identificador): Chofer
        + invalidarChofer(choferId: Identificador): Chofer
        + listarChoferes(pagina: Entero, limite: Entero): Chofer[*]
        + listarChoferesActivos(pagina: Entero, limite: Entero): Chofer[*]
        + validarChofer(choferId: Identificador): Chofer
    }

    class Map_String_Chofer["Map<String, Chofer>"] {
        <<colección>>
        + get(clave: Cadena): Chofer
    }

    class List_Chofer["List<Chofer>"] {
        <<colección>>
        + buscarEnMotoDisponibles(direccion: DireccionEntrega): Chofer[*]
        + contarEnLinea(distribuidoraId: Identificador): Entero
        + contarHabilitados(distribuidoraId: Identificador): Entero
        + getConEfectivoOCobrosSinRendir(hoy: Fecha): Chofer[*]
    }

    class CarService {
        <<fachada>>
        + buscarVehiculoPorPatente(patente: Cadena): Vehiculo
        + consultarDetalleDelVehiculo(vehiculoId: Identificador, out chofer: Chofer): Vehiculo
        + consultarVehiculosDelChofer(usuario: Usuario): Vehiculo[*]
        + editarVehiculo(vehiculoId: Identificador, datos: Registro): Vehiculo
        + eliminarVehiculo(vehiculoId: Identificador)
        + listarVehiculos(): Vehiculo[*]
        + reactivarVehiculo(vehiculoId: Identificador): Vehiculo
        + registrarVehiculo(usuario: Usuario, tipo: Cadena, capacidad: Decimal, patente: Cadena, marca: Cadena, modelo: Cadena, anio: Entero, color: Cadena): Vehiculo
    }

    class Map_String_Vehiculo["Map<String, Vehiculo>"] {
        <<colección>>
        + get(clave: Cadena): Vehiculo
    }

    class List_Vehiculo["List<Vehiculo>"] {
        <<colección>>
        + getActivos(): Vehiculo[*]
        + getVehiculosDe(distribuidora: Distribuidora): Vehiculo[*]
    }

    class VehicleAssignmentService {
        <<fachada>>
        + consultarHistorialDeChoferesDelVehiculo(vehiculoId: Identificador, pagina: Entero): AsignacionVehiculo[*]
        + consultarHistorialDeVehiculosDelChofer(choferId: Identificador, pagina: Entero): AsignacionVehiculo[*]
        + consultarMiVehiculoEnUso(out inhabilitado: Booleano): Vehiculo
        + consultarVehiculoEnUso(choferId: Identificador, out inhabilitado: Booleano): Vehiculo
        + getEmpleadoAl(vehiculo: Vehiculo, fechaYHora: FechaHora): Empleado
        + liberarVehiculoEnUso(choferId: Identificador)
        + ponerVehiculoEnUso(choferId: Identificador, vehiculoId: Identificador, nota: Cadena): AsignacionVehiculo
    }

    class List_AsignacionVehiculo["List<AsignacionVehiculo>"] {
        <<colección>>
        + cerrarAbiertas(chofer: Chofer, vehiculo: Vehiculo, administrador: Administrador)
        + getAbierta(): AsignacionVehiculo
    }

    class Chofer
    class Vehiculo
    class AsignacionVehiculo
    class Map_String_Usuario["Map<String, Usuario>"] {
        <<colección>>
    }
    class FleetTaskService {
        <<fachada>>
    }
    class Distribuidora
    class UbicacionGPS
    class Usuario

    Usuario <|-- Chofer
    Map_String_Chofer "1" o-- "0..*" Chofer : elementos
    List_Chofer "1" o-- "0..*" Chofer : elementos
    Map_String_Vehiculo "1" o-- "0..*" Vehiculo : elementos
    List_Vehiculo "1" o-- "0..*" Vehiculo : elementos
    List_AsignacionVehiculo "1" o-- "0..*" AsignacionVehiculo : elementos
    CarService --> "1" List_Vehiculo : list<Vehiculo>
    CarService --> "1" Map_String_Chofer : map<String, Chofer>
    CarService --> "1" Map_String_Vehiculo : map<String, Vehiculo>
    DeliveryService --> "1" Map_String_Chofer : map<String, Chofer>
    DeliveryService --> "1" Map_String_Usuario : map<String, Usuario>
    FleetTaskService --> "1" Map_String_Chofer : map<String, Chofer>
    FleetTaskService --> "1" Map_String_Vehiculo : map<String, Vehiculo>
    VehicleAssignmentService --> "1" Map_String_Chofer : map<String, Chofer>
    VehicleAssignmentService --> "1" Map_String_Vehiculo : map<String, Vehiculo>
    CarService ..> Chofer
    CarService ..> FleetTaskService
    CarService ..> Vehiculo
    Chofer ..> List_AsignacionVehiculo
    DeliveryService ..> Chofer
    DeliveryService ..> Distribuidora
    DeliveryService ..> UbicacionGPS
    DeliveryService ..> Usuario
    VehicleAssignmentService ..> AsignacionVehiculo
    VehicleAssignmentService ..> Chofer
    VehicleAssignmentService ..> FleetTaskService
    VehicleAssignmentService ..> Vehiculo
    Vehiculo ..> List_AsignacionVehiculo
