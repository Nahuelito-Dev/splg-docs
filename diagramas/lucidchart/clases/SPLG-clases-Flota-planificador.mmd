classDiagram
    direction LR

    %% Flota: planificador de mantenimiento. Lo genera material-de-trabajo/generar-clases-diseno.py desde los DSD:
    %% no se edita a mano.

    class FleetMaintenancePlannerService {
        <<fachada>>
        + aceptarVentanaDeMantenimiento(propuestaId: Identificador): PropuestaVentanaTaller
        + confirmarVentanaDeTaller(tareaId: Identificador, ventanaElegida: Registro, gastoEstimado: Moneda): TareaMantenimiento
        + planificarMantenimientoDeFlota()
    }

    class DemandForecastService {
        <<fabricación pura>>
        + demandaProyectada(ventanas: PropuestaVentanaTaller[*])
    }

    class FleetCoverageService {
        <<fabricación pura>>
        + ventanasFactibles(vehiculo: Vehiculo, ventanas: PropuestaVentanaTaller[*])
    }

    class FleetAvailabilityPort {
        <<interface>>
        + blockVehicleWindow(tarea: TareaMantenimiento, ventanaElegida: PropuestaVentanaTaller)
    }

    class Map_String_PropuestaVentanaTaller["Map<String, PropuestaVentanaTaller>"] {
        <<colección>>
        + get(clave: Cadena): PropuestaVentanaTaller
    }

    class PropuestaVentanaTaller
    class Map_String_TareaMantenimiento["Map<String, TareaMantenimiento>"] {
        <<colección>>
    }
    class NotificationsService {
        <<fachada>>
    }
    class TareaMantenimiento
    class Vehiculo

    Map_String_PropuestaVentanaTaller "1" o-- "0..*" PropuestaVentanaTaller : elementos
    FleetMaintenancePlannerService --> "1" DemandForecastService : demandForecastService
    FleetMaintenancePlannerService --> "1" FleetAvailabilityPort : fleetAvailabilityPort
    FleetMaintenancePlannerService --> "1" FleetCoverageService : fleetCoverageService
    FleetMaintenancePlannerService --> "1" Map_String_PropuestaVentanaTaller : map<String, PropuestaVentanaTaller>
    FleetMaintenancePlannerService --> "1" Map_String_TareaMantenimiento : map<String, TareaMantenimiento>
    FleetMaintenancePlannerService --> "1" NotificationsService : notificationsService
    FleetMaintenancePlannerService ..> PropuestaVentanaTaller
    FleetMaintenancePlannerService ..> TareaMantenimiento
    FleetMaintenancePlannerService ..> Vehiculo
