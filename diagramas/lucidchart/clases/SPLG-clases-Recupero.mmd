classDiagram
    direction LR

    %% Recupero de envases. Lo genera material-de-trabajo/generar-clases-diseno.py desde los DSD:
    %% no se edita a mano.

    class CylinderRecoveryService {
        <<fachada>>
        + aceptarRetiroEnLaEntrega(ofertaId: Identificador): Envase
        + gestionarEnvasesNoDevueltos()
        + resolverCasoDeRecupero(casoId: Identificador, decision: Cadena): CasoRecupero
    }

    class DepositLedgerService {
        <<fabricación pura>>
        + registerDecision(caso: CasoRecupero, decision: Cadena)
    }

    class Map_String_AvisoRecupero["Map<String, AvisoRecupero>"] {
        <<colección>>
        + get(clave: Cadena): AvisoRecupero
    }

    class Map_String_CasoRecupero["Map<String, CasoRecupero>"] {
        <<colección>>
        + get(clave: Cadena): CasoRecupero
    }

    class AvisoRecupero
    class CasoRecupero
    class CylinderLifecyclePort {
        <<interface>>
    }
    class NotificationsService {
        <<fachada>>
    }
    class Envase
    class Pedido

    Map_String_AvisoRecupero "1" o-- "0..*" AvisoRecupero : elementos
    Map_String_CasoRecupero "1" o-- "0..*" CasoRecupero : elementos
    CylinderRecoveryService --> "1" CylinderLifecyclePort : cylinderLifecyclePort
    CylinderRecoveryService --> "1" DepositLedgerService : depositLedgerService
    CylinderRecoveryService --> "1" Map_String_AvisoRecupero : map<String, AvisoRecupero>
    CylinderRecoveryService --> "1" Map_String_CasoRecupero : map<String, CasoRecupero>
    CylinderRecoveryService --> "1" NotificationsService : notificationsService
    CylinderRecoveryService ..> AvisoRecupero
    CylinderRecoveryService ..> CasoRecupero
    CylinderRecoveryService ..> Envase
    CylinderRecoveryService ..> Pedido
