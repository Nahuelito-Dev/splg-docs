    %% Stock. Lo genera material-de-trabajo/generar-clases-diseno.py desde los DSD:
    %% no se edita a mano.

    class WarehouseService {
        <<fachada>>
        + actualizarDeposito(depositoId: Identificador, datos: Registro): Deposito
        + consultarDepositos(): Deposito[*]
        + darDeBajaDeposito(depositoId: Identificador)
        + registrarDeposito(nombre: Cadena, codigo: Cadena, tipo: Cadena, direccion: Cadena): Deposito
    }

    class Map_String_Deposito["Map<String, Deposito>"] {
        <<colección>>
        + get(clave: Cadena): Deposito
    }

    class StockService {
        <<fachada>>
        + configurarStockMinimo(depositoId: Identificador, minimos: Lista): UmbralDeStock[*]
        + consultarMovimientosDeStock(productoId: Identificador, ubicacionId: Identificador, motivo: Cadena, desde: FechaHora, hasta: FechaHora, pagina: Entero, out total: Entero): MovimientoDeStock[*]
        + consultarResumenDeStock(): Registro
        + consultarStockPorUbicacion(ubicacionId: Identificador, productoId: Identificador): SaldoDeStock[*]
        + transferirStock(origenId: Identificador, destinoId: Identificador, productoId: Identificador, condicion: Cadena, cantidad: Entero): Booleano
    }

    class List_UbicacionDeStock["List<UbicacionDeStock>"] {
        <<colección>>
        + getCantidadPorCondicion(producto: Producto)
        + getLlenas(producto: Producto)
    }

    class List_UmbralDeStock["List<UmbralDeStock>"] {
        <<colección>>
        + getConMinimo(): UmbralDeStock[*]
        + getMinimoDeLlenas(producto: Producto)
    }

    class Map_String_UbicacionDeStock["Map<String, UbicacionDeStock>"] {
        <<colección>>
        + get(clave: Cadena): UbicacionDeStock
    }

    class List_MovimientoDeStock["List<MovimientoDeStock>"] {
        <<colección>>
        + buscar(productoId: Identificador, ubicacionId: Identificador, motivo: Cadena, desde: FechaHora, hasta: FechaHora, pagina: Entero, out total: Entero): MovimientoDeStock[*]
    }

    class StockLowCron {
        <<fachada>>
        + avisarStockBajo()
    }

    class StockLedgerService {
        <<fachada>>
        + aplicarMovimientoDeStock(ubicacionOrigen: UbicacionDeStock, ubicacionDestino: UbicacionDeStock, producto: Producto, condicionOrigen: CondicionDeStock, condicionDestino: CondicionDeStock, cantidad: Entero, motivoDeMovimiento: MotivoDeMovimiento): Booleano
        + existeMovimiento(pedido: Pedido): Booleano
    }

    class StockAdjustmentService {
        <<fachada>>
        + consultarAjustesDeStock(desde: FechaHora, hasta: FechaHora, motivo: Cadena): Registro
        + registrarAjusteDeStock(ubicacionId: Identificador, motivo: Cadena, nota: Cadena, items: Lista): AjusteDeStock
    }

    class List_AjusteDeStock["List<AjusteDeStock>"] {
        <<colección>>
        + buscar(desde: FechaHora, hasta: FechaHora, motivo: Cadena): Registro
    }

    class StockDeliveryListener {
        <<fachada>>
        + descontarStockDeLaEntrega(pedidoId: Identificador): Booleano
    }

    class StockReconciliationCron {
        <<fachada>>
        + conciliarStock()
    }

    class StockReconciliationService {
        <<fachada>>
        + consultarConciliacionDeStock(): Registro
    }

