classDiagram
    direction LR

    %% Stock. Lo genera material-de-trabajo/generar-clases-diseno.py desde los DSD:
    %% no se edita a mano.

    class CatalogStockAdjustmentUseCase {
        <<controlador>>
        + actualizarStock(productoId: Identificador, variacion: Entero): Producto
    }

    class StockAdjustmentUseCase {
        <<controlador>>
        + registrarAjusteDeStock(ubicacionId: Identificador, motivo: Cadena, nota: Cadena, items: Lista): AjusteDeStock
        + registrarAjusteDeStock(ubicacionDeStock: UbicacionDeStock, motivoRecuento: MotivoDeAjuste, nota: Cadena, producto: Producto, variacion: Entero): AjusteDeStock
        + validarItemsDeAjuste(motivo: Cadena, items: Registro)
    }

    class WarehouseService {
        <<fachada>>
        + actualizarDeposito(depositoId: Identificador, datos: Registro): Deposito
        + consultarDeposito(depositoId: Identificador, out saldos: SaldoDeStock[*]): Deposito
        + consultarDepositos(incluirInactivos: Booleano): Deposito[*]
        + darDeBajaDeposito(depositoId: Identificador)
        + marcarDepositoPredeterminado(depositoId: Identificador): Deposito
        + registrarDeposito(nombre: Cadena, codigo: Cadena, tipo: Cadena, direccion: Cadena): Deposito
    }

    class Map_String_Deposito["Map<String, Deposito>"] {
        <<colección>>
        + get(clave: Cadena): Deposito
    }

    class StockQueryService {
        <<fachada>>
        + consultarAjusteDeStock(ajusteId: Identificador, out renglonesDeAjuste: ItemAjusteDeStock[*]): AjusteDeStock
        + consultarAjustesDeStock(desde: FechaHora, hasta: FechaHora, motivo: Cadena, out cantidadDeAjustes: Entero): Registro
        + consultarMovimientosDeStock(productoId: Identificador, ubicacionId: Identificador, motivo: Cadena, desde: FechaHora, hasta: FechaHora, pagina: Entero, out cantidadDeMovimientos: Entero): MovimientoDeCaja[*]
        + consultarResumenDeStock(): Registro
        + consultarStockPorUbicacion(ubicacionId: Identificador, productoId: Identificador): SaldoDeStock[*]
        + saldos(ubicacionDeStock: UbicacionDeStock): SaldoDeStock[*]
    }

    class Map_String_UbicacionDeStock["Map<String, UbicacionDeStock>"] {
        <<colección>>
        + get(clave: Cadena): UbicacionDeStock
    }

    class StockLocationService {
        <<fachada>>
        + consultarUbicacionesDeStock(): UbicacionDeStock[*]
    }

    class List_MovimientoDeStock["List<MovimientoDeStock>"] {
        <<colección>>
        + filtrar(productoId: Identificador, ubicacionId: Identificador, motivo: Cadena, desde: FechaHora, hasta: FechaHora, pagina: Entero): MovimientoDeCaja[*]
        + getLote(loteId: Identificador): MovimientoDeCaja
    }

    class StockThresholdService {
        <<fachada>>
        + configurarStockMinimo(minimos: Lista): UmbralDeStock[*]
        + consultarStockMinimo(): UmbralDeStock[*]
    }

    class List_UmbralDeStock["List<UmbralDeStock>"] {
        <<colección>>
        + getConMinimo(): UmbralDeStock[*]
        + getMinimoDeLlenas(producto: Producto): Entero
        + getTodos(): UmbralDeStock[*]
    }

    class StockLowCron {
        <<fachada>>
        + avisarStockBajo()
    }

    class StockAdminNotifier {
        <<fabricación pura>>
        + avisar(distribuidora: Distribuidora, stockBajo: Registro)
    }

    class StockTransferUseCase {
        <<controlador>>
        + transferirStock(origenId: Identificador, destinoId: Identificador, items: Lista, nota: Cadena): Identificador
    }

    class StockLedgerService {
        <<fachada>>
        + aplicar(movimientos: MovimientoDeCaja[*]): Identificador
        + aplicar(operacion: Cadena): Identificador
        + aplicar(ubicacionDeStock: UbicacionDeStock, renglonesDeAjuste: ItemAjusteDeStock[*]): Identificador
        + aplicar(ubicacionDeStock: UbicacionDeStock, motivo: Cadena, items: Registro): Identificador
        + aplicar(ubicacionOrigen: UbicacionDeStock, ubicacionDestino: UbicacionDeStock, items: Registro, traslado: MotivoDeMovimiento): Identificador
        + aplicarMovimientoDeStock(ubicacionDeStock: UbicacionDeStock, ubicacionDeStock: UbicacionDeStock, producto: Producto, llenas: CondicionDeStock, llenasCargadas: Entero, motivoDeMovimiento: MotivoDeMovimiento): Booleano
        + contraasentar(loteId: Identificador, nota: Cadena)
        + validarMovimiento(movimiento: MovimientoDeCaja)
    }

    class StockDeliveryService {
        <<fachada>>
        + descartarGarrafa(producto: Producto)
        + elegirOrigen(ubicacionDelCamion: UbicacionDeStock)
        + registrarEntrega(entrega: MotivoDeMovimiento): Booleano
        + registrarEntrega(pedido: Pedido, items: Registro)
    }

    class StockReconciliationCron {
        <<fachada>>
        + borrarAviso(distribuidora: Distribuidora)
        + coincideConElUltimoAviso(firma: Cadena)
        + conciliarStock()
        + guardarAviso(firma: Cadena)
    }

    class StockReconciliationService {
        <<fachada>>
        + conciliar(distribuidora: Distribuidora): MotivoDeAjuste
        + consultarConciliacionDeStock(): MotivoDeAjuste
    }

    class InitialCountUseCase {
        <<controlador>>
        + registrarConteoInicial(depositoId: Identificador, items: Lista, nota: Cadena): AjusteDeStock
    }

    class Map_String_AjusteDeStock["Map<String, AjusteDeStock>"] {
        <<colección>>
        + get(clave: Cadena): AjusteDeStock
    }

    class List_AjusteDeStock["List<AjusteDeStock>"] {
        <<colección>>
        + filtrar(desde: FechaHora, hasta: FechaHora, motivo: Cadena): Registro
    }

    class ReverseBatchUseCase {
        <<controlador>>
        + anularTransferenciaDeStock(loteId: Identificador, nota: Cadena)
    }

    class ReconciliationAdjustmentUseCase {
        <<controlador>>
        + registrarAjusteDeConciliacion(productoId: Identificador, nota: Cadena, diferenciaEsperada: Entero): AjusteDeStock
    }

    class ReapplyDeliveriesUseCase {
        <<controlador>>
        + reaplicarEntregasDeStock(): Registro
    }

    class List_UbicacionDeStock["List<UbicacionDeStock>"] {
        <<colección>>
        + getSaldos(producto: Producto): SaldoDeStock[*]
    }

