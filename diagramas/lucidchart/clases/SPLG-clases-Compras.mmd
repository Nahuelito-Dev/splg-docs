        + consultarPendienteDeRecibir(ordenId: Identificador): EstadoPedido
        + consultarRecepcionDeCompra(recepcionId: Identificador): RecepcionDeCompra
        + consultarRecepcionesDeCompra(proveedorId: Identificador, ordenId: Identificador, estadoDePago: Cadena, estado: Cadena, desde: Fecha, hasta: Fecha): RecepcionDeCompra[*]
    }

    class List_OrdenDeCompra["List<OrdenDeCompra>"] {
        <<colección>>
        + buscar(estado: Cadena, proveedorId: Identificador, desde: FechaHora, hasta: FechaHora): OrdenDeCompra[*]
    }

    class List_RecepcionDeCompra["List<RecepcionDeCompra>"] {
