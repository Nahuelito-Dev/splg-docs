        + modificarOrdenDeCompra(ordenId: Identificador, datos: Registro): OrdenDeCompra
    }

    class Map_String_OrdenDeCompra["Map<String, OrdenDeCompra>"] {
        <<colección>>
        + get(clave: Cadena): OrdenDeCompra
    }

    class ReceivePurchaseUseCase {
        <<controlador>>
        + registrarRecepcionDeCompra(ordenId: Identificador, proveedorId: Identificador, depositoId: Identificador, tipoDeComprobante: Cadena, numeroDeComprobante: Cadena, items: Lista): RecepcionDeCompra
    }

    class VoidPurchaseReceiptUseCase {
        <<controlador>>
        + anularRecepcionDeCompra(recepcionId: Identificador, motivo: Cadena): RecepcionDeCompra
    }

    class Map_String_RecepcionDeCompra["Map<String, RecepcionDeCompra>"] {
        <<colección>>
        + get(clave: Cadena): RecepcionDeCompra
    }

    class PurchaseReceiptService {
        <<fachada>>
        + marcarPagoDeRecepcion(recepcionId: Identificador, estadoDePago: Cadena): RecepcionDeCompra
    }

    class PurchaseQueryService {
        <<fachada>>
        + consultarCostoPromedio(): Registro
