    }

    class Map_String_Proveedor["Map<String, Proveedor>"] {
        <<colección>>
        + get(clave: Cadena): Proveedor
    }

    class PurchaseOrderService {
        <<fachada>>
        + cancelarOrdenDeCompra(ordenId: Identificador, motivo: Cadena): OrdenDeCompra
