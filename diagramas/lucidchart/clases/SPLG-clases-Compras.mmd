        + enviarOrdenDeCompra(ordenId: Identificador): OrdenDeCompra
    }

    class List_OrdenDeCompra["List<OrdenDeCompra>"] {
        <<colección>>
        + buscar(estado: Cadena, proveedorId: Identificador, desde: FechaHora, hasta: FechaHora): OrdenDeCompra[*]
    }

    class Map_String_OrdenDeCompra["Map<String, OrdenDeCompra>"] {
        <<colección>>
        + get(clave: Cadena): OrdenDeCompra
    }

    class PurchaseReceiptService {
        <<fachada>>
        + anularRecepcionDeCompra(recepcionId: Identificador, motivo: Cadena): Booleano
        + consultarRecepcionesDeCompra(proveedorId: Identificador, desde: FechaHora, hasta: FechaHora, estadoDePago: Cadena): RecepcionDeCompra[*]
        + registrarRecepcionDeCompra(ordenId: Identificador, proveedorId: Identificador, depositoId: Identificador, tipoDeComprobante: Cadena, numeroDeComprobante: Cadena, items: Lista): RecepcionDeCompra
    }

    class Map_String_RecepcionDeCompra["Map<String, RecepcionDeCompra>"] {
        <<colección>>
        + get(clave: Cadena): RecepcionDeCompra
    }

    class List_RecepcionDeCompra["List<RecepcionDeCompra>"] {
        <<colección>>
        + buscar(proveedorId: Identificador, desde: FechaHora, hasta: FechaHora, estadoDePago: Cadena): RecepcionDeCompra[*]
    }

    class Map_String_Proveedor["Map<String, Proveedor>"] {
        <<colección>>
        + get(clave: Cadena): Proveedor
    }

