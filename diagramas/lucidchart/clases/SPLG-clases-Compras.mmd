    class SupplierService {
        <<fachada>>
        + actualizarProveedor(proveedorId: Identificador, datos: Registro): Proveedor
        + consultarProveedores(termino: Cadena): Proveedor[*]
        + darDeBajaProveedor(proveedorId: Identificador)
        + registrarProveedor(razonSocial: Cadena, cuit: Cadena, tipo: Cadena, datosDeContacto: Registro, plazoDePago: Entero): Proveedor
    }

    class PurchaseOrderService {
        <<fachada>>
        + cancelarOrdenDeCompra(ordenId: Identificador, motivo: Cadena): OrdenDeCompra
        + consultarOrdenesDeCompra(estado: Cadena, proveedorId: Identificador, desde: FechaHora, hasta: FechaHora): OrdenDeCompra[*]
