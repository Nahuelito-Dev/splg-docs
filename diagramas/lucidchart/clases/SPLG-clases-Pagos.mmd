    class PaymentsService {
        <<fachada>>
        + crearCheckoutDePago(pedidoId: Identificador, metodoDePago: MetodoDePago): Cadena
    }

    class PaymentGatewayPort {
        <<interface>>
        + createCheckout(pedido: Pedido, items: ItemPedido[*], pagador: Cadena): Cadena
        + getPayment(identificadorDelPago: Identificador): Cadena
        + refundPayment(pago: Pago, importe: Moneda): Cadena
        + verifyWebhookSignature(firma: Cadena, identificadorDelPago: Identificador): Booleano
    }

    class RefundPaymentUseCase {
        <<use case>>
        + reintegrarPagoDelPedido(pedidoId: Identificador, importe: Moneda): Booleano
    }

    class ConfirmPaymentUseCase {
        <<use case>>
        + notificarResultadoDePago(tipoDeNotificacion: Cadena, identificadorDelPago: Cadena, firma: Cadena)
    }

    class RefundPaymentUseCase {
        <<use case>>
        + reintegrarPagoDelPedido(pedidoId: Identificador, importe: Moneda): Booleano
    }

    class ReservationService {
        <<fachada>>
        + activarReservasDelDia()
        + confirmarSenia(pedidoId: Identificador): Pedido
        + expirarPedidosSinPagar()
        + expirarReservasSinSenia()
        + listarReservas(): Pedido[*]
    }

