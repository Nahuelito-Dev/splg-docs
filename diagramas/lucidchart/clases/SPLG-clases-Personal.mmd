classDiagram
    direction LR

    %% Personal: puestos, legajos, jornadas y licencias. Lo genera material-de-trabajo/generar-clases-diseno.py desde los DSD:
    %% no se edita a mano.

    class JobPositionService {
        <<fachada>>
        + consultarPuestosDeTrabajo(): PuestoDeTrabajo[*]
        + crearPuestoDeTrabajo(nombre: Cadena, categoria: CategoriaDePuesto): PuestoDeTrabajo
        + eliminarPuestoDeTrabajo(puestoId: Identificador): Cadena
        + modificarPuestoDeTrabajo(puestoId: Identificador, datos: Registro): PuestoDeTrabajo
    }

    class EmployeeService {
        <<fachada>>
        + consultarDocumentacionDelEmpleado(empleadoId: Identificador): TareaMantenimiento[*]
        + consultarEmpleado(empleadoId: Identificador): Empleado
        + consultarEmpleados(filtros: Registro): Empleado[*]
        + consultarSaldoDeVacaciones(empleadoId: Identificador, anio: Entero): Entero
        + eliminarEmpleado(empleadoId: Identificador): Cadena
        + modificarEmpleado(empleadoId: Identificador, datos: Registro): Empleado
        + registrarEmpleado(datos: Registro): Empleado
        + reingresarEmpleado(empleadoId: Identificador, fechaDeIngreso: Fecha): Empleado
    }

    class Map_String_PuestoDeTrabajo["Map<String, PuestoDeTrabajo>"] {
        <<colección>>
        + get(clave: Cadena): PuestoDeTrabajo
    }

    class Map_String_Empleado["Map<String, Empleado>"] {
        <<colección>>
        + get(clave: Cadena): Empleado
    }

    class List_Empleado["List<Empleado>"] {
        <<colección>>
        + filtrar(filtros: Registro): Empleado[*]
        + getActivosPorPuesto(): Empleado[*]
    }

    class TerminateEmployeeUseCase {
        <<controlador>>
        + registrarEgresoDelEmpleado(empleadoId: Identificador, fechaDeEgreso: Fecha, motivo: Cadena): Empleado
    }

    class GrantEmployeeAccountUseCase {
        <<controlador>>
        + otorgarCuentaDeAcceso(empleadoId: Identificador, datosDeAcceso: Registro): Empleado
    }

    class AttendanceService {
        <<fachada>>
        + consultarAsistencias(desde: Fecha, hasta: Fecha): JornadaDeTrabajo[*]
        + corregirAsistencia(asistenciaId: Identificador, datos: Registro, nota: Cadena): JornadaDeTrabajo
        + registrarAsistencia(empleadoId: Identificador, ingreso: FechaHora, egreso: FechaHora): JornadaDeTrabajo
        + registrarFinDeJornada()
        + registrarInicioDeJornada()
    }

    class List_JornadaDeTrabajo["List<JornadaDeTrabajo>"] {
        <<colección>>
        + getAbiertasDeHoy(): JornadaDeTrabajo[*]
        + getEntre(desde: FechaHora, hasta: FechaHora): JornadaDeTrabajo[*]
    }

    class Map_String_JornadaDeTrabajo["Map<String, JornadaDeTrabajo>"] {
        <<colección>>
        + get(clave: Cadena): JornadaDeTrabajo
    }

    class LeaveService {
        <<fachada>>
        + aprobarLicencia(licenciaId: Identificador): LicenciaLaboral
        + cancelarLicencia(licenciaId: Identificador): LicenciaLaboral
        + consultarLicencias(estado: Cadena, desde: Fecha, hasta: Fecha): LicenciaLaboral[*]
        + modificarLicencia(licenciaId: Identificador, datos: Registro): LicenciaLaboral
        + rechazarLicencia(licenciaId: Identificador, motivo: Cadena): LicenciaLaboral
        + registrarLicencia(empleadoId: Identificador, tipo: Cadena, desde: Fecha, hasta: Fecha, motivo: Cadena): LicenciaLaboral
    }

    class Map_String_LicenciaLaboral["Map<String, LicenciaLaboral>"] {
        <<colección>>
        + get(clave: Cadena): LicenciaLaboral
    }

    class List_LicenciaLaboral["List<LicenciaLaboral>"] {
        <<colección>>
        + filtrar(estado: Cadena, desde: FechaHora, hasta: FechaHora): LicenciaLaboral[*]
        + getAprobadasQueCubren(hoy: Fecha): LicenciaLaboral[*]
    }

    class VacationPolicy {
        <<fabricación pura>>
        + diasCorrespondientes(fechaDeIngreso: Fecha, anio: Entero): Entero
    }

    class PersonnelDashboardService {
        <<fachada>>
        + consultarTableroDePersonal(): Registro
    }

    class PuestoDeTrabajo
    class Empleado
    class JornadaDeTrabajo
    class LicenciaLaboral
    class RegistroService {
        <<fachada>>
    }
    class List_TareaMantenimiento["List<TareaMantenimiento>"] {
        <<colección>>
    }
