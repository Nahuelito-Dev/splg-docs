classDiagram
    direction LR

    %% Clientes y direcciones de entrega. Lo genera material-de-trabajo/generar-clases-diseno.py desde los DSD:
    %% no se edita a mano.

    class CustomersService {
        <<fachada>>
        + actualizarUbicacionDelCliente(cliente: Cliente, coordenadas: Coordenada): Cliente
        + buscarClientePorUsuario(usuario: Usuario): Cliente
        + configurarDiasDeAviso(dias: Entero): Cliente
        + consultarDetalleDelCliente(cliente: Cliente): Cliente
        + consultarPerfilCliente(usuario: Usuario): Cliente
        + editarDatosDelCliente(cliente: Cliente, cambios: Registro): Cliente
        + eliminarCliente(cliente: Cliente): Cadena
        + listarClientes(pagina: Entero, limite: Entero, out total: Entero): Cliente[*]
    }

    class Map_String_Cliente["Map<String, Cliente>"] {
        <<colección>>
        + get(clave: Cadena): Cliente
    }

    class List_Cliente["List<Cliente>"] {
        <<colección>>
        + buscar(pagina: Entero, limite: Entero, out total: Entero): Cliente[*]
        + buscarConHistorialSuficiente(): Cliente[*]
        + buscarConRecompraEstimadaDentroDe(dias: Entero): Cliente[*]
    }

    class Map_String_InvitacionRecompra["Map<String, InvitacionRecompra>"] {
        <<colección>>
        + get(clave: Cadena): InvitacionRecompra
    }

    class List_InvitacionRecompra["List<InvitacionRecompra>"] {
        <<colección>>
        + caducarVencidas(hoy: Fecha)
    }

    class UserAddressService {
        <<fachada>>
        + consultarDireccionDeEntrega(direccionId: Identificador): DireccionEntrega
        + consultarDireccionesDeEntrega(usuario: Usuario): DireccionEntrega[*]
        + consultarDireccionPredeterminada(usuario: Usuario): DireccionEntrega
        + editarDireccionDeEntrega(direccionId: Identificador, cambios: Registro): DireccionEntrega
        + eliminarDireccionDeEntrega(direccionId: Identificador)
        + marcarDireccionPredeterminada(direccionId: Identificador): DireccionEntrega
        + registrarDireccionDeEntrega(datos: Registro): DireccionEntrega
    }

    class Map_String_DireccionEntrega["Map<String, DireccionEntrega>"] {
        <<colección>>
        + get(clave: Cadena): DireccionEntrega
    }

    class Cliente
    class DireccionEntrega
    class InvitacionRecompra

    Map_String_Cliente "1" o-- "0..*" Cliente : elementos
    Map_String_DireccionEntrega "1" o-- "0..*" DireccionEntrega : elementos
    List_Cliente "1" o-- "0..*" Cliente : elementos
    Map_String_InvitacionRecompra "1" o-- "0..*" InvitacionRecompra : elementos
    List_InvitacionRecompra "1" o-- "0..*" InvitacionRecompra : elementos
    CustomersService --> "1" List_Cliente : list<Cliente>
    CustomersService --> "1" Map_String_Cliente : map<String, Cliente>
    UserAddressService --> "1" Map_String_Cliente : map<String, Cliente>
    UserAddressService --> "1" Map_String_DireccionEntrega : map<String, DireccionEntrega>
    CustomersService ..> Cliente
    UserAddressService ..> Cliente
    UserAddressService ..> DireccionEntrega
