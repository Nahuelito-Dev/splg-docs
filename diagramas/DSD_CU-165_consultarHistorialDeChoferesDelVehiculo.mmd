sequenceDiagram
    title DSD — CU-165 Consultar el Historial de Choferes de un Vehículo · consultarHistorialDeChoferesDelVehiculo
    autonumber
    actor ADM as Administrador (ACT-03)
    participant SRV as :VehicleAssignmentService
    participant COL as :Map#lt;String, Vehiculo#gt;
    participant VEH as vehiculo:Vehiculo

    ADM->>+SRV: consultarHistorialDeChoferesDelVehiculo(vehiculoId, pagina)
    SRV->>+COL: get(vehiculoId)
    COL-->>-SRV: vehiculo
    SRV->>+VEH: getHistorialDeChoferes(pagina)
    VEH-->>-SRV: asignaciones
    SRV-->>-ADM: asignaciones
