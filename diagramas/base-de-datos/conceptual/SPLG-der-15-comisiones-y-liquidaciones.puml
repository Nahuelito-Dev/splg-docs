@startuml
title Modelo entidad-relación conceptual — Comisiones y liquidaciones
!include ../../estilo-vp.iuml
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}

hide circle

skinparam nodesep 25
skinparam ranksep 45

entity Empleado {
  * identificador
  --
  {field} legajo
  {field} nombre
  {field} apellido
  {field} documento
  {field} CUIL
  {field} fecha de nacimiento
  {field} domicilio
  {field} teléfono
  {field} contacto de emergencia
  {field} fecha de ingreso
  {field} fecha de egreso
  {field} motivo de egreso
  {field} modalidad de contratación
  {field} estado
}
entity ReglaComision <<propuesto>> #FFF6D9;line:1F5E8C {
  * identificador
  --
  {field} base
  {field} valor
  {field} vigente desde
  {field} vigente hasta
  {field} activa
}
entity AsientoComision <<propuesto>> #FFF6D9;line:1F5E8C {
  * identificador
  --
  {field} tipo
  {field} importe
  {field} fecha
  {field} descripción
}
entity LiquidacionComisiones <<propuesto>> #FFF6D9;line:1F5E8C {
  * identificador
  --
  {field} número
  {field} período desde
  {field} período hasta
  {field} bruto
  {field} deducciones
  {field} neto
  {field} estado
  {field} aprobada el
  {field} pagada el
}
entity Chofer #F1F1F1 {
}
entity Producto #F1F1F1 {
}
entity Pedido #F1F1F1 {
}
entity MovimientoDeCaja #F1F1F1 {
}
entity Distribuidora #F1F1F1 {
}
entity RendicionChofer #F1F1F1 {
}
entity PuestoDeTrabajo #F1F1F1 {
}
entity Usuario #F1F1F1 {
}
entity JornadaDeTrabajo #F1F1F1 {
}
entity LicenciaLaboral #F1F1F1 {
}
entity CargaCombustible #F1F1F1 {
}
entity TareaMantenimiento #F1F1F1 {
}
entity MultaTransito #F1F1F1 {
}
entity Siniestro #F1F1F1 {
}
entity CargaDeCamion #F1F1F1 {
}
entity Adjunto #F1F1F1 {
}

Distribuidora ||--o{ Empleado : emplea >
Empleado }o--|| PuestoDeTrabajo : ocupa >
Empleado |o--o| Usuario : accede con >
Distribuidora ||--o{ ReglaComision : define >
ReglaComision }o--o| Empleado : se aplica a >
ReglaComision }o--o| Producto : se aplica a >
Empleado ||--o{ JornadaDeTrabajo : registra >
Empleado ||--o{ LicenciaLaboral : solicita >
Empleado |o--o{ CargaCombustible : carga >
TareaMantenimiento }o--o| Empleado : habilita >
Empleado |o--o{ MultaTransito : responde por >
Empleado |o--o{ Siniestro : interviene en >
Empleado ||--o{ LiquidacionComisiones : percibe >
LiquidacionComisiones |o--o| MovimientoDeCaja : se paga con >
Empleado |o--o{ CargaDeCamion : ayuda en >
Empleado ||--o{ AsientoComision : devenga >
AsientoComision }o--o| Pedido : corresponde a >
ReglaComision |o--o{ AsientoComision : determina >
RendicionChofer |o--o{ AsientoComision : origina >
LiquidacionComisiones |o--o{ AsientoComision : incluye >
Empleado ||--o{ Adjunto : conserva >
Empleado |o--o| Chofer : actúa como >

legend bottom right
  * identificador: atributo que identifica a cada instancia.  /atributo: atributo derivado.
  Las entidades en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml