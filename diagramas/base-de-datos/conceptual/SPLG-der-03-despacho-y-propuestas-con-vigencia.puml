@startuml
title Modelo entidad-relación conceptual — Despacho y propuestas con vigencia
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam dpi 150
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 12
}
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #2C4257

hide circle

skinparam nodesep 25
skinparam ranksep 45

entity OfertaDespacho {
  * identificador
  --
  {field} estado
  {field} vence
}
entity OfertaLote {
  * identificador
  --
  {field} estado
  {field} vence
}
entity LoteRecorrido {
  * identificador
  --
  {field} estado
  {field} /peso total
}
entity ParadaLote {
  * identificador
  --
  {field} orden
}
entity Pedido #F1F1F1 {
}
entity Chofer #F1F1F1 {
}

Chofer |o--o{ LoteRecorrido : acepta >
Pedido ||--o{ OfertaDespacho : genera >
LoteRecorrido ||--o{ OfertaLote : genera >
OfertaLote }o--|| Chofer : se dirige a >
LoteRecorrido ||--o{ ParadaLote : se compone de >
ParadaLote }o--|| Pedido : atiende >

legend bottom right
  * identificador: atributo que identifica a cada instancia.  /atributo: atributo derivado.
  Las entidades en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml