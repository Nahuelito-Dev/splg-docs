@startuml
title Modelo entidad-relación conceptual — Caja y movimientos
!include ../../estilo-vp.iuml
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}

hide circle

skinparam nodesep 25
skinparam ranksep 45

entity Caja {
  * identificador
  --
  {field} nombre
  {field} tipo
  {field} saldo
  {field} requiere sesión
  {field} activa
}
entity SesionDeCaja {
  * identificador
  --
  {field} estado
  {field} abierta el
  {field} monto inicial
  {field} cerrada el
  {field} /monto esperado
  {field} monto contado
  {field} /diferencia
  {field} observaciones
}
entity CategoriaDeCaja {
  * identificador
  --
  {field} nombre
  {field} sentido
  {field} código de sistema
  {field} activa
}
entity MovimientoDeCaja {
  * identificador
  --
  {field} sentido
  {field} importe
  {field} medio
  {field} fecha
  {field} descripción
  {field} origen
}
entity Distribuidora #F1F1F1 {
}
entity Usuario #F1F1F1 {
}
entity RendicionChofer #F1F1F1 {
}
entity AsientoCuentaCorriente #F1F1F1 {
}
entity LiquidacionComisiones #F1F1F1 {
}
entity GastoDeRendicion #F1F1F1 {
}

Distribuidora ||--o{ Caja : define >
Distribuidora ||--o{ CategoriaDeCaja : define >
Caja ||--o{ SesionDeCaja : registra >
Caja ||--o{ MovimientoDeCaja : asienta >
CategoriaDeCaja ||--o{ MovimientoDeCaja : clasifica >
Usuario ||--o{ MovimientoDeCaja : registró >
MovimientoDeCaja |o--o| MovimientoDeCaja : anula a >
SesionDeCaja |o--o{ MovimientoDeCaja : agrupa >
AsientoCuentaCorriente |o--o| MovimientoDeCaja : se asienta en >
LiquidacionComisiones |o--o| MovimientoDeCaja : se paga con >
RendicionChofer |o--o| MovimientoDeCaja : genera >
RendicionChofer }o--o| Caja : ingresa en >
GastoDeRendicion }o--|| CategoriaDeCaja : se clasifica en >

legend bottom right
  * identificador: atributo que identifica a cada instancia.  /atributo: atributo derivado.
  Las entidades en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml