@startuml
title Modelo entidad-relación conceptual — Caja y movimientos
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam dpi 150
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 12
}
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #2C4257

hide circle

skinparam nodesep 25
skinparam ranksep 45

entity Caja <<propuesto>> #E4EDF4;line:1F5E8C {
  * identificador
  --
  {field} nombre
  {field} tipo
  {field} saldo
  {field} requiere sesión
  {field} activa
}
entity SesionDeCaja <<propuesto>> #E4EDF4;line:1F5E8C {
  * identificador
  --
  {field} estado
  {field} abierta el
  {field} monto inicial
  {field} cerrada el
  {field} monto esperado
  {field} monto contado
  {field} diferencia
  {field} observaciones
}
entity CategoriaDeCaja <<propuesto>> #E4EDF4;line:1F5E8C {
  * identificador
  --
  {field} nombre
  {field} sentido
  {field} código de sistema
  {field} activa
}
entity MovimientoDeCaja <<propuesto>> #E4EDF4;line:1F5E8C {
  * identificador
  --
  {field} sentido
  {field} importe
  {field} medio
  {field} fecha
  {field} descripción
  {field} origen
}
entity Distribuidora #F1F1F1 {
}
entity RendicionChofer #F1F1F1 {
}
entity AsientoCuentaCorriente #F1F1F1 {
}
entity LiquidacionComisiones #F1F1F1 {
}

Distribuidora ||--o{ Caja : define >
Distribuidora ||--o{ CategoriaDeCaja : define >
Caja ||--o{ SesionDeCaja : registra >
Caja ||--o{ MovimientoDeCaja : asienta >
SesionDeCaja |o--o{ MovimientoDeCaja : agrupa >
CategoriaDeCaja ||--o{ MovimientoDeCaja : clasifica >
MovimientoDeCaja |o--o| MovimientoDeCaja : anula a >
LiquidacionComisiones }o--o| MovimientoDeCaja : se paga con >
RendicionChofer }o--o| Caja : ingresa en >
RendicionChofer }o--o| MovimientoDeCaja : genera >
AsientoCuentaCorriente }o--o| MovimientoDeCaja : se asienta en >

legend bottom right
  * identificador: atributo que identifica a cada instancia.  /atributo: atributo derivado.
  Las entidades en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml