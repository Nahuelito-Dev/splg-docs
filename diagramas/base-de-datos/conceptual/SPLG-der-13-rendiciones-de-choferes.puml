@startuml
title Modelo entidad-relación conceptual — Rendiciones de choferes
!include ../../estilo-vp.iuml
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}

hide circle

skinparam nodesep 25
skinparam ranksep 45

entity RendicionChofer <<propuesto>> #FFF6D9;line:1F5E8C {
  * identificador
  --
  {field} número
  {field} fecha de negocio
  {field} estado
  {field} efectivo esperado
  {field} efectivo declarado
  {field} /gastos del chofer
  {field} /diferencia
  {field} resolución de la diferencia
  {field} presentada el
  {field} aprobada el
  {field} observaciones
  {field} aviso enviado el
}
entity PedidoRendido <<propuesto>> #FFF6D9;line:1F5E8C {
  * identificador
  --
  {field} importe
  {field} medio de pago
}
entity GastoDeRendicion <<propuesto>> #FFF6D9;line:1F5E8C {
  * identificador
  --
  {field} importe
  {field} descripción
}
entity Chofer #F1F1F1 {
}
entity Pedido #F1F1F1 {
}
entity Caja #F1F1F1 {
}
entity MovimientoDeCaja #F1F1F1 {
}
entity CategoriaDeCaja #F1F1F1 {
}
entity AsientoCuentaCorriente #F1F1F1 {
}
entity AsientoComision #F1F1F1 {
}

Chofer ||--o{ RendicionChofer : presenta >
RendicionChofer }o--o| Caja : ingresa en >
RendicionChofer |o--o| MovimientoDeCaja : genera >
RendicionChofer |o--o{ AsientoComision : origina >
RendicionChofer |o--o{ AsientoCuentaCorriente : incluye >
RendicionChofer ||--o{ GastoDeRendicion : declara >
GastoDeRendicion }o--|| CategoriaDeCaja : se clasifica en >
RendicionChofer ||--o{ PedidoRendido : rinde >
PedidoRendido |o--|| Pedido : corresponde a >

legend bottom right
  * identificador: atributo que identifica a cada instancia.  /atributo: atributo derivado.
  Las entidades en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml