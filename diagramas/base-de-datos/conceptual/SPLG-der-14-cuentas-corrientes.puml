@startuml
title Modelo entidad-relación conceptual — Cuentas corrientes
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam dpi 150
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 12
}
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #2C4257

hide circle

skinparam nodesep 25
skinparam ranksep 45

entity CuentaCorriente <<propuesto>> #E4EDF4;line:1F5E8C {
  * identificador
  --
  {field} razón social
  {field} CUIT
  {field} condición fiscal
  {field} límite de crédito
  {field} plazo de pago en días
  {field} estado
  {field} saldo
}
entity AsientoCuentaCorriente <<propuesto>> #E4EDF4;line:1F5E8C {
  * identificador
  --
  {field} tipo
  {field} importe
  {field} vence
  {field} medio de pago
  {field} fecha
  {field} descripción
}
entity ImputacionCuentaCorriente <<propuesto>> #E4EDF4;line:1F5E8C {
  * identificador
  --
  {field} importe
}
entity Cliente #F1F1F1 {
}
entity Distribuidora #F1F1F1 {
}
entity Pedido #F1F1F1 {
}
entity MovimientoDeCaja #F1F1F1 {
}
entity Chofer #F1F1F1 {
}
entity RendicionChofer #F1F1F1 {
}

Distribuidora ||--o{ CuentaCorriente : lleva >
Cliente ||--o{ CuentaCorriente : tiene habilitada >
CuentaCorriente ||--o{ AsientoCuentaCorriente : registra >
Pedido |o--o{ AsientoCuentaCorriente : origina >
AsientoCuentaCorriente |o--o| MovimientoDeCaja : se asienta en >
Chofer |o--o{ AsientoCuentaCorriente : cobra >
RendicionChofer |o--o{ AsientoCuentaCorriente : incluye >
AsientoCuentaCorriente |o--o| AsientoCuentaCorriente : anula a >
ImputacionCuentaCorriente }o--|| AsientoCuentaCorriente : salda >
ImputacionCuentaCorriente }o--|| AsientoCuentaCorriente : se aplica con >

legend bottom right
  * identificador: atributo que identifica a cada instancia.  /atributo: atributo derivado.
  Las entidades en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml