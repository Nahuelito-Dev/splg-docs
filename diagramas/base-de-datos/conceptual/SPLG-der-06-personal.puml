@startuml
title Modelo entidad-relación conceptual — Personal
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam dpi 150
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 12
}
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #2C4257

hide circle

skinparam nodesep 25
skinparam ranksep 45

entity PuestoDeTrabajo <<propuesto>> #E4EDF4;line:1F5E8C {
  * identificador
  --
  {field} nombre
  {field} categoría
  {field} activo
}
entity Empleado <<propuesto>> #E4EDF4;line:1F5E8C {
  * identificador
  --
  {field} legajo
  {field} nombre
  {field} apellido
  {field} documento
  {field} CUIL
  {field} fecha de nacimiento
  {field} domicilio
  {field} teléfono
  {field} contacto de emergencia
  {field} fecha de ingreso
  {field} fecha de egreso
  {field} motivo de egreso
  {field} modalidad de contratación
  {field} estado
}
entity JornadaDeTrabajo <<propuesto>> #E4EDF4;line:1F5E8C {
  * identificador
  --
  {field} día
  {field} ingreso
  {field} egreso
  {field} origen
  {field} observación
}
entity LicenciaLaboral <<propuesto>> #E4EDF4;line:1F5E8C {
  * identificador
  --
  {field} tipo
  {field} desde
  {field} hasta
  {field} /días
  {field} estado
  {field} motivo
  {field} motivo de rechazo
  {field} resuelta el
}
entity Adjunto {
  * identificador
  --
  {field} nombre original
  {field} tipo de archivo
  {field} etiqueta
  {field} fecha de carga
}
entity Distribuidora #F1F1F1 {
}
entity Usuario #F1F1F1 {
}
entity TareaMantenimiento #F1F1F1 {
}

Distribuidora ||--o{ PuestoDeTrabajo : define >
Distribuidora ||--o{ Empleado : emplea >
Empleado |o--o| Usuario : accede con >
Empleado }o--|| PuestoDeTrabajo : ocupa >
Empleado ||--o{ JornadaDeTrabajo : registra >
Empleado ||--o{ LicenciaLaboral : solicita >
Usuario |o--o{ LicenciaLaboral : resuelve >
TareaMantenimiento }o--o| Empleado : habilita >
Empleado ||--o{ Adjunto : conserva >

legend bottom right
  * identificador: atributo que identifica a cada instancia.  /atributo: atributo derivado.
  Las entidades en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml