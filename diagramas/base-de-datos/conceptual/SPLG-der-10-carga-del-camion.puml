@startuml
title Modelo entidad-relación conceptual — Carga del camión
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam dpi 150
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 12
}
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #2C4257

hide circle

skinparam nodesep 25
skinparam ranksep 45

entity CargaDeCamion <<propuesto>> #E4EDF4;line:1F5E8C {
  * identificador
  --
  {field} número
  {field} día
  {field} estado
  {field} abierta el
  {field} salió el
  {field} regresó el
  {field} cerrada el
  {field} nota de diferencia
}
entity ItemCarga <<propuesto>> #E4EDF4;line:1F5E8C {
  * identificador
  --
  {field} llenas cargadas
  {field} llenas repuestas
  {field} vacías cargadas
  {field} llenas declaradas al regreso
  {field} vacías declaradas al regreso
  {field} llenas entregadas
  {field} vacías recolectadas
  {field} /llenas esperadas
  {field} /vacías esperadas
  {field} diferencia de llenas
  {field} diferencia de vacías
}
entity Vehiculo #F1F1F1 {
}
entity Chofer #F1F1F1 {
}
entity UbicacionDeStock #F1F1F1 {
}
entity Producto #F1F1F1 {
}
entity Usuario #F1F1F1 {
}

Vehiculo ||--o{ CargaDeCamion : transporta >
Chofer ||--o{ CargaDeCamion : reparte con >
CargaDeCamion }o--|| UbicacionDeStock : parte de >
Usuario ||--o{ CargaDeCamion : abre >
Usuario |o--o{ CargaDeCamion : cierra >
CargaDeCamion ||--|{ ItemCarga : contiene >
ItemCarga }o--|| Producto : corresponde a >

legend bottom right
  * identificador: atributo que identifica a cada instancia.  /atributo: atributo derivado.
  Las entidades en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml