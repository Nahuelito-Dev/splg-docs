@startuml
title Modelo entidad-relación conceptual — Posventa
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam dpi 150
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 12
}
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #2C4257

hide circle

skinparam nodesep 25
skinparam ranksep 45

entity Calificacion {
  * identificador
  --
  {field} puntaje
  {field} comentario
}
entity Incidencia {
  * identificador
  --
  {field} tipo
  {field} momento
  {field} descripción
  {field} estado
  {field} resolución
  {field} fotografía
}
entity Reclamo {
  * identificador
  --
  {field} motivo
  {field} descripción
  {field} estado
  {field} resolución
  {field} fotografía
}
entity Usuario #F1F1F1 {
}
entity Pedido #F1F1F1 {
}
entity Cliente #F1F1F1 {
}

Cliente ||--o{ Reclamo : presenta >
Pedido ||--o{ Reclamo : origina >
Pedido ||--o{ Incidencia : origina >
Usuario ||--o{ Incidencia : reporta >
Usuario ||--o{ Calificacion : emite >
Pedido ||--o{ Calificacion : recibe [0..2] >
Usuario ||--o{ Calificacion : recibe >

legend bottom right
  * identificador: atributo que identifica a cada instancia.  /atributo: atributo derivado.
  Las entidades en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml