@startuml
title Modelo entidad-relación conceptual — Envases y catálogo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam dpi 150
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 12
}
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #2C4257

hide circle

skinparam nodesep 25
skinparam ranksep 45

entity Producto {
  * identificador
  --
  {field} tipo
  {field} peso en kilos
  {field} precio
  {field} stock
  {field} activo
  {field} costo promedio
}
entity Promocion {
  * identificador
  --
  {field} cantidad
  {field} descuento
}
entity Envase {
  * identificador
  --
  {field} número de serie
  {field} estado
  {field} monto del depósito
  {field} /vencimiento
}
entity MovimientoEnvase {
  * identificador
  --
  {field} desde
  {field} hacia
  {field} fecha
}
entity RevisionEnvase {
  * identificador
  --
  {field} fecha
  {field} resultado
  {field} próxima revisión
}
entity CasoRecupero {
  * identificador
  --
  {field} escalón
  {field} depósito comprometido
  {field} estado
  {field} resolución
}
entity AvisoRecupero {
  * identificador
  --
  {field} estado
  {field} escalón
  {field} tipo
  {field} vence
}
entity Cliente #F1F1F1 {
}
entity Pedido #F1F1F1 {
}
entity Usuario #F1F1F1 {
}
entity Distribuidora #F1F1F1 {
}
entity UmbralDeStock #F1F1F1 {
}
entity ItemCarrito #F1F1F1 {
}
entity ReglaComision #F1F1F1 {
}
entity ItemOrdenDeCompra #F1F1F1 {
}
entity ItemPedido #F1F1F1 {
}
entity ItemRecepcion #F1F1F1 {
}
entity SaldoDeStock #F1F1F1 {
}
entity MovimientoDeStock #F1F1F1 {
}
entity ItemAjusteDeStock #F1F1F1 {
}
entity ItemCarga #F1F1F1 {
}

Distribuidora ||--o{ Producto : comercializa >
Cliente }o--o| Producto : usa habitualmente >
Producto ||--o{ Promocion : ofrece >
UmbralDeStock }o--|| Producto : controla >
ItemCarrito }o--|| Producto : corresponde a >
ReglaComision }o--o| Producto : se aplica a >
ItemOrdenDeCompra }o--|| Producto : corresponde a >
Cliente |o--o{ Envase : tiene en su poder >
Pedido |o--o{ Envase : despacha >
Distribuidora ||--o{ Envase : posee >
Producto |o--o{ Envase : describe >
ItemPedido }o--|| Producto : corresponde a >
ItemRecepcion }o--|| Producto : corresponde a >
SaldoDeStock }o--|| Producto : corresponde a >
MovimientoDeStock }o--|| Producto : corresponde a >
Envase ||--o{ RevisionEnvase : se somete a >
Usuario |o--o{ MovimientoEnvase : ejecuta >
Envase ||--o{ MovimientoEnvase : registra >
Pedido |o--o{ MovimientoEnvase : origina >
Envase ||--o{ CasoRecupero : motiva >
Usuario |o--o{ CasoRecupero : resuelve >
CasoRecupero }o--|| Cliente : se abre contra >
ItemAjusteDeStock }o--|| Producto : corresponde a >
ItemCarga }o--|| Producto : corresponde a >
CasoRecupero ||--o{ AvisoRecupero : emite >

legend bottom right
  * identificador: atributo que identifica a cada instancia.  /atributo: atributo derivado.
  Las entidades en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml