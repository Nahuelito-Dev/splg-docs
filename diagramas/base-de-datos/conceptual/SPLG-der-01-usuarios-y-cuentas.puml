@startuml
title Modelo entidad-relación conceptual — Usuarios y cuentas
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam dpi 150
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 12
}
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #2C4257

hide circle

skinparam nodesep 25
skinparam ranksep 45

entity Distribuidora {
  * identificador
  --
  {field} nombre
  {field} razón social
  {field} CUIT
  {field} estado
}
entity Usuario {
  * identificador
  --
  {field} nombre
  {field} correo
  {field} teléfono
  {field} bloqueado
}
entity Rol {
  * identificador
  --
  {field} tipo
}
entity Administrador {
  * identificador
  --
}
entity ConfiguracionModulo {
  * identificador
  --
  {field} módulo
  {field} parámetros
  {field} exigir carga de camión abierta
}
entity AsientoAuditoria {
  * identificador
  --
  {field} operación
  {field} recurso
  {field} aplicación
  {field} resultado
  {field} cambios
  {field} fecha
}
entity Auditoria {
  * identificador
  --
  {field} entidad afectada
  {field} fecha y hora
}
entity DetalleAuditoria {
  * identificador
  --
  {field} campo
  {field} valor anterior
  {field} valor nuevo
}
entity TipoAccionAuditoria {
  * identificador
  --
  {field} nombre
}
entity Cliente {
  * identificador
  --
  {field} consumo mensual declarado
  {field} días de aviso
}
entity DireccionEntrega {
  * identificador
  --
  {field} calle y altura
  {field} piso y departamento
  {field} punto
  {field} precisión
  {field} predeterminada
}
entity InvitacionRecompra {
  * identificador
  --
  {field} estado
  {field} vence
  {field} agotamiento estimado
}
entity Chofer #F1F1F1 {
}
entity Producto #F1F1F1 {
}
entity Pedido #F1F1F1 {
}
entity Caja #F1F1F1 {
}
entity CategoriaDeCaja #F1F1F1 {
}
entity ZonaCobertura #F1F1F1 {
}
entity PuestoDeTrabajo #F1F1F1 {
}
entity Proveedor #F1F1F1 {
}
entity FranjaHoraria #F1F1F1 {
}
entity Deposito #F1F1F1 {
}
entity Carrito #F1F1F1 {
}
entity CuentaCorriente #F1F1F1 {
}
entity Empleado #F1F1F1 {
}
entity OrdenDeCompra #F1F1F1 {
}
entity ReglaComision #F1F1F1 {
}
entity LicenciaLaboral #F1F1F1 {
}
entity RecepcionDeCompra #F1F1F1 {
}
entity Neumatico #F1F1F1 {
}
entity Reclamo #F1F1F1 {
}
entity Envase #F1F1F1 {
}
entity Incidencia #F1F1F1 {
}
entity CambioDireccion #F1F1F1 {
}
entity CambioEstadoPedido #F1F1F1 {
}
entity Calificacion #F1F1F1 {
}
entity AjusteDeStock #F1F1F1 {
}
entity MovimientoDeStock #F1F1F1 {
}
entity CargaDeCamion #F1F1F1 {
}
entity MovimientoEnvase #F1F1F1 {
}
entity CasoRecupero #F1F1F1 {
}

Distribuidora ||--o{ Caja : define >
Distribuidora ||--o{ CategoriaDeCaja : define >
Distribuidora ||--o{ ZonaCobertura : define >
Distribuidora ||--o{ Producto : comercializa >
Distribuidora ||--o{ PuestoDeTrabajo : define >
Distribuidora ||--o{ Proveedor : compra a >
Distribuidora ||--o{ FranjaHoraria : define >
Usuario }o--o| Rol : tiene asignado >
Distribuidora ||--o{ Deposito : dispone de >
Distribuidora |o--o{ Administrador : emplea >
Administrador |o--|| Usuario : es un >
TipoAccionAuditoria ||--o{ Auditoria : clasifica >
Distribuidora |o--o{ Auditoria : delimita >
Usuario |o--o{ Auditoria : realiza >
Usuario |o--o{ AsientoAuditoria : origina >
Cliente ||--o{ Carrito : arma >
Cliente }o--o| Producto : usa habitualmente >
Cliente |o--|| Usuario : es un >
Distribuidora ||--o{ CuentaCorriente : lleva >
Cliente ||--o{ CuentaCorriente : tiene habilitada >
Distribuidora ||--o{ Chofer : emplea >
Chofer |o--|| Usuario : es un >
Distribuidora ||--o{ Empleado : emplea >
Empleado |o--o| Usuario : accede con >
Distribuidora ||--o{ ConfiguracionModulo : parametriza >
Usuario ||--o{ OrdenDeCompra : emite >
Cliente ||--o{ DireccionEntrega : registra >
Auditoria ||--o{ DetalleAuditoria : detalla con >
Distribuidora ||--o{ ReglaComision : define >
Usuario |o--o{ LicenciaLaboral : resuelve >
Pedido }o--|| DireccionEntrega : se entrega en >
Cliente ||--o{ Pedido : realiza >
Distribuidora ||--o{ Pedido : gestiona >
Usuario ||--o{ RecepcionDeCompra : registra >
Distribuidora ||--o{ Neumatico : posee >
Cliente ||--o{ Reclamo : presenta >
Cliente |o--o{ Envase : tiene en su poder >
Distribuidora ||--o{ Envase : posee >
Usuario ||--o{ Incidencia : reporta >
Usuario ||--o{ CambioDireccion : realiza >
CambioDireccion }o--|| DireccionEntrega : cambia desde >
CambioDireccion }o--|| DireccionEntrega : cambia hacia >
Usuario |o--o{ CambioEstadoPedido : efectúa >
Usuario ||--o{ Calificacion : emite >
Usuario ||--o{ Calificacion : recibe >
InvitacionRecompra }o--o| DireccionEntrega : sugiere entregar en >
InvitacionRecompra |o--o| Pedido : se convierte en >
Cliente ||--o{ InvitacionRecompra : recibe >
Usuario ||--o{ AjusteDeStock : registra >
Usuario |o--o{ MovimientoDeStock : ejecuta >
Usuario |o--o{ CargaDeCamion : cierra >
Usuario ||--o{ CargaDeCamion : abre >
Usuario |o--o{ MovimientoEnvase : ejecuta >
Usuario |o--o{ CasoRecupero : resuelve >
CasoRecupero }o--|| Cliente : se abre contra >

legend bottom right
  * identificador: atributo que identifica a cada instancia.  /atributo: atributo derivado.
  Las entidades en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml