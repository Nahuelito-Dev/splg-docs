@startuml
title Modelo físico — Organización y acceso
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam dpi 150
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 12
}
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #2C4257

hide circle
skinparam linetype polyline

entity "audit_action_type" as e_audit_action_type {
  {field} **action_type_id** : smallint * <<PK>>
  {field} name : varchar(40) *
}
entity "distributor" as e_distributor {
  {field} **distributor_id** : uuid * <<PK>>
  {field} name : varchar(120) *
  {field} slug : varchar(60) *
  {field} legal_name : varchar(160)
  {field} tax_id : varchar(20)
  {field} email : varchar
  {field} phone : varchar
  {field} logo_url : varchar
  {field} status : distributor_status_enum *
  {field} plan : varchar
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
  {field} deletedAt : timestamptz
}
entity "role" as e_role {
  {field} **role_id** : uuid * <<PK>>
  {field} type : text *
  {field} createdAt : timestamptz
  {field} updatedAt : timestamptz
  {field} deletedAt : timestamptz
}
entity "user" as e_user {
  {field} **user_id** : uuid * <<PK>>
  {field} //role_id// : uuid <<FK>>
  {field} firebase_uid : varchar
  {field} full_name : varchar
  {field} selfie : varchar
  {field} email : varchar
  {field} phone_number : varchar
  {field} phone_verified : boolean *
  {field} email_verified : boolean *
  {field} blocked : boolean *
  {field} createdAt : timestamptz *
  {field} deletedAt : timestamptz
}
entity "admin" as e_admin {
  {field} **admin_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid <<FK>>
  {field} //user_id// : uuid * <<FK>>
  {field} createdAt : timestamptz *
}
entity "audit" as e_audit {
  {field} **audit_id** : uuid * <<PK>>
  {field} //action_type_id// : smallint * <<FK>>
  {field} //user_id// : uuid <<FK>>
  {field} //distributor_id// : uuid <<FK>>
  {field} entity : varchar(60) *
  {field} record_id : varchar(64) *
  {field} ip : varchar(45)
  {field} created_at : timestamptz *
}
entity "audit_log" as e_audit_log {
  {field} **audit_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid <<FK>>
  {field} //actor_user_id// : uuid <<FK>>
  {field} actor_role : varchar(30)
  {field} http_method : varchar(10) *
  {field} resource : varchar(60) *
  {field} resource_id : varchar(64)
  {field} path : varchar(255) *
  {field} client_source : varchar(30)
  {field} ip : varchar(45)
  {field} result : audit_result_enum *
  {field} status_code : integer *
  {field} changes : jsonb
  {field} error_message : text
  {field} created_at : timestamptz *
}
entity "module_config" as e_module_config {
  {field} **config_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} module : configurable_process_enum *
  {field} params : jsonb *
  {field} updated_at : timestamptz *
  {field} //updated_by_user_id// : uuid <<FK>>
}
entity "audit_detail" as e_audit_detail {
  {field} **audit_detail_id** : uuid * <<PK>>
  {field} //audit_id// : uuid * <<FK>>
  {field} field : varchar(80) *
  {field} old_value : text
  {field} new_value : text
}

e_role |o--o{ e_user : role_id
e_distributor |o--o{ e_admin : distributor_id
e_user ||--o| e_admin : user_id
e_audit_action_type ||--o{ e_audit : action_type_id
e_distributor |o--o{ e_audit : distributor_id
e_user |o--o{ e_audit : user_id
e_user |o--o{ e_audit_log : actor_user_id
e_distributor |o--o{ e_audit_log : distributor_id
e_distributor ||--o{ e_module_config : distributor_id
e_user |o--o{ e_module_config : updated_by_user_id
e_audit ||--o{ e_audit_detail : audit_id

legend bottom
|<#F1F1F1> **tabla de otro contexto** | sólo se muestra su nombre; sus columnas están en su propio contexto |
endlegend
note as N
  Los nombres reflejan la base real: conviven camelCase (paymentMethod, createdAt, isActive) y snake_case
  (scheduled_date, delivery_mode) porque las columnas más antiguas se crearon así y las posteriores siguieron
  otra convención; la tabla claims está en plural y el resto en singular.
end note
@enduml