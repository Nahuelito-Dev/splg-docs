@startuml
title Modelo físico — Clientes
!include ../../estilo-vp.iuml
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}

hide circle
skinparam linetype polyline

entity "customer" as e_customer {
  {field} **customer_id** : uuid * <<PK>>
  {field} //user_id// : uuid * <<FK>>
  {field} notification_token : text
  {field} createdAt : timestamptz
  {field} deletedAt : timestamptz
  {field} location : geometry
  {field} avg_monthly_consumption_kg : numeric(10,2)
  {field} //declared_cylinder_type_id// : uuid <<FK>>
  {field} repurchase_notice_days : integer
  {field} next_repurchase_estimate_at : timestamptz
}
entity "user_address" as e_user_address {
  {field} **address_id** : uuid * <<PK>>
  {field} //user_id// : uuid * <<FK>>
  {field} street : varchar(255) *
  {field} city : varchar(100) *
  {field} postalCode : varchar(20)
  {field} formattedAddress : text
  {field} isDefault : boolean *
  {field} additionalInstructions : text
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
  {field} deletedAt : timestamptz
  {field} floor : varchar(10)
  {field} apartment : varchar(10)
  {field} location : geometry
  {field} place_id : varchar(255)
  {field} geocode_precision : address_geocode_precision_enum *
}
entity "repurchase_invitation" as e_repurchase_invitation {
  {field} **invitation_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //user_id// : uuid * <<FK>>
  {field} //address_id// : uuid <<FK>>
  {field} projected_depletion_at : timestamptz *
  {field} suggested_items : jsonb *
  {field} status : repurchase_invitation_status_enum *
  {field} expires_at : timestamptz *
  {field} responded_at : timestamptz
  {field} //order_id// : uuid <<FK>>
  {field} created_at : timestamptz *
}
entity "gas_cylinder" as e_gas_cylinder #F1F1F1 {
}
entity "user" as e_user #F1F1F1 {
}
entity "order" as e_order #F1F1F1 {
}

e_gas_cylinder |o--o{ e_customer : declared_cylinder_type_id
e_user ||--o| e_customer : user_id
e_user ||--o{ e_user_address : user_id
e_user_address |o--o{ e_repurchase_invitation : address_id
e_order |o--o{ e_repurchase_invitation : order_id
e_user ||--o{ e_repurchase_invitation : user_id
e_user_address ||--o{ e_order : address_id

legend bottom
|<#F1F1F1> **tabla de otro contexto** | solo se muestra su nombre; sus columnas están en su propio contexto |
|<#FFFFFF> **distributor_id** | la tabla pertenece a una distribuidora (FK a distributor); la línea no se dibuja |
endlegend
note as N
  Los nombres reflejan la base real: conviven camelCase (paymentMethod, createdAt, isActive) y snake_case
  (scheduled_date, delivery_mode) porque las columnas más antiguas se crearon así y las posteriores siguieron
  otra convención; la tabla claims está en plural y el resto en singular.
end note
@enduml