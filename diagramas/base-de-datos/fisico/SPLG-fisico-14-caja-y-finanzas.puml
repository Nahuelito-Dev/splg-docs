@startuml
title Modelo físico — Caja y finanzas
!include ../../estilo-vp.iuml
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}

hide circle
skinparam linetype polyline

entity "cash_box" as e_cash_box {
  {field} **cash_box_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} name : varchar(80) *
  {field} kind : cash_box_kind_enum *
  {field} balance : numeric(14,2) *
  {field} requires_session : boolean *
  {field} is_active : boolean *
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
  {field} deletedAt : timestamptz
}
entity "cash_category" as e_cash_category {
  {field} **category_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} name : varchar(80) *
  {field} direction : cash_category_direction_enum *
  {field} system_code : cash_category_system_code_enum
  {field} is_active : boolean *
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
}
entity "cash_session" as e_cash_session {
  {field} **session_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //cash_box_id// : uuid * <<FK>>
  {field} status : cash_session_status_enum *
  {field} opened_at : timestamptz *
  {field} //opened_by_user_id// : uuid * <<FK>>
  {field} opening_amount : numeric(14,2) *
  {field} closed_at : timestamptz
  {field} //closed_by_user_id// : uuid <<FK>>
  {field} expected_amount : numeric(14,2)
  {field} counted_amount : numeric(14,2)
  {field} difference : numeric(14,2)
  {field} notes : text
}
entity "customer_account" as e_customer_account {
  {field} **account_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //customer_user_id// : uuid * <<FK>>
  {field} business_name : varchar(120) *
  {field} tax_id : varchar(11)
  {field} tax_condition : customer_account_tax_condition_enum *
  {field} credit_limit : numeric(12,2) *
  {field} payment_terms_days : integer *
  {field} status : customer_account_status_enum *
  {field} balance : numeric(14,2) *
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
  {field} deletedAt : timestamptz
}
entity "cash_movement" as e_cash_movement {
  {field} **movement_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //cash_box_id// : uuid * <<FK>>
  {field} //session_id// : uuid <<FK>>
  {field} direction : cash_movement_direction_enum *
  {field} amount : numeric(12,2) *
  {field} //category_id// : uuid * <<FK>>
  {field} method : cash_movement_method_enum *
  {field} occurred_at : timestamptz *
  {field} description : varchar(255) *
  {field} reference_type : cash_movement_reference_type_enum *
  {field} reference_id : uuid
  {field} //reverses_movement_id// : uuid <<FK>>
  {field} //created_by_user_id// : uuid * <<FK>>
  {field} createdAt : timestamptz *
}
entity "commission_rule" as e_commission_rule {
  {field} **rule_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //employee_id// : uuid <<FK>>
  {field} //gas_cylinder_id// : uuid <<FK>>
  {field} basis : commission_rule_basis_enum *
  {field} value : numeric(10,4) *
  {field} valid_from : date *
  {field} valid_to : date
  {field} is_active : boolean *
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
}
entity "customer_account_entry" as e_customer_account_entry {
  {field} **entry_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //account_id// : uuid * <<FK>>
  {field} type : customer_account_entry_type_enum *
  {field} amount : numeric(12,2) *
  {field} //order_id// : uuid <<FK>>
  {field} due_date : date
  {field} payment_method : varchar(20)
  {field} //cash_movement_id// : uuid <<FK>>
  {field} //collected_by_delivery_id// : uuid <<FK>>
  {field} description : varchar(255)
  {field} occurred_at : timestamptz *
  {field} //created_by_user_id// : uuid <<FK>>
  {field} createdAt : timestamptz *
}
entity "driver_liquidation" as e_driver_liquidation {
  {field} **liquidation_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} number : integer *
  {field} //employee_id// : uuid * <<FK>>
  {field} period_from : date *
  {field} period_to : date *
  {field} gross : numeric(12,2) *
  {field} deductions : numeric(12,2) *
  {field} net : numeric(12,2) *
  {field} status : driver_liquidation_status_enum *
  {field} approved_at : timestamptz
  {field} //approved_by_user_id// : uuid <<FK>>
  {field} paid_at : timestamptz
  {field} //paid_by_user_id// : uuid <<FK>>
  {field} voided_at : timestamptz
  {field} //cash_movement_id// : uuid <<FK>>
  {field} //created_by_user_id// : uuid * <<FK>>
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
}
entity "commission_entry" as e_commission_entry {
  {field} **entry_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //employee_id// : uuid * <<FK>>
  {field} //delivery_id// : uuid <<FK>>
  {field} type : commission_entry_type_enum *
  {field} amount : numeric(12,2) *
  {field} //order_id// : uuid <<FK>>
  {field} //rule_id// : uuid <<FK>>
  {field} rule_snapshot : jsonb
  {field} //liquidation_id// : uuid <<FK>>
  {field} reference_id : uuid
  {field} description : varchar(255) *
  {field} occurred_at : timestamptz *
  {field} //created_by_user_id// : uuid <<FK>>
  {field} createdAt : timestamptz *
}
entity "customer_account_allocation" as e_customer_account_allocation {
  {field} **allocation_id** : uuid * <<PK>>
  {field} //account_id// : uuid * <<FK>>
  {field} //debit_entry_id// : uuid * <<FK>>
  {field} //credit_entry_id// : uuid * <<FK>>
  {field} amount : numeric(12,2) *
}
entity "driver_settlement" as e_driver_settlement {
  {field} **settlement_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //delivery_id// : uuid * <<FK>>
  {field} number : integer *
  {field} //truck_load_id// : uuid <<FK>>
  {field} business_date : date *
  {field} status : driver_settlement_status_enum *
  {field} expected_cash : numeric(12,2) *
  {field} declared_cash : numeric(12,2)
  {field} driver_expenses : numeric(12,2) *
  {field} difference : numeric(12,2)
  {field} difference_resolution : driver_settlement_difference_resolution_enum
  {field} //destination_cash_box_id// : uuid <<FK>>
  {field} //cash_movement_id// : uuid <<FK>>
  {field} submitted_at : timestamptz
  {field} //submitted_by_user_id// : uuid <<FK>>
  {field} approved_at : timestamptz
  {field} //approved_by_user_id// : uuid <<FK>>
  {field} notes : text
  {field} overdue_alerted_at : timestamptz
  {field} createdAt : timestamptz *
  {field} updatedAt : timestamptz *
}
entity "driver_settlement_collection" as e_driver_settlement_collection {
  {field} **collection_id** : uuid * <<PK>>
  {field} //settlement_id// : uuid * <<FK>>
  {field} //entry_id// : uuid * <<FK>>
  {field} amount : numeric(12,2) *
  {field} createdAt : timestamptz *
}
entity "driver_settlement_expense" as e_driver_settlement_expense {
  {field} **expense_id** : uuid * <<PK>>
  {field} //settlement_id// : uuid * <<FK>>
  {field} //category_id// : uuid * <<FK>>
  {field} amount : numeric(12,2) *
  {field} description : varchar(255)
}
entity "driver_settlement_order" as e_driver_settlement_order {
  {field} **settlement_order_id** : uuid * <<PK>>
  {field} //settlement_id// : uuid * <<FK>>
  {field} //order_id// : uuid * <<FK>>
  {field} amount : numeric(12,2) *
  {field} payment_method : varchar(20) *
}
entity "user" as e_user #F1F1F1 {
}
entity "employee" as e_employee #F1F1F1 {
}
entity "gas_cylinder" as e_gas_cylinder #F1F1F1 {
}
entity "delivery" as e_delivery #F1F1F1 {
}
entity "order" as e_order #F1F1F1 {
}
entity "truck_load" as e_truck_load #F1F1F1 {
}

e_cash_box ||--o{ e_cash_session : cash_box_id
e_user |o--o{ e_cash_session : closed_by_user_id
e_user ||--o{ e_cash_session : opened_by_user_id
e_user ||--o{ e_customer_account : customer_user_id
e_cash_box ||--o{ e_cash_movement : cash_box_id
e_cash_category ||--o{ e_cash_movement : category_id
e_user ||--o{ e_cash_movement : created_by_user_id
e_cash_movement |o--o{ e_cash_movement : reverses_movement_id
e_cash_session |o--o{ e_cash_movement : session_id
e_employee |o--o{ e_commission_rule : employee_id
e_gas_cylinder |o--o{ e_commission_rule : gas_cylinder_id
e_customer_account ||--o{ e_customer_account_entry : account_id
e_cash_movement |o--o{ e_customer_account_entry : cash_movement_id
e_delivery |o--o{ e_customer_account_entry : collected_by_delivery_id
e_user |o--o{ e_customer_account_entry : created_by_user_id
e_order |o--o{ e_customer_account_entry : order_id
e_user |o--o{ e_driver_liquidation : approved_by_user_id
e_cash_movement |o--o{ e_driver_liquidation : cash_movement_id
e_user ||--o{ e_driver_liquidation : created_by_user_id
e_employee ||--o{ e_driver_liquidation : employee_id
e_user |o--o{ e_driver_liquidation : paid_by_user_id
e_user |o--o{ e_commission_entry : created_by_user_id
e_delivery |o--o{ e_commission_entry : delivery_id
e_employee ||--o{ e_commission_entry : employee_id
e_driver_liquidation |o--o{ e_commission_entry : liquidation_id
e_order |o--o{ e_commission_entry : order_id
e_commission_rule |o--o{ e_commission_entry : rule_id
e_customer_account ||--o{ e_customer_account_allocation : account_id
e_customer_account_entry ||--o{ e_customer_account_allocation : credit_entry_id
e_customer_account_entry ||--o{ e_customer_account_allocation : debit_entry_id
e_user |o--o{ e_driver_settlement : approved_by_user_id
e_cash_movement |o--o{ e_driver_settlement : cash_movement_id
e_delivery ||--o{ e_driver_settlement : delivery_id
e_cash_box |o--o{ e_driver_settlement : destination_cash_box_id
e_user |o--o{ e_driver_settlement : submitted_by_user_id
e_truck_load |o--o{ e_driver_settlement : truck_load_id
e_customer_account_entry ||--o| e_driver_settlement_collection : entry_id
e_driver_settlement ||--o{ e_driver_settlement_collection : settlement_id
e_cash_category ||--o{ e_driver_settlement_expense : category_id
e_driver_settlement ||--o{ e_driver_settlement_expense : settlement_id
e_order ||--o| e_driver_settlement_order : order_id
e_driver_settlement ||--o{ e_driver_settlement_order : settlement_id

legend bottom
|<#F1F1F1> **tabla de otro contexto** | solo se muestra su nombre; sus columnas están en su propio contexto |
|<#FFFFFF> **distributor_id** | la tabla pertenece a una distribuidora (FK a distributor); la línea no se dibuja |
endlegend
note as N
  Los nombres reflejan la base real: conviven camelCase (paymentMethod, createdAt, isActive) y snake_case
  (scheduled_date, delivery_mode) porque las columnas más antiguas se crearon así y las posteriores siguieron
  otra convención; la tabla claims está en plural y el resto en singular.
end note
@enduml