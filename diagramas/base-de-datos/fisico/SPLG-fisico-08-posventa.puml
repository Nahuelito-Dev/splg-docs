@startuml
title Modelo físico — Posventa
!include ../../estilo-vp.iuml
skinparam entity<<ajena>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}
skinparam entity<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #FFF6D9
}

hide circle
skinparam linetype polyline

entity "claims" as e_claims {
  {field} **claim_id** : uuid * <<PK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //order_id// : uuid * <<FK>>
  {field} //customer_id// : uuid * <<FK>>
  {field} reason : varchar *
  {field} description : text *
  {field} photoUrl : varchar
  {field} status : claims_status_enum *
  {field} resolutionNote : text
  {field} createdAt : timestamptz *
  {field} photo_key : varchar(512)
}
entity "incident" as e_incident {
  {field} **incident_id** : uuid * <<PK>>
  {field} //order_id// : uuid * <<FK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //reported_by// : uuid * <<FK>>
  {field} type : incident_type_enum *
  {field} description : text *
  {field} photo_url : varchar
  {field} status : incident_status_enum *
  {field} resolution_note : text
  {field} createdAt : timestamptz *
  {field} resolvedAt : timestamptz
  {field} moment : incident_moment_enum
  {field} photo_key : varchar(512)
}
entity "rating" as e_rating {
  {field} **rating_id** : uuid * <<PK>>
  {field} //order_id// : uuid * <<FK>>
  {field} //distributor_id// : uuid * <<FK>>
  {field} //from_user_id// : uuid * <<FK>>
  {field} //to_user_id// : uuid * <<FK>>
  {field} from_role : rating_from_role_enum *
  {field} stars : integer *
  {field} comment : text
  {field} createdAt : timestamptz *
  {field} hidden : boolean *
  {field} hidden_reason : text
  {field} hidden_at : timestamptz
  {field} //hidden_by_user_id// : uuid <<FK>>
}
entity "user" as e_user #F1F1F1 {
}
entity "order" as e_order #F1F1F1 {
}

e_user ||--o{ e_claims : customer_id
e_order ||--o{ e_claims : order_id
e_order ||--o{ e_incident : order_id
e_user ||--o{ e_incident : reported_by
e_user ||--o{ e_rating : from_user_id
e_user |o--o{ e_rating : hidden_by_user_id
e_order ||--o{ e_rating : order_id
e_user ||--o{ e_rating : to_user_id

legend bottom
|<#F1F1F1> **tabla de otro contexto** | solo se muestra su nombre; sus columnas están en su propio contexto |
|<#FFFFFF> **distributor_id** | la tabla pertenece a una distribuidora (FK a distributor); la línea no se dibuja |
endlegend
note as N
  Los nombres reflejan la base real: conviven camelCase (paymentMethod, createdAt, isActive) y snake_case
  (scheduled_date, delivery_mode) porque las columnas más antiguas se crearon así y las posteriores siguieron
  otra convención; la tabla claims está en plural y el resto en singular.
end note
@enduml