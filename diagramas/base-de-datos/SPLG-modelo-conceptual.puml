@startuml
title Modelo Conceptual — SPLG\nEntidades del negocio por contexto
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam dpi 150
skinparam linetype ortho
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 12
}
skinparam class<<propuesto>> {
  BorderColor #1F5E8C
  BackgroundColor #E4EDF4
}
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #2C4257

hide circle
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam package {
  BorderColor #2C4257
  FontSize 13
}

package "Organización y acceso" {
entity "Distribuidora" as c_distributor {
  {field} razón social
  {field} CUIT
  {field} estado
}
entity "Rol" as c_role {
  {field} tipo
}
entity "Usuario" as c_user {
  {field} nombre
  {field} correo
  {field} teléfono
}
entity "Administrador" as c_admin {
}
entity "Asiento de auditoría" as c_audit_log {
  {field} rol
  {field} operación
  {field} recurso
  {field} aplicación
  {field} resultado
  {field} cambios
  {field} fecha
}
entity "Configuración de módulo" as c_module_config {
  {field} módulo
  {field} parámetros
}
}
package "Clientes" {
entity "Cliente" as c_customer {
  {field} ubicación
  {field} validado
  {field} consumo mensual declarado
  {field} garrafa habitual
  {field} días de aviso
  {field} próxima recompra estimada
}
entity "Dirección de entrega" as c_user_address {
  {field} calle
  {field} ciudad
  {field} predeterminada
  {field} piso
  {field} departamento
  {field} punto
  {field} precisión
}
entity "Invitación de recompra" as c_repurchase_invitation {
  {field} agotamiento estimado
  {field} pedido sugerido
  {field} estado
  {field} vence
}
}
package "Catálogo e inventario de envases" {
entity "Tipo de garrafa" as c_gas_cylinder {
  {field} tipo
  {field} peso en kg
  {field} precio
  {field} stock
}
entity "Promoción" as c_gas_cylinder_promotion {
  {field} desde cantidad
  {field} descuento
}
entity "Envase" as c_cylinder {
  {field} número de serie
  {field} estado
  {field} depósito
  {field} fecha de fabricación
  {field} última revisión
  {field} vencimiento
}
entity "Revisión de envase" as c_cylinder_inspection {
  {field} fecha
  {field} resultado
  {field} próxima revisión
  {field} observaciones
}
entity "Movimiento de envase" as c_cylinder_movement {
  {field} desde
  {field} hacia
  {field} fecha
}
entity "Caso de recupero" as c_cylinder_recovery_case {
  {field} entregado el
  {field} depósito
  {field} escalón
  {field} estado
  {field} resolución
}
entity "Aviso de recupero" as c_cylinder_recovery_notice {
  {field} escalón
  {field} tipo
  {field} enviado
  {field} vence
}
}
package "Venta y pedidos" {
entity "Zona de cobertura" as c_coverage_zone {
  {field} nombre
  {field} área
  {field} recargo
  {field} tipo de recargo
  {field} etiqueta
  {field} color
  {field} vigente hasta
}
entity "Franja horaria" as c_time_slot {
  {field} nombre
  {field} desde
  {field} hasta
  {field} cupo
}
entity "Carrito" as c_cart {
  {field} última modificación
}
entity "Ítem del carrito" as c_cart_item {
  {field} cantidad
  {field} precio unitario
}
entity "Pedido" as c_order {
  {field} estado
  {field} total
  {field} método de pago
  {field} fecha agendada
  {field} quién recibe
  {field} documento de quien recibe
  {field} vínculo
  {field} modalidad de entrega
}
entity "Cambio de dirección" as c_order_address_change {
  {field} fecha
  {field} motivo
}
entity "Ítem del pedido" as c_order_item {
  {field} cantidad
  {field} precio unitario
  {field} subtotal
}
entity "Cambio de estado del pedido" as c_order_status_history {
  {field} desde
  {field} hacia
  {field} motivo
  {field} fecha
}
}
package "Pagos" {
entity "Pago" as c_payment {
  {field} importe
  {field} pasarela
  {field} estado
}
}
package "Despacho y logística" {
entity "Lote de recorrido" as c_route_batch {
  {field} estado
  {field} peso total
}
entity "Oferta de despacho" as c_order_dispatch_offer {
  {field} estado
  {field} vence
}
entity "Oferta de lote" as c_route_batch_offer {
  {field} estado
  {field} vence
}
entity "Parada del lote" as c_route_batch_stop {
  {field} orden
}
}
package "Flota y choferes" {
entity "Plan de mantenimiento" as c_maintenance_plan {
  {field} nombre
  {field} sobre qué
  {field} disparo
  {field} cada cuántos km
  {field} cada cuántos meses
  {field} anticipación
  {field} criticidad
}
entity "Vehículo" as c_car {
  {field} patente
  {field} tipo
  {field} capacidad
  {field} tara
  {field} carga máxima
  {field} kilometraje
  {field} estado en la flota
}
entity "Chofer" as c_delivery {
  {field} calificación
  {field} disponible
  {field} posición
  {field} saldo
}
entity "Tarea de mantenimiento" as c_maintenance_task {
  {field} estado
  {field} vence
  {field} vencimiento proyectado
  {field} programada para
  {field} realizada
  {field} costo
  {field} prestador
  {field} número
}
entity "Registro de uso del vehículo" as c_vehicle_usage_log {
  {field} día
  {field} kilómetros
  {field} pedidos
}
entity "Propuesta de ventana de taller" as c_maintenance_window_proposal {
  {field} desde
  {field} hasta
  {field} estado
  {field} vence
}
}
package "Posventa" {
entity "Reclamo" as c_claims {
  {field} motivo
  {field} estado
}
entity "Incidencia" as c_incident {
  {field} tipo
  {field} estado
  {field} momento
}
entity "Calificación" as c_rating {
  {field} puntaje
  {field} comentario
}
}

c_role |o--o{ c_user
c_user ||--o{ c_admin
c_user |o--o{ c_audit_log
c_user ||--o{ c_car
c_user ||--o{ c_cart
c_gas_cylinder |o--o{ c_customer
c_user ||--|| c_customer
c_user ||--|| c_delivery
c_gas_cylinder ||--o{ c_gas_cylinder_promotion
c_user |o--o{ c_module_config
c_user ||--o{ c_user_address
c_cart ||--o{ c_cart_item
c_gas_cylinder ||--o{ c_cart_item
c_car |o--o{ c_maintenance_task
c_delivery |o--o{ c_maintenance_task
c_maintenance_plan ||--o{ c_maintenance_task
c_user_address ||--o{ c_order
c_user ||--o{ c_order
c_delivery |o--o{ c_order
c_time_slot |o--o{ c_order
c_delivery |o--o{ c_route_batch
c_car ||--o{ c_vehicle_usage_log
c_user ||--o{ c_claims
c_order ||--o{ c_claims
c_user |o--o{ c_cylinder
c_order |o--o{ c_cylinder
c_gas_cylinder |o--o{ c_cylinder
c_order ||--o{ c_incident
c_user ||--o{ c_incident
c_delivery ||--o{ c_maintenance_window_proposal
c_maintenance_task ||--o{ c_maintenance_window_proposal
c_user ||--o{ c_order_address_change
c_user_address ||--o{ c_order_address_change
c_order ||--o{ c_order_address_change
c_user ||--o{ c_order_dispatch_offer
c_order ||--o{ c_order_dispatch_offer
c_gas_cylinder ||--o{ c_order_item
c_order ||--o{ c_order_item
c_user |o--o{ c_order_status_history
c_order ||--o{ c_order_status_history
c_order ||--o{ c_payment
c_user ||--o{ c_rating
c_order ||--o{ c_rating
c_user_address |o--o{ c_repurchase_invitation
c_order |o--o{ c_repurchase_invitation
c_user ||--o{ c_repurchase_invitation
c_route_batch ||--o{ c_route_batch_offer
c_delivery ||--o{ c_route_batch_offer
c_route_batch ||--o{ c_route_batch_stop
c_order ||--o{ c_route_batch_stop
c_cylinder ||--o{ c_cylinder_inspection
c_user |o--o{ c_cylinder_movement
c_cylinder ||--o{ c_cylinder_movement
c_order |o--o{ c_cylinder_movement
c_cylinder ||--o{ c_cylinder_recovery_case
c_user |o--o{ c_cylinder_recovery_case
c_cylinder_recovery_case ||--o{ c_cylinder_recovery_notice

legend bottom
|<#FFFFFF> **implementado** | tabla o atributo que ya existe en la base |
|<#FFFFFF> **distribuidora** | las entidades de una distribuidora (multi-tenant) se relacionan con ella: esas relaciones no se dibujan. Usuario, Cliente y Dirección no pertenecen a ninguna: un cliente le compra a varias y su pertenencia sale de sus pedidos |
endlegend
@enduml