@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam packageStyle rectangle
hide circle
hide methods
hide empty members

class Producto {
  tipo
  peso en kilos
  precio
  stock
  activo
  costo promedio
  déficit de reservas
}
class Promocion {
  cantidad
  descuento
}
class Envase {
  número de serie
  estado
  monto del depósito
  /vencimiento
}
class MovimientoEnvase {
  desde
  hacia
  fecha
}
class RevisionEnvase {
  fecha
  resultado
  próxima revisión
}
class CasoRecupero {
  escalón
  depósito comprometido
  estado
  resolución
}
class AvisoRecupero {
  escalón
  tipo
  vence
}
class Cliente <<referencia>>
class Pedido <<referencia>>
class Usuario <<referencia>>
class Distribuidora <<referencia>>


Distribuidora "1" -- "0..*" Producto : comercializa >
Distribuidora "1" -- "0..*" Envase : posee >
Cliente "0..*" -- "0..1" Producto : usa habitualmente >
Producto "1" *-- "0..*" Promocion : ofrece >
Producto "0..1" -- "0..*" Envase : describe >
Envase "1" *-- "0..*" MovimientoEnvase : registra >
Envase "1" *-- "0..*" RevisionEnvase : se somete a >
Pedido "0..1" -- "0..*" MovimientoEnvase : origina >
Usuario "0..1" -- "0..*" MovimientoEnvase : ejecuta >
Cliente "0..1" -- "0..*" Envase : tiene en su poder >
Pedido "0..1" -- "0..*" Envase : despacha >
Envase "1" -- "0..*" CasoRecupero : motiva >
CasoRecupero "0..*" -- "1" Cliente : se abre contra >
Usuario "0..1" -- "0..*" CasoRecupero : resuelve >
CasoRecupero "1" *-- "0..*" AvisoRecupero : emite >

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
