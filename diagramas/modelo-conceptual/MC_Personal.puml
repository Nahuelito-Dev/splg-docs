@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam packageStyle rectangle
hide circle
hide methods
hide empty members

class PuestoDeTrabajo {
  nombre
  categoría
  activo
}
class Empleado {
  legajo
  nombre
  apellido
  documento
  CUIL
  fecha de nacimiento
  domicilio
  teléfono
  contacto de emergencia
  fecha de ingreso
  fecha de egreso
  motivo de egreso
  modalidad de contratación
  estado
}
class JornadaDeTrabajo {
  día
  ingreso
  egreso
  origen
  observación
}
class LicenciaLaboral {
  tipo
  desde
  hasta
  /días
  estado
  motivo
  motivo de rechazo
  resuelta el
}
class Adjunto {
  nombre original
  tipo de archivo
  etiqueta
  fecha de carga
}
class Distribuidora #F1F1F1;line:8A97A3;text:55616C
class Usuario #F1F1F1;line:8A97A3;text:55616C
class TareaMantenimiento #F1F1F1;line:8A97A3;text:55616C


Distribuidora "1" -- "0..*" Empleado : emplea >
Distribuidora "1" *-- "0..*" PuestoDeTrabajo : define >
Empleado "0..*" -- "1" PuestoDeTrabajo : ocupa >
Empleado "0..1" -- "0..1" Usuario : accede con >
Empleado "1" *-- "0..*" JornadaDeTrabajo : registra >
Empleado "1" *-- "0..*" LicenciaLaboral : solicita >
Usuario "0..1" -- "0..*" LicenciaLaboral : resuelve >
Empleado "1" *-- "0..*" Adjunto : conserva >
TareaMantenimiento "0..*" -- "0..1" Empleado : habilita >

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
