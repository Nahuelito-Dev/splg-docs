@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide methods
hide empty members

class Calificacion {
  puntaje
  comentario
}
class Incidencia {
  tipo
  momento
  descripción
  estado
  resolución
  fotografía
}
class Reclamo {
  motivo
  descripción
  estado
  resolución
  fotografía
}
class Usuario <<referencia>>
class Pedido <<referencia>>
class Cliente <<referencia>>


Pedido "1" -- "0..*" Reclamo : origina >
Cliente "1" -- "0..*" Reclamo : presenta >
Pedido "1" -- "0..*" Incidencia : origina >
Usuario "1" -- "0..*" Incidencia : reporta >
Pedido "1" -- "0..2" Calificacion : recibe >
Usuario "1" -- "0..*" Calificacion : emite >
Usuario "1" -- "0..*" Calificacion : recibe >

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml
