@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam packageStyle rectangle
hide circle
hide methods
hide empty members

class Calificacion {
  puntaje
  comentario
}
class Incidencia {
  tipo
  momento
  descripción
  estado
  resolución
  fotografía
}
class Reclamo {
  motivo
  descripción
  estado
  resolución
  fotografía
}
class Usuario #F1F1F1;line:8A97A3;text:55616C
class Pedido #F1F1F1;line:8A97A3;text:55616C
class Cliente #F1F1F1;line:8A97A3;text:55616C


Pedido "1" -- "0..*" Reclamo : origina >
Cliente "1" -- "0..*" Reclamo : presenta >
Pedido "1" -- "0..*" Incidencia : origina >
Usuario "1" -- "0..*" Incidencia : reporta >
Pedido "1" -- "0..2" Calificacion : recibe >
Usuario "1" -- "0..*" Calificacion : emite >
Usuario "1" -- "0..*" Calificacion : recibe >

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
