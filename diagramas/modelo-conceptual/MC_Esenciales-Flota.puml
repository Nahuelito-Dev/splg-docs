@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam packageStyle rectangle
hide circle
hide methods
hide empty members

class Chofer {
  disponible
  habilitado
  validado
  /calificación
}
class Vehiculo {
  patente
  tipo
  carga máxima
  kilometraje
  estado en la flota
  tipo de combustible
  capacidad del tanque
}
class AsignacionVehiculo {
  asignado el
  liberado el
  nota
}
class PlanMantenimiento {
  nombre
  disparo
  intervalo
  anticipación
  criticidad
  documento que controla
  aplica a
}
class TareaMantenimiento {
  estado
  vence
  vencimiento proyectado
  prestador
  número
  costo
  vigente desde
  detalle
}
class PropuestaVentanaTaller {
  desde
  hasta
}
class UbicacionGPS {
  latitud
  longitud
}
class RegistroUsoVehiculo {
  día
  kilómetros
  pedidos
}
class Usuario #F1F1F1;line:8A97A3;text:55616C
class Distribuidora #F1F1F1;line:8A97A3;text:55616C

Usuario <|-- Chofer : {overlapping, incomplete}

Distribuidora "1" -- "0..*" Chofer : emplea >
Chofer "1" -- "0..*" Vehiculo : tiene registrado >
Chofer "0..*" -- "0..*" Vehiculo : usa >
Chofer "1" -- "0..1" UbicacionGPS : se ubica en >
PlanMantenimiento "1" -- "0..*" TareaMantenimiento : genera >
TareaMantenimiento "0..*" -- "0..1" Vehiculo : habilita >
TareaMantenimiento "0..*" -- "0..1" Chofer : habilita >
TareaMantenimiento "1" *-- "0..*" PropuestaVentanaTaller : origina >
PropuestaVentanaTaller "0..*" -- "1" Chofer : se dirige a >
Vehiculo "1" *-- "0..*" RegistroUsoVehiculo : acumula >
(Chofer, Vehiculo) .. AsignacionVehiculo

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
