@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide methods
hide empty members

class Empleado {
  legajo
  nombre
  apellido
  documento
  CUIL
  fecha de nacimiento
  domicilio
  teléfono
  contacto de emergencia
  fecha de ingreso
  fecha de egreso
  motivo de egreso
  modalidad de contratación
  estado
}
class ReglaComision {
  base
  valor
  vigente desde
  vigente hasta
  activa
}
class AsientoComision {
  tipo
  importe
  fecha
  descripción
}
class LiquidacionComisiones {
  número
  período desde
  período hasta
  bruto
  deducciones
  neto
  estado
  aprobada el
  pagada el
}
class Chofer <<referencia>>
class Producto <<referencia>>
class Pedido <<referencia>>
class MovimientoDeCaja <<referencia>>
class Distribuidora <<referencia>>
class RendicionChofer <<referencia>>


Distribuidora "1" -- "0..*" Empleado : emplea >
Distribuidora "1" *-- "0..*" ReglaComision : define >
ReglaComision "0..*" -- "0..1" Empleado : se aplica a >
ReglaComision "0..*" -- "0..1" Producto : se aplica a >
Empleado "1" *-- "0..*" AsientoComision : devenga >
Empleado "1" *-- "0..*" LiquidacionComisiones : percibe >
Empleado "0..1" -- "0..1" Chofer : actúa como >
AsientoComision "0..*" -- "0..1" Pedido : corresponde a >
ReglaComision "0..1" -- "0..*" AsientoComision : determina >
LiquidacionComisiones "0..1" -- "0..*" AsientoComision : incluye >
RendicionChofer "0..1" -- "0..*" AsientoComision : origina >
LiquidacionComisiones "0..1" -- "0..1" MovimientoDeCaja : se paga con >

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml
