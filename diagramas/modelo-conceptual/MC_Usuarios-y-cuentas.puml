@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide methods
hide empty members

class Distribuidora {
  nombre
  razón social
  CUIT
  estado
}
class Usuario {
  nombre
  correo
  teléfono
  bloqueado
}
class Rol {
  tipo
}
class Administrador
class ConfiguracionModulo {
  módulo
  parámetros
}
class AsientoAuditoria {
  operación
  recurso
  aplicación
  resultado
  cambios
  fecha
}
class Cliente {
  consumo mensual declarado
  días de aviso
}
class DireccionEntrega {
  calle y altura
  piso y departamento
  punto
  precisión
  predeterminada
}
class InvitacionRecompra {
  agotamiento estimado
}
class ItemSugerido {
  cantidad
}
class Chofer <<referencia>>
class Producto <<referencia>>
class Pedido <<referencia>>

Usuario <|-- Cliente : {overlapping, incomplete}
Usuario <|-- Chofer
Usuario <|-- Administrador

Usuario "0..*" -- "0..1" Rol : tiene asignado >
Distribuidora "1" -- "0..*" Chofer : emplea >
Distribuidora "0..1" -- "0..*" Administrador : emplea >
Distribuidora "1" -- "0..*" Producto : comercializa >
Distribuidora "1" -- "0..*" Pedido : gestiona >
Distribuidora "1" *-- "0..*" ConfiguracionModulo : parametriza >
Usuario "0..1" -- "0..*" AsientoAuditoria : origina >
Cliente "1" *-- "0..*" DireccionEntrega : registra >
Cliente "1" -- "0..*" Pedido : realiza >
Cliente "1" -- "0..*" InvitacionRecompra : recibe >
Cliente "0..*" -- "0..1" Producto : usa habitualmente >
InvitacionRecompra "0..1" -- "0..1" Pedido : se convierte en >
InvitacionRecompra "1" *-- "1..*" ItemSugerido : sugiere >
InvitacionRecompra "0..*" -- "0..1" DireccionEntrega : sugiere entregar en >
ItemSugerido "0..*" -- "1" Producto : corresponde a >
Pedido "0..*" -- "1" DireccionEntrega : se entrega en >

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml
