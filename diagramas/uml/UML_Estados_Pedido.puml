@startuml
title Diagrama de estados — Pedido
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam state {
  BorderColor #2C4257
  BackgroundColor #F4F7FA
  StartColor #2C4257
  EndColor #2C4257
  AttributeFontSize 12
}
skinparam ArrowFontSize 12
skinparam NoteBackgroundColor #FBF7E6
skinparam NoteBorderColor #7A7340
hide empty description
state "Reservado\n(RESERVED)" as RESERVED
state "Pendiente de chofer\n(PENDING)" as PENDING
state "Aceptado\n(ACCEPTED)" as ACCEPTED
state "En camino\n(ON_THE_WAY)" as ON_THE_WAY
state "Entregado\n(DELIVERED)" as DELIVERED
state "Cancelado\n(CANCELLED)" as CANCELLED

[*] --> PENDING : crearPedido() [no es una reserva]
[*] --> RESERVED : crearPedido() [es una reserva con fecha agendada]
RESERVED --> PENDING : activarReserva() [seña abonada y fecha agendada\nalcanzada]
RESERVED --> CANCELLED : cancelarPedido()\no vencer seña [seña sin abonar y\nplazo de la seña vencido]
PENDING --> ACCEPTED : aceptarPedido() o\nasignarChoferAPedido() [chofer habilitado,\nvalidado y de la misma distribuidora]
PENDING --> CANCELLED : cancelarPedido()\no vencer pago [pago en línea sin acreditar\ndentro del plazo]
ACCEPTED --> ON_THE_WAY : marcarEnCamino() [pedido del chofer]
ACCEPTED --> PENDING : liberarPedido() [chofer o administrador]
ACCEPTED --> CANCELLED : cancelarPedido() [cliente o administrador]
ON_THE_WAY --> DELIVERED : confirmarEntrega() [chofer asignado]
ON_THE_WAY --> DELIVERED : confirmarEntregaConCodigo() [código de entrega válido]
ON_THE_WAY --> PENDING : liberarPedido() [chofer o administrador]
ON_THE_WAY --> CANCELLED : cancelarPedido() [administrador;\nel cliente recibe rechazo]
DELIVERED --> [*]
CANCELLED --> [*]

note right of DELIVERED
  Estados finales: no admiten transiciones.
  Repetir el estado actual es una operación sin efecto.
end note
@enduml
