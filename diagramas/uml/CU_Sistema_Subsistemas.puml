@startuml
title Subsistemas del Proyecto — SPLG (18 subsistemas · 149 casos de uso)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 25
skinparam ranksep 55
skinparam packageStyle rectangle

left to right direction

rectangle "SS-10 Multi-Distribuidora — restricción transversal:\ntodo subsistema de negocio opera acotado a la distribuidora del usuario" as R10 #back:F3F1E4;line:7A7340 {
