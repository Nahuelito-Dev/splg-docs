    rectangle "**SS-04**\nSeguimiento en Tiempo Real\n(8 casos)" as MSS04 #back:FBF2DE;line:8A7326
    rectangle "**SS-05**\nReclamos\n(3 casos)" as MSS05 #back:FAE8E3;line:9C5A46
    rectangle "**SS-06**\nReportes y Dashboard\n(5 casos)" as MSS06 #back:E4F2F1;line:3E7C79
    rectangle "**SS-07**\nGestión de Choferes y Vehículos\n(24 casos)" as MSS07 #back:F0EEF9;line:5A5896
