@startuml
title Diagrama de actividad — Despacho por proximidad (M1)
!include ../estilo-vp.iuml
skinparam swimlane {
  BorderColor #6B7683
  TitleFontStyle bold
}
|Sistema|
start
:Pedido en estado Pendiente sin chofer asignado;
while (¿el pedido sigue pendiente y sin chofer?) is (sí)
  if (¿tiene punto de entrega?) then (sí)
  else (no)
    :Sin oferta;
    stop
  endif
  :radio := primer paso de la distribuidora;
  repeat
    :Buscar choferes cercanos en Redis\n(GEORADIUS sobre el radio);
    :Quedarse con los elegibles: habilitados, validados,\nde la distribuidora y sin bloqueo de flota;
    :Descartar los ya contactados para este pedido;
    backward :radio := paso siguiente;
  repeat while (¿sin candidato y quedan pasos?) is (sí) not (no)
  if (¿hay candidato?) then (sí)
  else (no)
    :Sin oferta; aviso al panel\n(order:no-drivers);\nel ciclo de la distribuidora lo reintenta;
    stop
  endif
  :Crear la oferta (ofrecida, con la ventana\nde la distribuidora, 30 s por omisión);
  :Notificar al chofer por WebSocket\ny por notificación push;
  switch (¿respuesta del chofer?)
  case ([acepta])
    |Chofer|
    :aceptarPedido();
    |Sistema|
    :Oferta aceptada;\npedido aceptado;
  case ([rechaza])
    |Chofer|
    :rechazarOferta();
    |Sistema|
    :Oferta rechazada;
  case ([no responde en la ventana])
    :Oferta vencida\n(proceso de vencimiento, ciclo de 15 s);
  endswitch
endwhile (no)
:Generar el código de entrega\ny avisar al cliente;
stop
note right
  Cada vuelta del ciclo externo ofrece el pedido
  al siguiente candidato, que nunca es un
  chofer ya contactado para ese pedido.
end note
@enduml
