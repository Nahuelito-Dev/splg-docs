@startuml
title SS-03 — Despacho y Asignación (7 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<pendiente>> #9C4436
  BackgroundColor<<pendiente>> #F6E4E1
}

actor "Chofer\n(ACT-02)" as A02
actor "Administrador\n(ACT-03)" as A03
actor "Sistema Automático\n(ACT-04)" as A04

rectangle "SS-03 Despacho y Asignación" {
  usecase "CU-012\nAsignar Chofer Manualmente" as U012 #back:FFFFFF;line:7B4B8A
  usecase "CU-013\nAsignar Pedido Automáticamente\npor Proximidad" as U013 #back:FFFFFF;line:7B4B8A
  usecase "CU-014\nReintentar Asignación con\nRadio Expandido (Cron)" as U014 #back:FFFFFF;line:7B4B8A
  usecase "CU-015\nAceptar Pedido" as U015 #back:FFFFFF;line:7B4B8A
  usecase "CU-016\nRechazar / Ignorar Pedido" as U016 #back:FFFFFF;line:7B4B8A
  usecase "CU-107\nAgrupar pedidos por recorrido" as U107 #back:FFFFFF;line:7B4B8A
  usecase "CU-149\nDespachar un Pedido Express a\nun Chofer en Moto" as U149 <<pendiente>> #back:FFFFFF;line:7B4B8A
}

A02 -[#2E7D46]-> U015
A02 -[#2E7D46]-> U016
A02 -[#2E7D46]-> U107
A03 -[#8C4A9E]-> U012
A04 -[#8A6D1F]-> U013
A04 -[#8A6D1F]-> U014
A04 -[#8A6D1F]-> U107
A04 -[#8A6D1F]-> U149

' escribir sobre algo exige leerlo antes: la busqueda entra por <<include>>
U149 ..> U015 : <<include>>

@enduml