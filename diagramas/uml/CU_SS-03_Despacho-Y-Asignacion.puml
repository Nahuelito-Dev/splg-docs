@startuml
title SS-03 — Despacho y Asignación (8 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<planificado>> #9C4436
  BackgroundColor<<planificado>> #F6E4E1
  BorderColor<<factorizado>> #6B7683
  BackgroundColor<<factorizado>> #F2F4F6
}

actor "Chofer\n(ACT-02)" as A02
actor "Administrador\n(ACT-03)" as A03
actor "Sistema Automático\n(ACT-04)" as A04
actor "Administrador General\n(ACT-05)" as A05
actor "Firebase\n(ACT-07)" as A07 <<sistema externo>>

rectangle "SS-03 Despacho y Asignación" {
  usecase "CU-012\nAsignar Chofer Manualmente" as U012 #back:FFFFFF;line:7B4B8A
  usecase "CU-013\nAsignar Pedido Automáticamente\npor Proximidad" as U013 #back:FFFFFF;line:7B4B8A
  usecase "CU-014\nReintentar Asignación con\nRadio Expandido (Cron)" as U014 #back:FFFFFF;line:7B4B8A
  usecase "CU-015\nAceptar Pedido" as U015 #back:FFFFFF;line:7B4B8A
  usecase "CU-016\nRechazar / Ignorar Pedido" as U016 #back:FFFFFF;line:7B4B8A
  usecase "CU-107\nAgrupar pedidos por recorrido" as U107 <<planificado>> #back:FFFFFF;line:7B4B8A
  usecase "CU-149\nDespachar un Pedido Express a\nun Chofer en Moto" as U149 <<planificado>> #back:FFFFFF;line:7B4B8A
  usecase "CU-171\nConfigurar los Parámetros de\nDespacho de la Distribuidora" as U171 <<planificado>> #back:FFFFFF;line:7B4B8A
  usecase "Notificar Cliente" as F_AVISO <<factorizado>> #back:FFFFFF;line:7B4B8A
}

rectangle "Casos de uso de otros subsistemas\n(sólo como referencia)" as OTROS #back:FFFFFF;line:6B7683;line.dashed {
  usecase "CU-246\nVerificar la Habilitación\nLaboral del Chofer\n(SS-19)" as U246 <<planificado>> #back:FFFFFF;line:6B7683
  usecase "CU-248\nVerificar la Carga de Camión\nAbierta del Chofer\n(SS-08)" as U248 <<planificado>> #back:FFFFFF;line:6B7683
}

A02 -[#2E7D46]- U015
A02 -[#2E7D46]- U016
A02 -[#2E7D46]- U107
A03 -[#8C4A9E]- U012
A03 -[#8C4A9E]- U171
A04 -[#8A6D1F]- U013
A04 -[#8A6D1F]- U014
A04 -[#8A6D1F]- U107
A04 -[#8A6D1F]- U149
U013 -[#6B7683]- A07
U014 -[#6B7683]- A07
U015 -[#6B7683]- A07
U016 -[#6B7683]- A07
A05 -right-|> A03

' escribir sobre algo exige leerlo antes: la busqueda entra por <<include>>
U149 ..> U015 : <<include>>
U015 ..> F_AVISO : <<include>>
U012 ..> U246 : <<include>>
U013 ..> U246 : <<include>>
U015 ..> U246 : <<include>>
U012 ..> U248 : <<include>>
U013 ..> U248 : <<include>>
U015 ..> U248 : <<include>>

' <<extend>>: comportamiento opcional. La flecha va de la extension al caso base.
U014 ..> U013 : <<extend>>\n(punto de extensión:\nno hay choferes disponibles en el\nradio)

@enduml