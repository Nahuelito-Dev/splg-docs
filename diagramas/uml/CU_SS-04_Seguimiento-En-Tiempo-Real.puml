@startuml
title SS-04 — Seguimiento en Tiempo Real (8 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<planificado>> #9C4436
  BackgroundColor<<planificado>> #F6E4E1
  BorderColor<<factorizado>> #6B7683
  BackgroundColor<<factorizado>> #F2F4F6
}

actor "Cliente\n(ACT-01)" as A01
actor "Chofer\n(ACT-02)" as A02
actor "Administrador\n(ACT-03)" as A03
actor "Administrador General\n(ACT-05)" as A05

rectangle "SS-04 Seguimiento en Tiempo Real" {
  usecase "CU-017\nActualizar Ubicación GPS del\nChofer" as U017 #back:FFFFFF;line:8A7326
  usecase "CU-018\nMarcar Pedido "En Camino"" as U018 #back:FFFFFF;line:8A7326
  usecase "CU-019\nAvisar Llegada al Cliente" as U019 #back:FFFFFF;line:8A7326
  usecase "CU-020\nConfirmar Entrega" as U020 #back:FFFFFF;line:8A7326
  usecase "CU-021\nRecibir Notificaciones en\nTiempo Real" as U021 #back:FFFFFF;line:8A7326
  usecase "CU-022\nActivar / Desactivar\nDisponibilidad (Chofer)" as U022 #back:FFFFFF;line:8A7326
  usecase "CU-078\nObtener el Código de Entrega\n(QR del chofer)" as U078 #back:FFFFFF;line:8A7326
  usecase "CU-079\nConfirmar Entrega Escaneando\nel QR (cliente)" as U079 #back:FFFFFF;line:8A7326
  usecase "Notificar Cliente" as F_AVISO <<factorizado>> #back:FFFFFF;line:8A7326
}

A01 -[#1F6F8B]- U021
A01 -[#1F6F8B]- U079
A02 -[#2E7D46]- U017
A02 -[#2E7D46]- U018
A02 -[#2E7D46]- U019
A02 -[#2E7D46]- U020
A02 -[#2E7D46]- U022
A02 -[#2E7D46]- U078
A03 -[#8C4A9E]- U078
A03 -[#8C4A9E]- U079
A05 --|> A03

' escribir sobre algo exige leerlo antes: la busqueda entra por <<include>>
U018 ..> F_AVISO : <<include>>
U020 ..> F_AVISO : <<include>>

' <<extend>>: comportamiento opcional. La flecha va de la extension al caso base.
U019 ..> U018 : <<extend>>
note on link
  Punto de extensión: el chofer se encuentra cerca del destino
end note

@enduml