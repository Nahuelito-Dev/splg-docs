@startuml
title SS-20 — Compras (16 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<planificado>> #9C4436
  BackgroundColor<<planificado>> #F6E4E1
  BorderColor<<factorizado>> #6B7683
  BackgroundColor<<factorizado>> #F2F4F6
}

actor "Administrador\n(ACT-03)" as A03
actor "Administrador General\n(ACT-05)" as A05

rectangle "SS-20 Compras" {
  usecase "CU-214\nConsultar los Proveedores" as U214 #back:FFFFFF;line:55657A
  usecase "CU-215\nEmitir una Orden de Compra" as U215 #back:FFFFFF;line:55657A
  usecase "CU-216\nCancelar una Orden de Compra" as U216 #back:FFFFFF;line:55657A
  usecase "CU-217\nRegistrar la Recepción de una\nCompra" as U217 #back:FFFFFF;line:55657A
  usecase "CU-261\nRegistrar un Proveedor" as U261 #back:FFFFFF;line:55657A
  usecase "CU-262\nModificar un Proveedor" as U262 #back:FFFFFF;line:55657A
  usecase "CU-263\nDar de Baja un Proveedor" as U263 #back:FFFFFF;line:55657A
  usecase "CU-280\nAnular una Recepción de Compra" as U280 #back:FFFFFF;line:55657A
  usecase "CU-281\nMarcar el Pago de una\nRecepción" as U281 #back:FFFFFF;line:55657A
  usecase "CU-282\nCerrar una Orden de Compra con\nFaltante" as U282 #back:FFFFFF;line:55657A
  usecase "CU-283\nConsultar las Órdenes de\nCompra" as U283 #back:FFFFFF;line:55657A
  usecase "CU-284\nConsultar las Recepciones de\nCompra" as U284 #back:FFFFFF;line:55657A
  usecase "CU-285\nConsultar el Costo Promedio de\nlas Garrafas" as U285 #back:FFFFFF;line:55657A
  usecase "CU-286\nConsultar el Historial de\nCompras de un Proveedor" as U286 #back:FFFFFF;line:55657A
  usecase "CU-287\nModificar una Orden de Compra" as U287 #back:FFFFFF;line:55657A
  usecase "CU-288\nEnviar una Orden de Compra" as U288 #back:FFFFFF;line:55657A
}

rectangle "Casos de uso de otros subsistemas\n(sólo como referencia)" as OTROS #back:FFFFFF;line:6B7683;line.dashed {
  usecase "CU-250\nAplicar un Movimiento de Stock\n(SS-08)" as U250 #back:FFFFFF;line:6B7683
}

