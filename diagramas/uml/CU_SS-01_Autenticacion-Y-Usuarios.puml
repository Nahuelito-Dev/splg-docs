@startuml
title SS-01 — Autenticación y Usuarios (11 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<pendiente>> #9C4436
  BackgroundColor<<pendiente>> #F6E4E1
}

actor "Cliente\n(ACT-01)" as A01
actor "Chofer\n(ACT-02)" as A02
actor "Administrador\n(ACT-03)" as A03
actor "Sistema Automático\n(ACT-04)" as A04
actor "Administrador General\n(ACT-05)" as A05

rectangle "SS-01 Autenticación y Usuarios" {
  usecase "CU-001\nIniciar Sesión" as U001 #back:FFFFFF;line:3C6E8F
  usecase "CU-002\nRegistrarse como Cliente" as U002 #back:FFFFFF;line:3C6E8F
  usecase "CU-003\nRegistrar Chofer" as U003 #back:FFFFFF;line:3C6E8F
  usecase "CU-004\nGestionar Perfil de Usuario" as U004 #back:FFFFFF;line:3C6E8F
  usecase "CU-047\nRecuperar Contraseña" as U047 #back:FFFFFF;line:3C6E8F
  usecase "CU-050\nBloquear / Desbloquear Usuario" as U050 #back:FFFFFF;line:3C6E8F
  usecase "CU-082\nCrear Usuario Base" as U082 #back:FFFFFF;line:3C6E8F
  usecase "CU-083\nBuscar / Listar Usuarios" as U083 #back:FFFFFF;line:3C6E8F
  usecase "CU-084\nVerificar Existencia de\nUsuario (pre-registro)" as U084 #back:FFFFFF;line:3C6E8F
  usecase "CU-085\nEliminar Usuario (baja lógica)" as U085 #back:FFFFFF;line:3C6E8F
  usecase "CU-091\nValidar Vigencia del Token de\nSesión" as U091 #back:FFFFFF;line:3C6E8F
}

