@startuml
title SS-01 — Autenticación y Usuarios (14 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<planificado>> #9C4436
  BackgroundColor<<planificado>> #F6E4E1
  BorderColor<<factorizado>> #6B7683
  BackgroundColor<<factorizado>> #F2F4F6
}

actor "Cliente\n(ACT-01)" as A01
actor "Chofer\n(ACT-02)" as A02
actor "Administrador\n(ACT-03)" as A03
actor "Sistema Automático\n(ACT-04)" as A04
actor "Administrador General\n(ACT-05)" as A05
actor "Firebase\n(ACT-07)" as A07 <<sistema externo>>
actor "Servicio de correo\n(ACT-08)" as A08 <<sistema externo>>

rectangle "SS-01 Autenticación y Usuarios" {
  usecase "CU-001\nIniciar Sesión" as U001 #back:FFFFFF;line:3C6E8F
  usecase "CU-002\nRegistrarse como Cliente" as U002 #back:FFFFFF;line:3C6E8F
  usecase "CU-003\nRegistrar Chofer" as U003 #back:FFFFFF;line:3C6E8F
