@startuml
title SS-02 — Gestión de Pedidos (30 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<pendiente>> #9C4436
  BackgroundColor<<pendiente>> #F6E4E1
  BorderColor<<factorizado>> #6B7683
  BackgroundColor<<factorizado>> #F2F4F6
}

actor "Cliente\n(ACT-01)" as A01
actor "Chofer\n(ACT-02)" as A02
actor "Administrador\n(ACT-03)" as A03
actor "Sistema Automático\n(ACT-04)" as A04
actor "Administrador General\n(ACT-05)" as A05

rectangle "SS-02 Gestión de Pedidos" {
  usecase "CU-005\nCrear Pedido" as U005 #back:FFFFFF;line:3F7A50
  usecase "CU-006\nConsultar Detalle de Pedido" as U006 #back:FFFFFF;line:3F7A50
  usecase "CU-007\nConsultar Historial de Pedidos" as U007 #back:FFFFFF;line:3F7A50
  usecase "CU-008\nCancelar Pedido (Cliente)" as U008 #back:FFFFFF;line:3F7A50
  usecase "CU-009\nCancelar Pedido (Chofer)" as U009 #back:FFFFFF;line:3F7A50
  usecase "CU-010\nCancelar Pedido\n(Administrador)" as U010 #back:FFFFFF;line:3F7A50
  usecase "CU-011\nListar Todos los Pedidos" as U011 #back:FFFFFF;line:3F7A50
  usecase "CU-046\nConsultar Direcciones de\nEntrega del Cliente" as U046 #back:FFFFFF;line:3F7A50
  usecase "CU-080\nConsultar el Pool de Pedidos\nDisponibles" as U080 #back:FFFFFF;line:3F7A50
  usecase "CU-081\nConsultar los Pedidos\nAsignados al Chofer" as U081 #back:FFFFFF;line:3F7A50
  usecase "CU-106\nAnticipar la recompra por\nconsumo estimado" as U106 <<pendiente>> #back:FFFFFF;line:3F7A50
  usecase "CU-116\nRegistrar Dirección de Entrega" as U116 #back:FFFFFF;line:3F7A50
  usecase "CU-117\nConsultar Detalle de una\nDirección de Entrega" as U117 #back:FFFFFF;line:3F7A50
  usecase "CU-118\nEditar Dirección de Entrega" as U118 #back:FFFFFF;line:3F7A50
  usecase "CU-119\nEliminar Dirección de Entrega" as U119 #back:FFFFFF;line:3F7A50
  usecase "CU-120\nMarcar una Dirección como\nPredeterminada" as U120 #back:FFFFFF;line:3F7A50
  usecase "CU-121\nConsultar la Dirección\nPredeterminada" as U121 #back:FFFFFF;line:3F7A50
  usecase "CU-122\nAgregar Ítem al Carrito" as U122 <<pendiente>> #back:FFFFFF;line:3F7A50
  usecase "CU-123\nModificar la Cantidad de un\nÍtem del Carrito" as U123 <<pendiente>> #back:FFFFFF;line:3F7A50
  usecase "CU-124\nQuitar Ítem del Carrito" as U124 <<pendiente>> #back:FFFFFF;line:3F7A50
  usecase "CU-125\nConsultar el Carrito" as U125 <<pendiente>> #back:FFFFFF;line:3F7A50
  usecase "CU-126\nVaciar el Carrito" as U126 <<pendiente>> #back:FFFFFF;line:3F7A50
  usecase "CU-127\nCambiar la Dirección de\nEntrega del Pedido" as U127 <<pendiente>> #back:FFFFFF;line:3F7A50
  usecase "CU-128\nIndicar Quién Recibe el Pedido" as U128 <<pendiente>> #back:FFFFFF;line:3F7A50
  usecase "CU-143\nDeclarar el Consumo Promedio\nal Registrarse" as U143 <<pendiente>> #back:FFFFFF;line:3F7A50
  usecase "CU-144\nActualizar el Consumo Promedio\nDeclarado" as U144 <<pendiente>> #back:FFFFFF;line:3F7A50
  usecase "CU-145\nConfigurar los Días de Aviso\nPrevio a la Recompra" as U145 <<pendiente>> #back:FFFFFF;line:3F7A50
  usecase "CU-146\nConsultar la Fecha Estimada de\nRecompra" as U146 <<pendiente>> #back:FFFFFF;line:3F7A50
  usecase "CU-147\nRealizar una Compra Express" as U147 <<pendiente>> #back:FFFFFF;line:3F7A50
  usecase "CU-148\nElegir la Modalidad de Entrega\ndel Pedido" as U148 <<pendiente>> #back:FFFFFF;line:3F7A50
  usecase "Aplicar Promocion" as F_PROMO <<factorizado>> #back:FFFFFF;line:3F7A50
  usecase "Recargo por Transferencia" as F_RECAR <<factorizado>> #back:FFFFFF;line:3F7A50
  usecase "Reservar Stock" as F_STOCK <<factorizado>> #back:FFFFFF;line:3F7A50
}

