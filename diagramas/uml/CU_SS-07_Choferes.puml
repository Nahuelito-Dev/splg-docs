@startuml
title SS-07 — Gestión de Choferes y Vehículos: Choferes (14 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<planificado>> #9C4436
  BackgroundColor<<planificado>> #F6E4E1
  BorderColor<<factorizado>> #6B7683
  BackgroundColor<<factorizado>> #F2F4F6
}

actor "Chofer\n(ACT-02)" as A02
actor "Administrador\n(ACT-03)" as A03
actor "Administrador General\n(ACT-05)" as A05

rectangle "SS-07 Gestión de Choferes y Vehículos\nChoferes" {
  usecase "CU-031\nRegistrar Chofer" as U031 #back:FFFFFF;line:5A5896
  usecase "CU-032\nValidar un Chofer" as U032 #back:FFFFFF;line:5A5896
  usecase "CU-033\nActivar un Chofer" as U033 #back:FFFFFF;line:5A5896
  usecase "CU-034\nRegistrar Vehículo del Chofer" as U034 #back:FFFFFF;line:5A5896
  usecase "CU-035\nConsultar Listado de Choferes" as U035 #back:FFFFFF;line:5A5896
  usecase "CU-049\nConsultar Balance / Ganancias\ndel Chofer" as U049 #back:FFFFFF;line:5A5896
  usecase "CU-096\nActualizar Perfil del Chofer" as U096 #back:FFFFFF;line:5A5896
  usecase "CU-097\nEliminar Chofer (baja lógica)" as U097 #back:FFFFFF;line:5A5896
  usecase "CU-109\nConsultar Detalle del Chofer" as U109 #back:FFFFFF;line:5A5896
  usecase "CU-110\nBuscar Chofer por Usuario" as U110 #back:FFFFFF;line:5A5896
  usecase "CU-115\nConsultar Vehículos de un\nChofer" as U115 #back:FFFFFF;line:5A5896
  usecase "CU-138\nRegistrar la Licencia de\nConducir del Chofer" as U138 #back:FFFFFF;line:5A5896
  usecase "CU-267\nDesactivar un Chofer" as U267 #back:FFFFFF;line:5A5896
  usecase "CU-271\nInvalidar un Chofer" as U271 #back:FFFFFF;line:5A5896
  usecase "Filtrar por Término" as F_TERM <<factorizado>> #back:FFFFFF;line:5A5896
}

rectangle "Casos de uso de otros subsistemas\n(sólo como referencia)" as OTROS #back:FFFFFF;line:6B7683;line.dashed {
  usecase "CU-082\nCrear Usuario Base\n(SS-01)" as U082 #back:FFFFFF;line:6B7683
}

A02 -[#2E7D46]- U049
A02 -[#2E7D46]- U115
