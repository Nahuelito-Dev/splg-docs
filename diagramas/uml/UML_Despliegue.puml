@startuml
title Diagrama de despliegue — SPLG en ejecución
!include ../estilo-vp.iuml
skinparam artifact {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
}
left to right direction
skinparam nodesep 40
skinparam ranksep 110

node "Teléfono del cliente\n<<device>>\nAndroid o iOS" as DC {
  artifact "splg-app-cliente\n(Flutter)" as AC
}
node "Teléfono del chofer\n<<device>>\nAndroid" as DD {
  artifact "splg-app-chofer\n(Flutter)" as AD
}
node "Computadora del administrador\n<<device>>" as DA {
  node "Navegador web\n<<execution environment>>" as NAV {
    artifact "splg-app-admin\n(React, código estático)" as PANEL
  }
}

node "Servidor virtual (VPS)\n<<device>>" as VPS {
  node "Docker Compose\n<<execution environment>>" as DOCK {
    node "Contenedor splg-app-backend\n<<execution environment>>\nNode.js" as CB {
      artifact "splg-app-backend\n(NestJS)" as BACK
    }
    node "Contenedor splg-bd\n<<execution environment>>" as CBD {
      database "PostgreSQL 14 + PostGIS 3.4" as PG
    }
    node "Contenedor splg-redis\n<<execution environment>>" as CRD {
      database "Redis" as RD
    }
  }
  node "Servidor web\n<<execution environment>>" as WEB {
    artifact "splg-app-admin\n(archivos estáticos)" as PANELDIST
  }
}

node "Servicio de correo\n<<execution environment>>\n<<externo>>" as ML
node "MercadoPago\n<<execution environment>>\n<<externo>>\nCheckout Pro" as MP
node "Firebase\n<<execution environment>>\n<<externo>>\nAuth y FCM" as FB

AC -down- BACK : <<HTTPS, WSS>>\nREST y Socket.IO
AD -down- BACK : <<HTTPS, WSS>>\nREST y Socket.IO
PANEL -down- BACK : <<HTTPS, WSS>>\nREST y Socket.IO
NAV -down- PANELDIST : <<HTTPS>>\n(descarga de la aplicación)

BACK -down- PG : <<TCP 5432>>
BACK -down- RD : <<TCP 6379>>

BACK -down- ML : <<HTTPS>>\nbienvenida, recuperación de clave,\naviso de vencimientos
BACK -down- MP : <<HTTPS>>\ncreación del cobro y\nwebhook de pago
BACK -down- FB : <<HTTPS>>\nverificación de identidad
FB -up- AC : <<FCM>>
FB -up- AD : <<FCM>>
ML -[hidden]right- MP
MP -[hidden]right- FB
@enduml
