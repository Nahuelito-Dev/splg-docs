@startuml
title SS-09 — Franjas Horarias (6 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<planificado>> #9C4436
  BackgroundColor<<planificado>> #F6E4E1
  BorderColor<<factorizado>> #6B7683
  BackgroundColor<<factorizado>> #F2F4F6
}

actor "Cliente\n(ACT-01)" as A01
actor "Administrador\n(ACT-03)" as A03
actor "Administrador General\n(ACT-05)" as A05

rectangle "SS-09 Franjas Horarias" {
  usecase "CU-042\nCrear Franja Horaria" as U042 #back:FFFFFF;line:A26A45
  usecase "CU-043\nModificar Capacidad de Franja\nHoraria" as U043 <<planificado>> #back:FFFFFF;line:A26A45
  usecase "CU-044\nSeleccionar Franja Horaria al\nCrear Pedido" as U044 #back:FFFFFF;line:A26A45
  usecase "CU-045\nConsultar Franjas Horarias\nDisponibles" as U045 #back:FFFFFF;line:A26A45
  usecase "CU-103\nEliminar Franja Horaria" as U103 #back:FFFFFF;line:A26A45
  usecase "CU-154\nConsultar Listado de Franjas\nHorarias" as U154 #back:FFFFFF;line:A26A45
}

A01 -[#1F6F8B]- U044
A01 -[#1F6F8B]- U045
A03 -[#8C4A9E]- U042
A03 -[#8C4A9E]- U043
A03 -[#8C4A9E]- U103
A03 -[#8C4A9E]- U154
A05 --|> A03

' escribir sobre algo exige leerlo antes: la busqueda entra por <<include>>
U044 ..> U045 : <<include>>
U043 ..> U154 : <<include>>
U103 ..> U154 : <<include>>

@enduml