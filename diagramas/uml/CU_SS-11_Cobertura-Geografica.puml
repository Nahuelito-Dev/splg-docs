@startuml
title SS-11 — Cobertura Geográfica (6 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<planificado>> #9C4436
  BackgroundColor<<planificado>> #F6E4E1
  BorderColor<<factorizado>> #6B7683
  BackgroundColor<<factorizado>> #F2F4F6
}

actor "Cliente\n(ACT-01)" as A01
actor "Administrador\n(ACT-03)" as A03
actor "Sistema Automático\n(ACT-04)" as A04
actor "Administrador General\n(ACT-05)" as A05

rectangle "SS-11 Cobertura Geográfica" {
  usecase "CU-056\nDefinir Zona de Cobertura" as U056 #back:FFFFFF;line:8E5566
  usecase "CU-057\nConsultar Zonas de Cobertura" as U057 #back:FFFFFF;line:8E5566
  usecase "CU-058\nValidar Cobertura de una\nDirección" as U058 #back:FFFFFF;line:8E5566
  usecase "CU-059\nEliminar Zona de Cobertura" as U059 #back:FFFFFF;line:8E5566
  usecase "CU-150\nProgramar la Vigencia de una\nZona de Cobertura" as U150 #back:FFFFFF;line:8E5566
  usecase "CU-151\nDesactivar las Zonas de\nCobertura Vencidas" as U151 <<planificado>> #back:FFFFFF;line:8E5566
}

A01 -[#1F6F8B]- U058
A03 -[#8C4A9E]- U056
A03 -[#8C4A9E]- U057
A03 -[#8C4A9E]- U058
A03 -[#8C4A9E]- U059
A03 -[#8C4A9E]- U150
A04 -[#8A6D1F]- U151
A05 -right-|> A03

' escribir sobre algo exige leerlo antes: la busqueda entra por <<include>>
U059 ..> U057 : <<include>>

@enduml