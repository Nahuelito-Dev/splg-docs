@startuml
title SS-11 — Cobertura Geográfica (4 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<pendiente>> #9C4436
  BackgroundColor<<pendiente>> #F6E4E1
}

actor "Cliente\n(ACT-01)" as A01
actor "Administrador\n(ACT-03)" as A03
actor "Administrador General\n(ACT-05)" as A05

rectangle "SS-11 Cobertura Geográfica" {
  usecase "CU-056\nDefinir Zona de Cobertura" as U056 #back:FFFFFF;line:8E5566
  usecase "CU-057\nConsultar Zonas de Cobertura" as U057 #back:FFFFFF;line:8E5566
  usecase "CU-058\nValidar Cobertura de una\nDirección" as U058 #back:FFFFFF;line:8E5566
  usecase "CU-059\nEliminar Zona de Cobertura" as U059 #back:FFFFFF;line:8E5566
}

A01 -[#1F6F8B]-> U058
A03 -[#8C4A9E]-> U056
A03 -[#8C4A9E]-> U057
A03 -[#8C4A9E]-> U058
A03 -[#8C4A9E]-> U059
A05 -[#B4432B]-> U056
A05 -[#B4432B]-> U057
A05 -[#B4432B]-> U058
A05 -[#B4432B]-> U059

@enduml