@startuml
title SS-06 — Reportes y Dashboard (5 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<pendiente>> #9C4436
  BackgroundColor<<pendiente>> #F6E4E1
  BorderColor<<factorizado>> #6B7683
  BackgroundColor<<factorizado>> #F2F4F6
}

actor "Administrador\n(ACT-03)" as A03

rectangle "SS-06 Reportes y Dashboard" {
  usecase "CU-026\nVer Dashboard General" as U026 #back:FFFFFF;line:3E7C79
  usecase "CU-027\nVer Reporte de Ventas por\nChofer" as U027 #back:FFFFFF;line:3E7C79
  usecase "CU-028\nVer Reporte de Ventas por\nProducto" as U028 #back:FFFFFF;line:3E7C79
  usecase "CU-029\nVer Reporte por Método de Pago" as U029 #back:FFFFFF;line:3E7C79
  usecase "CU-030\nVer Gráfico de Ventas (últimos\n7 días)" as U030 #back:FFFFFF;line:3E7C79
}

A03 -[#8C4A9E]- U026
A03 -[#8C4A9E]- U027
A03 -[#8C4A9E]- U028
A03 -[#8C4A9E]- U029
A03 -[#8C4A9E]- U030

@enduml