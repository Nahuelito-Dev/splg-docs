@startuml
title SS-16 — Administración de Cuentas y Roles (11 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<planificado>> #9C4436
  BackgroundColor<<planificado>> #F6E4E1
  BorderColor<<factorizado>> #6B7683
  BackgroundColor<<factorizado>> #F2F4F6
}

actor "Administrador\n(ACT-03)" as A03
actor "Administrador General\n(ACT-05)" as A05

rectangle "SS-16 Administración de Cuentas y Roles" {
  usecase "CU-086\nRegistrar Administrador" as U086 #back:FFFFFF;line:4B7560
  usecase "CU-087\nCrear el Primer Super\nAdministrador (bootstrap)" as U087 #back:FFFFFF;line:4B7560
  usecase "CU-088\nConsultar Administradores" as U088 #back:FFFFFF;line:4B7560
  usecase "CU-089\nGestionar Roles del Sistema" as U089 #back:FFFFFF;line:4B7560
  usecase "CU-090\nSembrar los Roles Iniciales" as U090 #back:FFFFFF;line:4B7560
  usecase "CU-092\nConsultar Listado de Clientes" as U092 #back:FFFFFF;line:4B7560
  usecase "CU-094\nActualizar Ubicación del\nCliente" as U094 #back:FFFFFF;line:4B7560
  usecase "CU-095\nEliminar Cliente (baja lógica)" as U095 #back:FFFFFF;line:4B7560
  usecase "CU-129\nConsultar Detalle del Cliente" as U129 #back:FFFFFF;line:4B7560
  usecase "CU-130\nBuscar Cliente por Usuario" as U130 #back:FFFFFF;line:4B7560
  usecase "CU-131\nEditar Datos del Cliente" as U131 #back:FFFFFF;line:4B7560
  usecase "Filtrar por Término" as F_TERM <<factorizado>> #back:FFFFFF;line:4B7560
}

usecase "CU-082\nCrear Usuario Base\n(SS-01)" as U082 #back:FFFFFF;line:6B7683

A03 -[#8C4A9E]- U086
A03 -[#8C4A9E]- U088
A03 -[#8C4A9E]- U092
A03 -[#8C4A9E]- U094
A03 -[#8C4A9E]- U129
A03 -[#8C4A9E]- U130
A03 -[#8C4A9E]- U131
A05 -[#B4432B]- U087
A05 -[#B4432B]- U089
A05 -[#B4432B]- U090
A05 -[#B4432B]- U095
A05 --|> A03

' escribir sobre algo exige leerlo antes: la busqueda entra por <<include>>
U094 ..> U129 : <<include>>
U095 ..> U129 : <<include>>
U131 ..> U129 : <<include>>
U129 ..> U130 : <<include>>
U086 ..> U082 : <<include>>
U087 ..> U082 : <<include>>

' <<extend>>: comportamiento opcional. La flecha va de la extension al caso base.
F_TERM ..> U092 : <<extend>>
note on link
  Punto de extensión: se indica el parámetro term sobre el listado
end note

@enduml