@startuml
title SS-17 — Notificaciones y Mensajería (5 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<planificado>> #9C4436
  BackgroundColor<<planificado>> #F6E4E1
  BorderColor<<factorizado>> #6B7683
  BackgroundColor<<factorizado>> #F2F4F6
}

actor "Cliente\n(ACT-01)" as A01
actor "Chofer\n(ACT-02)" as A02
actor "Administrador\n(ACT-03)" as A03
actor "Administrador General\n(ACT-05)" as A05
actor "Firebase\n(ACT-07)" as A07 <<sistema externo>>
actor "Servicio de correo\n(ACT-08)" as A08 <<sistema externo>>

rectangle "SS-17 Notificaciones y Mensajería" {
  usecase "CU-098\nRegistrar el Token de\nNotificaciones del Dispositivo" as U098 #back:FFFFFF;line:7C6B4C
  usecase "CU-099\nConsultar los Tokens de un\nUsuario" as U099 #back:FFFFFF;line:7C6B4C
  usecase "CU-100\nEnviar Notificación de Prueba" as U100 #back:FFFFFF;line:7C6B4C
  usecase "CU-101\nReenviar Notificación de\nConfirmación de Pedido" as U101 #back:FFFFFF;line:7C6B4C
  usecase "CU-102\nProbar el Servicio de Correo" as U102 #back:FFFFFF;line:7C6B4C
}

A01 -[#1F6F8B]- U098
A01 -[#1F6F8B]- U099
A02 -[#2E7D46]- U098
A02 -[#2E7D46]- U099
A03 -[#8C4A9E]- U098
A03 -[#8C4A9E]- U099
A05 -[#B4432B]- U100
A05 -[#B4432B]- U101
A05 -[#B4432B]- U102
U100 -[#6B7683]- A07
U101 -[#6B7683]- A07
U102 -[#6B7683]- A08
A05 -right-|> A03

@enduml