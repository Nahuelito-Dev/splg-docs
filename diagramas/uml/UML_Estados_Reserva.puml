@startuml
title Diagrama de estados — Reserva programada
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam state {
  BorderColor #2C4257
  BackgroundColor #F4F7FA
  StartColor #2C4257
  EndColor #2C4257
  AttributeFontSize 12
}
skinparam ArrowFontSize 12
skinparam NoteBackgroundColor #FBF7E6
skinparam NoteBorderColor #7A7340
hide empty description
state "Reservada sin seña\n(status = RESERVED,\ndepositPaid = false)" as SIN
state "Reservada con seña\n(status = RESERVED,\ndepositPaid = true)" as CON
state "Activada\n(status = PENDING)" as ACT
state "Cancelada\n(status = CANCELLED)" as CAN

[*] --> SIN : crearReserva() [scheduledDate informada;\nstock descontado]
SIN --> CON : confirmarSeña() [efectivo, administrador]\no webhook de MercadoPago aprobado
CON --> ACT : activarReserva() [scheduledDate <= hoy;\nproceso cada 5 minutos o manual]
SIN --> CAN : vencerSeña() [antigüedad > plazo de la seña;\nproceso cada hora]
SIN --> CAN : cancelarPedido()
CON --> CAN : cancelarPedido()
CAN --> [*] : restituirStock()
ACT --> [*] : ofrecerAlSiguiente()

note bottom of ACT
  Desde la activación el pedido sigue el diagrama de estados del Pedido.
end note
@enduml
