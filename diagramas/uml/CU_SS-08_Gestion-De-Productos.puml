@startuml
title SS-08 — Catálogo de Productos
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam ArrowColor #2C4257
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
  BorderColor<<pendiente>> #9C4436
  BackgroundColor<<pendiente>> #F6E4E1
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

actor "Cliente" as A1
actor "Administrador" as A3

rectangle "SS-08 Catálogo de Productos" {
  usecase "CU-036\nCrear Producto (Garrafa)" as U36
  usecase "CU-037\nActualizar Precio de Producto" as U37
  usecase "CU-038\nActualizar Stock de Producto" as U38
  usecase "CU-039\nConfigurar Promociones por Cantidad" as U39
  usecase "CU-040\nActivar / Desactivar Producto" as U40
  usecase "CU-041\nConsultar Catálogo de Productos" as U41
}

A3 --> U36
A3 --> U37
A3 --> U38
A3 --> U39
A3 --> U40
A1 --> U41
A3 --> U41
@enduml
