@startuml
title SS-08 — Gestión de Productos e Inventario (6 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<planificado>> #9C4436
  BackgroundColor<<planificado>> #F6E4E1
  BorderColor<<factorizado>> #6B7683
  BackgroundColor<<factorizado>> #F2F4F6
}

actor "Cliente\n(ACT-01)" as A01
actor "Administrador\n(ACT-03)" as A03
actor "Administrador General\n(ACT-05)" as A05

rectangle "SS-08 Gestión de Productos e Inventario" {
  usecase "CU-036\nCrear Producto (Garrafa)" as U036 #back:FFFFFF;line:5E7A3A
  usecase "CU-037\nActualizar Precio de Producto" as U037 #back:FFFFFF;line:5E7A3A
  usecase "CU-038\nActualizar Stock de Producto" as U038 #back:FFFFFF;line:5E7A3A
  usecase "CU-039\nConfigurar Promociones por\nCantidad" as U039 #back:FFFFFF;line:5E7A3A
  usecase "CU-040\nActivar / Desactivar Producto" as U040 #back:FFFFFF;line:5E7A3A
  usecase "CU-041\nConsultar Catálogo de\nProductos" as U041 #back:FFFFFF;line:5E7A3A
  usecase "Filtrar por Término" as F_TERM <<factorizado>> #back:FFFFFF;line:5E7A3A
}

A01 -[#1F6F8B]- U041
A03 -[#8C4A9E]- U036
A03 -[#8C4A9E]- U037
A03 -[#8C4A9E]- U038
A03 -[#8C4A9E]- U039
A03 -[#8C4A9E]- U040
A03 -[#8C4A9E]- U041
A05 --|> A03

' escribir sobre algo exige leerlo antes: la busqueda entra por <<include>>
U037 ..> U041 : <<include>>
U038 ..> U041 : <<include>>
U039 ..> U041 : <<include>>
U040 ..> U041 : <<include>>

' <<extend>>: comportamiento opcional. La flecha va de la extension al caso base.
F_TERM ..> U041 : <<extend>>
note on link
  Punto de extensión: se indica el parámetro term sobre el listado
end note

@enduml