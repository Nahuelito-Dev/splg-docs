  usecase "CU-040\nActivar / Desactivar Producto" as U040 #back:FFFFFF;line:5E7A3A
  usecase "CU-041\nConsultar Catálogo de\nProductos" as U041 #back:FFFFFF;line:5E7A3A
  usecase "CU-207\nGestionar los Depósitos" as U207 <<planificado>> #back:FFFFFF;line:5E7A3A
  usecase "CU-208\nConsultar el Stock por\nUbicación" as U208 <<planificado>> #back:FFFFFF;line:5E7A3A
  usecase "CU-209\nConsultar los Movimientos de\nStock" as U209 <<planificado>> #back:FFFFFF;line:5E7A3A
