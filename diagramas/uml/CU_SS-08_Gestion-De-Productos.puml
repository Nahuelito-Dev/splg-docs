  usecase "CU-248\nVerificar la Carga de Camión\nAbierta del Chofer" as U248 <<planificado>> #back:FFFFFF;line:5E7A3A
  usecase "CU-249\nConfigurar el Control de Carga\nde Camión Abierta" as U249 <<planificado>> #back:FFFFFF;line:5E7A3A
  usecase "CU-250\nAplicar un Movimiento de Stock" as U250 <<planificado>> #back:FFFFFF;line:5E7A3A
