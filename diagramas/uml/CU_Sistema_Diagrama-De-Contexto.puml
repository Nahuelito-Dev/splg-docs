@startuml
title Diagrama de Contexto del Sistema — SPLG
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 14
skinparam ranksep 90
skinparam rectangle {
  BorderColor #2C4257
  FontSize 12
}

actor "Cliente\n(ACT-01)" as A01
actor "Chofer\n(ACT-02)" as A02
actor "Administrador\n(ACT-03)" as A03
actor "Administrador General\n(ACT-05)" as A05
actor "Sistema Automático\n(ACT-04)" as A04
actor "MercadoPago\n(ACT-06)" as A06 <<externo>>
actor "Firebase\n(ACT-07)" as A07 <<externo>>
actor "Servicio de correo\n(ACT-08)" as A08 <<externo>>

rectangle "**Sistema de Pedidos y Logística de Garrafas de Gas (SPLG)**\n\nSS-01  Autenticación y Usuarios  (11)\nSS-02  Gestión de Pedidos  (32)\nSS-03  Despacho y Asignación  (8)\nSS-04  Seguimiento en Tiempo Real  (8)\nSS-05  Reclamos  (7)\nSS-06  Reportes y Dashboard  (5)\nSS-07  Gestión de Choferes y Vehículos  (35)\nSS-08  Gestión de Productos e Inventario  (6)\nSS-09  Franjas Horarias  (6)\nSS-10  Multi-Distribuidora  (4)\nSS-11  Cobertura Geográfica  (6)\nSS-12  Incidencias y Calidad de Servicio  (7)\nSS-13  Trazabilidad de Envases  (10)\nSS-14  Pagos y Conciliación  (2)\nSS-15  Reservas Programadas  (6)\nSS-16  Administración de Cuentas y Roles  (11)\nSS-17  Notificaciones y Mensajería  (5)\nSS-18  Observabilidad y Operación  (5)\n\n(entre paréntesis, los casos de uso de cada subsistema)" as LIMITE #back:F4F7FA;line:2C4257

A01 -[#1F6F8B]down- LIMITE : pide, sigue y reclama sus pedidos
A02 -[#2E7D46]down- LIMITE : recibe ofertas y entrega
A03 -[#8C4A9E]down- LIMITE : gestiona su distribuidora
A05 -[#B4432B]down- LIMITE : gestiona todas las distribuidoras
A04 -[#8A6D1F]down- LIMITE : ejecuta los procesos programados

LIMITE -[#6B7683]down- A06 : cobra y recibe el aviso de pago
LIMITE -[#6B7683]down- A07 : identidad y avisos push
LIMITE -[#6B7683]down- A08 : comprobantes por correo

A05 -right-|> A03

@enduml