@startuml
title Diagrama de Casos de Uso del Sistema — SPLG
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam ArrowColor #2C4257
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
  BorderColor<<pendiente>> #9C4436
  BackgroundColor<<pendiente>> #F6E4E1
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

actor "Cliente" as A1
actor "Chofer" as A2
actor "Administrador" as A3
actor "Sistema Automatico" as A4
actor "Administrador General" as A5

rectangle "Sistema de Pedidos y Logistica de Garrafas de Gas (SPLG)" {
  usecase "SS-01\nAutenticación y Usuarios\n(11 casos de uso)" as S1
  usecase "SS-02\nGestión de Pedidos\n(11 casos de uso)" as S2
  usecase "SS-03\nDespacho y Asignación\n(6 casos de uso)" as S3
  usecase "SS-04\nSeguimiento en Tiempo Real\n(8 casos de uso)" as S4
  usecase "SS-05\nReclamos\n(3 casos de uso)" as S5
  usecase "SS-06\nReportes y Dashboard\n(5 casos de uso)" as S6
  usecase "SS-07\nChoferes y Vehículos\n(10 casos de uso)" as S7
  usecase "SS-08\nCatálogo de Productos\n(6 casos de uso)" as S8
  usecase "SS-09\nFranjas Horarias\n(5 casos de uso)" as S9
  usecase "SS-10\nMulti-Distribuidora\n(4 casos de uso)" as S10
  usecase "SS-11\nCobertura Geográfica\n(4 casos de uso)" as S11
  usecase "SS-12\nIncidencias y Calidad\n(7 casos de uso)" as S12
  usecase "SS-13\nTrazabilidad de Envases\n(6 casos de uso)" as S13
  usecase "SS-14\nPagos y Conciliación\n(1 casos de uso)" as S14
  usecase "SS-15\nReservas Programadas\n(6 casos de uso)" as S15
  usecase "SS-16\nCuentas y Roles\n(9 casos de uso)" as S16
  usecase "SS-17\nNotificaciones\n(5 casos de uso)" as S17
  usecase "SS-18\nObservabilidad\n(1 casos de uso)" as S18
}

