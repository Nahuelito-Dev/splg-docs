@startuml
title SS-12 — Incidencias y Calidad de Servicio (7 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<planificado>> #9C4436
  BackgroundColor<<planificado>> #F6E4E1
  BorderColor<<factorizado>> #6B7683
  BackgroundColor<<factorizado>> #F2F4F6
}

actor "Cliente\n(ACT-01)" as A01
actor "Chofer\n(ACT-02)" as A02
actor "Administrador\n(ACT-03)" as A03
actor "Administrador General\n(ACT-05)" as A05

rectangle "SS-12 Incidencias y Calidad de Servicio" {
  usecase "CU-060\nRegistrar Incidencia de\nEntrega" as U060 #back:FFFFFF;line:4A7488
  usecase "CU-061\nListar Incidencias" as U061 #back:FFFFFF;line:4A7488
  usecase "CU-062\nConsultar Incidencias de un\nPedido" as U062 #back:FFFFFF;line:4A7488
  usecase "CU-063\nResolver Incidencia" as U063 #back:FFFFFF;line:4A7488
  usecase "CU-064\nCalificar Pedido\n(cliente↔chofer)" as U064 #back:FFFFFF;line:4A7488
  usecase "CU-065\nConsultar Promedio de\nCalificaciones de un Usuario" as U065 #back:FFFFFF;line:4A7488
  usecase "CU-066\nConsultar Historial de\nCalificaciones Recibidas" as U066 #back:FFFFFF;line:4A7488
}

A01 -[#1F6F8B]- U064
A01 -[#1F6F8B]- U065
A02 -[#2E7D46]- U060
A02 -[#2E7D46]- U062
A02 -[#2E7D46]- U064
A02 -[#2E7D46]- U065
A03 -[#8C4A9E]- U060
A03 -[#8C4A9E]- U061
A03 -[#8C4A9E]- U062
A03 -[#8C4A9E]- U063
A03 -[#8C4A9E]- U065
A03 -[#8C4A9E]- U066
A05 -right-|> A03

