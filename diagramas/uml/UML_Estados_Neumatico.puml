@startuml
title Diagrama de estados — Neumático (planificado, I-12, opcional)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam state {
  BorderColor #2C4257
  BackgroundColor #F4F7FA
  StartColor #2C4257
  EndColor #2C4257
  AttributeFontSize 12
}
skinparam ArrowFontSize 12
skinparam NoteBackgroundColor #FBF7E6
skinparam NoteBorderColor #7A7340
hide empty description
state "En depósito\n(in_stock)" as STOCK
state "Montado\n(mounted)" as MOUNTED
state "Dado de baja\n(retired)" as RETIRED

[*] --> STOCK : registrarNeumatico(datos)
STOCK --> MOUNTED : registrarMovimientoDeNeumatico(datos) [tipo = montaje]
MOUNTED --> MOUNTED : registrarMovimientoDeNeumatico(datos) [tipo = rotación]
MOUNTED --> STOCK : registrarMovimientoDeNeumatico(datos) [tipo = desmontaje]
STOCK --> STOCK : registrarMovimientoDeNeumatico(datos) [tipo = recapado]
STOCK --> RETIRED : registrarMovimientoDeNeumatico(datos) [tipo = baja]
RETIRED --> [*]

note bottom of RETIRED
  Cada movimiento queda como un asiento que no se
  modifica. La baja es definitiva y sólo se registra
  con el neumático desmontado.
end note
@enduml
