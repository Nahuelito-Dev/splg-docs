@startuml
title SS-05 — Reclamos (3 casos de uso)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #2C4257
skinparam ArrowThickness 1.1
skinparam actor {
  BorderColor #2C4257
  BackgroundColor #E8EDF2
  FontSize 13
  FontStyle bold
}
skinparam usecase {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  FontSize 12
}
skinparam rectangle {
  BorderColor #6B7683
  FontSize 14
  FontStyle bold
}

skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BorderColor<<pendiente>> #9C4436
  BackgroundColor<<pendiente>> #F6E4E1
  BorderColor<<factorizado>> #6B7683
  BackgroundColor<<factorizado>> #F2F4F6
}

actor "Cliente\n(ACT-01)" as A01
actor "Administrador\n(ACT-03)" as A03

rectangle "SS-05 Reclamos" {
  usecase "CU-023\nRegistrar Reclamo" as U023 #back:FFFFFF;line:9C5A46
  usecase "CU-024\nListar Reclamos" as U024 #back:FFFFFF;line:9C5A46
  usecase "CU-025\nResolver Reclamo" as U025 #back:FFFFFF;line:9C5A46
  usecase "Adjuntar Foto" as F_FOTO <<factorizado>> #back:FFFFFF;line:9C5A46
}

A01 -[#1F6F8B]- U023
A03 -[#8C4A9E]- U024
A03 -[#8C4A9E]- U025

' <<extend>>: comportamiento opcional. La flecha va de la extension al caso base.
F_FOTO ..> U023 : <<extend>>
note on link
  Punto de extension: el cliente adjunta evidencia fotografica
end note

@enduml