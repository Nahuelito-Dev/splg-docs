sequenceDiagram
    title DSD — CU-163 Consultar el Vehículo en Uso de un Chofer · consultarVehiculoEnUso
    autonumber
    actor ADM as Administrador (ACT-03)
    participant SRV as :VehicleAssignmentService
    participant COL as :Map#lt;String, Chofer#gt;
    participant CHO as chofer:Chofer
    participant FLT as :FleetTaskService

    ADM->>+SRV: consultarVehiculoEnUso(choferId)
    SRV->>+COL: get(choferId)
    COL-->>-SRV: chofer
    SRV->>+CHO: getVehiculoEnUso()
    CHO-->>-SRV: vehiculo
    opt El chofer tiene un vehículo en uso
        SRV->>+FLT: motivosDeInhabilitacionDeVehiculo(vehiculo)
        FLT-->>-SRV: motivos
    end
    SRV-->>-ADM: vehiculo, inhabilitado
