@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class DriversGateway <<fachada>> {
  + actualizarUbicacion(usuario: Usuario, latitud: Decimal,\n      longitud: Decimal)
}
class CustomersGateway <<fabricación pura>> {
  + notifyCustomer(cliente: Cliente, evento: Registro,\n      posicion: UbicacionGPS)
}
class AdminGateway <<fabricación pura>> {
  + notifyAdmins(evento: Registro = ninguno,\n      posicion: UbicacionGPS = ninguno,\n      incidencia: Incidencia = ninguno)
}
class RoutesService <<fachada>> {
  + consultarRutaDelPedido(pedidoId: Identificador,\n      desde: Cadena): Registro
}
class Chofer <<referencia>>
class Pedido <<referencia>>
class UbicacionGPS <<referencia>>

DriversGateway --> "1" AdminGateway
DriversGateway --> "1" CustomersGateway
DriversGateway ..> Chofer
RoutesService ..> Chofer
RoutesService ..> Pedido
RoutesService ..> UbicacionGPS

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
