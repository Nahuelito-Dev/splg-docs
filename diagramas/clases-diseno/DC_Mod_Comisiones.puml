@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam genericDisplay old
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #F3E9CF
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #DCEBDD
}
skinparam interface {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBDD
  FontSize 14
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class CommissionService <<fachada>> {
  + anularLiquidacion(liquidacionId: Identificador): LiquidacionComisiones
  + aprobarLiquidacion(liquidacionId: Identificador): LiquidacionComisiones
  + consultarMisComisiones(fechaDesde: Fecha,\n      fechaHasta: Fecha,\n      out saldo: Moneda): AsientoComision[*]
  + crearReglaDeComision(empleadoId: Identificador,\n      productoId: Identificador, base: BaseDeComision,\n      valor: Decimal, vigenteDesde: Fecha): ReglaComision
  + liquidarComisionesDelChofer(empleadoId: Identificador,\n      fechaDesde: Fecha,\n      fechaHasta: Fecha): LiquidacionComisiones
  + modificarReglaDeComision(reglaId: Identificador,\n      datos: Registro): ReglaComision
  + pagarLiquidacion(liquidacionId: Identificador,\n      cajaId: Identificador): LiquidacionComisiones
  + registrarComisionDeEntrega(pedidoId: Identificador)
}
class "Map<String, ReglaComision>" as Map_String_ReglaComision <<colección>> {
  + get(clave: Cadena): ReglaComision
}
class "Map<String, LiquidacionComisiones>" as Map_String_LiquidacionComisiones <<colección>> {
  + get(clave: Cadena): LiquidacionComisiones
}
class "Map<String, Empleado>" as Map_String_Empleado <<colección>> {
  + get(clave: Cadena): Empleado
}
class "List<ReglaComision>" as List_ReglaComision <<colección>> {
  + getAplicable(pedido: Pedido,\n      empleado: Empleado): ReglaComision
}
class "List<AsientoComision>" as List_AsientoComision <<colección>> {
  + filtrar(empleado: Empleado, fechaDesde: Fecha,\n      fechaHasta: Fecha): AsientoComision[*]
  + getSinLiquidar(empleado: Empleado, fechaDesde: Fecha,\n      fechaHasta: Fecha): AsientoComision[*]
}
class Empleado <<referencia>>
class ReglaComision <<referencia>>
class LiquidacionComisiones <<referencia>>
class AsientoComision <<referencia>>
class "Map<String, Caja>" as Map_String_Caja <<referencia>>
class "Map<String, Pedido>" as Map_String_Pedido <<referencia>>
class "Map<String, Producto>" as Map_String_Producto <<referencia>>
class Chofer <<referencia>>
class Pedido <<referencia>>
class Distribuidora <<referencia>>

Map_String_Empleado "1" o--> "0..*" Empleado
Map_String_ReglaComision "1" o--> "0..*" ReglaComision
List_ReglaComision "1" o--> "0..*" ReglaComision
Map_String_LiquidacionComisiones "1" o--> "0..*" LiquidacionComisiones
List_AsientoComision "1" o--> "0..*" AsientoComision
CommissionService --> "1" List_AsientoComision
CommissionService --> "1" List_ReglaComision
CommissionService --> "1" Map_String_Caja
CommissionService --> "1" Map_String_Empleado
CommissionService --> "1" Map_String_LiquidacionComisiones
CommissionService --> "1" Map_String_Pedido
CommissionService --> "1" Map_String_Producto
CommissionService --> "1" Map_String_ReglaComision
CommissionService ..> Chofer
CommissionService ..> Distribuidora
CommissionService ..> Empleado
CommissionService ..> LiquidacionComisiones
CommissionService ..> Pedido
CommissionService ..> ReglaComision

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran sólo como referencia.
endlegend
@enduml
