@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class FleetDispatchLockService <<fabricación pura>> {
  + assertChoferHabilitado(chofer: Chofer)
  + vehiculoEnUsoDelChofer(chofer: Chofer): Vehiculo
}
class FleetMaintenancePlannerService <<fachada>> {
  + planificarMantenimientoDeFlota()
}
class DemandForecastService <<fabricación pura>> {
  + demandaProyectada(ventanas: PropuestaVentanaTaller[*]): Registro
}
class FleetCoverageService <<fabricación pura>> {
  + ventanasFactibles(vehiculo: Vehiculo,\n      ventanas: PropuestaVentanaTaller[*]): PropuestaVentanaTaller[*]
}
class RepurchaseForecastService <<fachada>> {
  + anticiparRecompras()
}
class ConsumptionEstimatorService <<fabricación pura>> {
  + estimarProximaRecompra(cliente: Cliente): Fecha
}
class CylinderRecoveryService <<fachada>> {
  + gestionarEnvasesNoDevueltos()
}
class CylinderLifecyclePort <<referencia>>
class NotificationsService <<referencia>>
class "List<Cliente>" as List_Cliente <<referencia>>
class "List<InvitacionRecompra>" as List_InvitacionRecompra <<referencia>>
class CasoRecupero <<referencia>>
class Envase <<referencia>>
class TareaMantenimiento <<referencia>>
class Vehiculo <<referencia>>
class InvitacionRecompra <<referencia>>
class UpdateOrderStatusUseCase <<referencia>>

CylinderRecoveryService --> "1" CylinderLifecyclePort
CylinderRecoveryService --> "1" NotificationsService
FleetMaintenancePlannerService --> "1" DemandForecastService
FleetMaintenancePlannerService --> "1" FleetCoverageService
FleetMaintenancePlannerService --> "1" NotificationsService
RepurchaseForecastService --> "1" ConsumptionEstimatorService
RepurchaseForecastService --> "1" List_Cliente
RepurchaseForecastService --> "1" List_InvitacionRecompra
RepurchaseForecastService --> "1" NotificationsService
CylinderRecoveryService ..> CasoRecupero
CylinderRecoveryService ..> Envase
FleetMaintenancePlannerService ..> TareaMantenimiento
FleetMaintenancePlannerService ..> Vehiculo
RepurchaseForecastService ..> "<<create>>" InvitacionRecompra
UpdateOrderStatusUseCase --> "1" FleetDispatchLockService

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
