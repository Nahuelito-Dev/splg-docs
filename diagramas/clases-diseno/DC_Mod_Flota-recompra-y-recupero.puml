@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class FleetDispatchLockService <<fabricación pura>> {
  + assertChoferHabilitado(chofer: Chofer)
  + vehiculoEnUsoDelChofer(chofer: Chofer): Vehiculo
}
class MaintenancePlannerService <<fachada>> {
  + planificarMantenimientoDeFlota(): Registro
}
class MaintenanceForecastService <<fabricación pura>> {
  + consumos(distribuidoraId: Identificador,\n      vehiculos: Vehiculo[*], parametros: Registro,\n      ahora: FechaHora): Registro
  + guardarPredicciones(proyectadas: Registro)
  + proyectar(tarea: TareaMantenimiento, vehiculo: Vehiculo,\n      consumo: Registro, ahora: FechaHora): Registro
}
class PlannerContextService <<fabricación pura>> {
  + cargar(distribuidoraId: Identificador,\n      vehiculosActivos: Registro, parametros: Registro,\n      ahora: FechaHora): Registro
}
class MaintenancePlannerNotifier <<fabricación pura>> {
  + propuestaAlChofer(chofer: Chofer,\n      propuesta: PropuestaVentanaTaller,\n      aviso: AvisoRecupero, correo: Cadena)
}
class RepurchaseForecastService <<fachada>> {
  + anticiparRecompras(): Cadena
}
class RepurchaseEstimatorService <<fabricación pura>> {
  + estimar(distribuidoraId: Identificador, ahora: FechaHora,\n      parametros: Registro): Cliente[*]
  + parametros(distribuidoraId: Identificador): Registro
}
class RepurchaseInvitationService <<fabricación pura>> {
  + abrir(datos: Registro): InvitacionRecompra
  + vencerVencidas(ahora: FechaHora,\n      distribuidoraId: Identificador)
}
class RepurchaseSuggestionService <<fabricación pura>> {
  + armar(distribuidoraId: Identificador, usuario: Usuario,\n      habitos: Registro): Registro
}
class RepurchaseNotifier <<fabricación pura>> {
  + invitar(invitacion: InvitacionRecompra)
}
class CylinderRecoveryService <<fachada>> {
  + clasificar(envasesAfuera: Registro, parametros: Registro,\n      ahora: FechaHora)
  + envasesAfuera(distribuidoraId: Identificador)
  + gestionarEnvasesNoDevueltos(): Cadena
  + parametros(distribuidoraId: Identificador)
  + procesarCaso(casoId: Identificador, parametros: Registro,\n      ahora: FechaHora)
}
class CylinderRecoveryNotifier <<fabricación pura>> {
  + alClienteAgrupado(usuario: Usuario, avisos: Registro)
  + escaladoAlAdmin(caso: CasoRecupero, contexto: Registro)
}
class CasoRecupero <<referencia>>
class Envase <<referencia>>
class TareaMantenimiento <<referencia>>
class Vehiculo <<referencia>>
class InvitacionRecompra <<referencia>>
class UpdateOrderStatusUseCase <<referencia>>

CylinderRecoveryService --> "1" CylinderRecoveryNotifier
MaintenancePlannerService --> "1" MaintenanceForecastService
MaintenancePlannerService --> "1" MaintenancePlannerNotifier
MaintenancePlannerService --> "1" PlannerContextService
RepurchaseForecastService --> "1" RepurchaseEstimatorService
RepurchaseForecastService --> "1" RepurchaseInvitationService
RepurchaseForecastService --> "1" RepurchaseNotifier
RepurchaseForecastService --> "1" RepurchaseSuggestionService
CylinderRecoveryService ..> CasoRecupero
CylinderRecoveryService ..> Envase
MaintenancePlannerService ..> TareaMantenimiento
MaintenancePlannerService ..> Vehiculo
RepurchaseInvitationService ..> "<<create>>" InvitacionRecompra
UpdateOrderStatusUseCase --> "1" FleetDispatchLockService

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
