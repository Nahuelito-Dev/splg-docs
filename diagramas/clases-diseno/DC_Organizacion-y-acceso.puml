@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam genericDisplay old
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #F3E9CF
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #DCEBDD
}
skinparam interface {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBDD
  FontSize 14
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide empty members

class Distribuidora {
  - nombre: Cadena
  - razonSocial: Cadena
  - cuit: Cadena
  - estado: EstadoDeDistribuidora
  + «create» Distribuidora(nombre: Cadena,\n      identificadorCorto: Cadena, razonSocial: Cadena,\n      cuit: Cadena, correo: Cadena, telefono: Cadena,\n      logo: Archivo, plan: Cadena)
  + assertDocumentoYCuilDisponibles(datos: Registro,\n      empleado: Empleado)
  + assertNombreDePuestoDisponible(nombre: Cadena,\n      puesto: PuestoDeTrabajo)
  + cambiarPredeterminado(depositoElegido: Deposito): Deposito
  + crearCaja(nombre: Cadena, tipoDeCaja: TipoDeCaja,\n      requiereSesion: Booleano): Caja
  + crearCategoriaDeCaja(nombre: Cadena,\n      sentido: SentidoDeCaja): CategoriaDeCaja
  + crearConfiguracion(proceso: ProcesoConfigurable,\n      parametros: Registro,\n      administrador: Usuario): ConfiguracionModulo
  + crearDeposito(nombre: Cadena, codigo: Cadena,\n      tipo: Cadena, direccion: Cadena): Deposito
  + crearFranja(nombre: Cadena, horaInicio: Hora,\n      horaFin: Hora, capacidad: Entero): FranjaHoraria
  + crearProveedor(razonSocial: Cadena, cuit: Cadena,\n      tipo: Cadena, datosDeContacto: Registro,\n      plazoDePago: Entero): Proveedor
  + crearPuesto(nombre: Cadena,\n      categoria: CategoriaDePuesto): PuestoDeTrabajo
  + crearReglaDeComision(empleado: Empleado,\n      producto: Producto, base: BaseDeComision,\n      valor: Decimal, vigenteDesde: Fecha): ReglaComision
  + darDeBaja()
  + definirZona(nombre: Cadena, poligono: Poligono,\n      recargo: Moneda, activa: Booleano): ZonaCobertura
  + getAdministradores(): Administrador[*]
  + getChoferes(pagina: Entero, limite: Entero): Chofer[*]
  + getChoferesActivos(pagina: Entero,\n      limite: Entero): Chofer[*]
  + getConfiguracion(proceso: ProcesoConfigurable): ConfiguracionModulo
  + getDeposito(depositoId: Identificador): Deposito
  + getDepositoPredeterminado(): Deposito
  + getDepositos(incluirInactivos: Booleano): Deposito[*]
  + getExigirCargaDeCamionAbierta(): Booleano
  + getFranjasActivas(): FranjaHoraria[*]
  + getProductosActivos(pagina: Entero, limite: Entero,\n      out total: Entero): Producto[*]
  + getProductosDisponibles(): Producto[*]
  + getProveedor(proveedorId: Identificador): Proveedor
  + getProveedores(termino: Cadena, tipo: Cadena,\n      incluirInactivos: Booleano): Proveedor[*]
  + getPuestos(): PuestoDeTrabajo[*]
  + getUbicacionesDeStock(): UbicacionDeStock[*]
  + getUbicacionPredeterminada(): UbicacionDeStock
  + getZonaQueCubre(latitud: Decimal,\n      longitud: Decimal): ZonaCobertura
  + getZonas(): ZonaCobertura[*]
  + habilitarCuentaCorriente(cliente: Cliente,\n      razonSocial: Cadena, cuit: Cadena,\n      condicionFiscal: CondicionFiscal,\n      limiteDeCredito: Moneda,\n      plazoEnDias: Entero): CuentaCorriente
  + incorporarEnvase(numeroDeSerie: Cadena,\n      tipoDeProducto: Cadena, deposito: Moneda): Envase
  + modificar(datos: Registro)
  + registrarEmpleado(datos: Registro,\n      puesto: PuestoDeTrabajo): Empleado
  + registrarNeumatico(datos: Registro): Neumatico
  + tieneProducto(tipo: Cadena): Booleano
  + tieneZonasActivas(): Booleano
  + validarCategoriaNueva(nombre: Cadena,\n      sentido: SentidoDeCaja)
  + validarCodigoSinUsar(codigo: Cadena)
  + validarCuitSinUsar(cuit: Cadena)
  + validarNombreDisponible(nombre: Cadena)
  + validarSinSolapamiento(empleado: Empleado,\n      producto: Producto, vigenteDesde: Fecha)
}
class ConfiguracionModulo {
  - modulo: ProcesoConfigurable
  - parametros: Registro
  - exigirCargaDeCamionAbierta: Booleano
  + «create» ConfiguracionModulo(proceso: ProcesoConfigurable,\n      parametros: Registro, administrador: Usuario)
  + actualizar(parametros: Registro, administrador: Usuario)
  + getExigirCargaDeCamionAbierta(): Booleano
}
class Usuario {
  - nombre: Cadena
  - correo: Cadena
  - telefono: Cadena
  - bloqueado: Booleano
  + «create» Usuario(datosPersonales: Registro,\n      rolChofer: TipoDeRol, cuenta: Registro)
  + «create» Usuario(datosPersonales: Registro, rol: Rol,\n      cuenta: Registro)
  + «create» Usuario(nombreCompleto: Cadena, correo: Cadena,\n      telefono: Cadena, tipoDeRol: TipoDeRol,\n      cuenta: Registro)
  + «create» Usuario(nombreCompleto: Cadena, correo: Cadena,\n      telefono: Cadena, rol: Rol, cuenta: Registro)
  + actualizarPerfil(datos: Registro)
  + bloquear()
  + calcularPromedio(): Decimal
  + calificar(pedido: Pedido, calificado: Usuario,\n      estrellas: Entero, comentario: Cadena): Calificacion
  + cambiarBloqueo(bloquear: Booleano)
  + cambiarCorreo(correoNuevo: Cadena)
  + darDeBaja()
  + estaHabilitado(): Booleano
  + getCalificacionesRecibidas(): Calificacion[*]
  + getChofer(): Chofer
  + getEmpleado(): Empleado
  + getPerfilDeChofer(): Chofer
  + getResumenDeCalificaciones(out cantidad: Entero): Decimal
  + getRol(): Rol
}
class Rol {
  - tipo: Cadena
  + «create» Rol(tipo: Cadena)
  + actualizar(datos: Registro)
  + validarEliminable(): Booleano
  + validarModificable()
}
class Administrador {
  + «create» Administrador(usuario: Usuario,\n      distribuidoraId: Identificador)
}
class AsientoAuditoria {
  - operacion: Cadena
  - recurso: Cadena
  - aplicacion: Cadena
  - resultado: ResultadoDeAuditoria
  - cambios: Registro
  - fecha: FechaHora
  + «create» AsientoAuditoria(autor: Usuario, rol: Rol,\n      distribuidoraId: Identificador, operacion: Cadena,\n      recurso: Cadena, origen: Cadena, resultado: Cadena,\n      codigo: Entero, motivo: Cadena)
  + depurarCredenciales()
}
class Auditoria {
  - entidadAfectada: Cadena
  - fechaYHora: FechaHora
  + «create» Auditoria(tipoDeAccion: Entero, autor: Usuario,\n      ip: Cadena, distribuidoraId: Identificador,\n      entidad: Cadena, registro: Cadena)
  + agregarDetalle(campo: Cadena, valorAnterior: Cadena,\n      valorNuevo: Cadena)
  + getDetalles(): DetalleAuditoria[*]
}
class DetalleAuditoria {
  - campo: Cadena
  - valorAnterior: Cadena
  - valorNuevo: Cadena
  + «create» DetalleAuditoria(campo: Cadena,\n      valorAnterior: Cadena, valorNuevo: Cadena)
}
class TipoAccionAuditoria {
  - nombre: Cadena
}
class Cliente <<referencia>>
class Chofer <<referencia>>
class Pedido <<referencia>>

Usuario <|-- Cliente : {overlapping, incomplete}
Usuario <|-- Chofer
Usuario <|-- Administrador
Usuario "0..*" -- "0..1" Rol : tiene asignado
Distribuidora "1" --> "0..*" Chofer : emplea
Distribuidora "0..1" -- "0..*" Administrador : emplea
Distribuidora "1" -- "0..*" Pedido : gestiona
Distribuidora "1" *--> "0..*" ConfiguracionModulo : parametriza
Usuario "0..1" -- "0..*" AsientoAuditoria : origina
Usuario "0..1" -- "0..*" Auditoria : realiza
Distribuidora "0..1" -- "0..*" Auditoria : delimita
Auditoria "1" *--> "0..*" DetalleAuditoria : detalla con
TipoAccionAuditoria "1" -- "0..*" Auditoria : clasifica
Usuario "0..1" -- "0..*" Pedido : confirmó el cobro de
Usuario "0..1" -- "0..*" Pedido : resolvió el cobro de

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml
