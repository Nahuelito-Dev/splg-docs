@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

class Producto {
  - tipo: Cadena
  - pesoEnKilos: Decimal
  - precio: Moneda
  - stock: Entero
  - activo: Booleano
  - costoPromedio: Moneda
  - deficitDeReservas: Decimal
  + «create» Producto(distribuidora: Distribuidora,\n      tipo: Cadena, peso: Decimal, precio: Moneda,\n      stockInicial: Entero, descripcion: Cadena)
  + actualizarPrecio(precio: Moneda)
  + agregarPromocion(cantidad: Entero, descuento: Decimal)
  + ajustarStock(diferenciaDeLlenas: Entero)
  + bloquearCompartido()
  + calcularDiferencia(llenasFisicas: Entero,\n      reservado: Entero): Entero
  + conciliarVendible(diferenciaEsperada: Entero): Entero
  + desactivar()
  + estaDisponibleEn(distribuidoraId: Identificador): Booleano
  + getCostoPromedio(): Moneda
  + getPrecio(): Moneda
  + precioPara(cantidad: Entero): Moneda
  + reactivar()
  + recalcularCostoPromedio(llenasRecibidas: Entero,\n      costoUnitario: Moneda): Moneda
  + reemplazarPromociones(promociones: Promocion[*])
  + reservar(cantidad: Entero): Entero
  + restaurarCostoPromedio(costoPrevio: Moneda,\n      llenasRecibidas: Entero): Moneda
  + restituir(cantidad: Entero)
  + tieneStock(cantidad: Entero): Booleano
  + validarHayDiferencia()
  + validarSinRepetir(promociones: Promocion[*])
}
class Promocion {
  - cantidad: Entero
  - descuento: Decimal
  + «create» Promocion(cantidad: Entero, descuento: Decimal)
}
class Envase {
  - numeroDeSerie: Cadena
  - estado: EstadoDelEnvase
  - montoDelDeposito: Moneda
  - /vencimiento: Fecha
  + «create» Envase(numeroDeSerie: Cadena,\n      tipoDeProducto: Cadena, deposito: Moneda)
  + abrirCaso()
  + actualizarVigencia(fecha: Fecha, vencimiento: Fecha)
  + darDeBaja()
  + despachar(pedido: Pedido, usuario: Usuario)
  + diasHastaElVencimiento(): Entero
  + entregarAlCliente(pedido: Pedido)
  + estaVigente(hoy: Fecha): Booleano
  + fueDevuelto(): Booleano
  + getMovimientos(): MovimientoEnvase[*]
  + getResumen(): Registro
  + getVigencia(out dias: Entero): Fecha
  + marcarParaRetiro(pedido: Pedido)
  + pasarA(estadoDestino: EstadoDelEnvase, pedido: Pedido,\n      cliente: Cliente, observacion: Cadena)
  + registrarRevision(fecha: Fecha, resultado: Cadena,\n      vencimiento: Fecha)
  + validarFechas(fecha: Fecha, vencimiento: Fecha)
  + validarTransicion(estadoDestino: EstadoDelEnvase)
}
class MovimientoEnvase {
  - desde: EstadoDelEnvase
  - hacia: EstadoDelEnvase
  - fecha: FechaHora
  + «create» MovimientoEnvase(estadoDestino: EstadoDelEnvase)
  + «create» MovimientoEnvase(pedido: Pedido,\n      usuario: Usuario, nota: Cadena)
  + «create» MovimientoEnvase(estadoOrigen: EstadoDelEnvase,\n      estadoDestino: EstadoDelEnvase, pedido: Pedido,\n      usuario: Usuario, observacion: Cadena)
}
class RevisionEnvase {
  - fecha: FechaHora
  - resultado: ResultadoDeRevision
  - proximaRevision: FechaHora
  + «create» RevisionEnvase(fecha: Fecha, resultado: Cadena,\n      vencimiento: Fecha)
}
class Distribuidora <<referencia>>
class Cliente <<referencia>>
class Pedido <<referencia>>
class Usuario <<referencia>>

Usuario <|-- Cliente : {overlapping, incomplete}
Distribuidora "1" -- "0..*" Producto : comercializa
Distribuidora "1" --> "0..*" Envase : posee
Cliente "0..*" -- "0..1" Producto : usa habitualmente
Producto "1" *--> "0..*" Promocion : ofrece
Producto "0..1" -- "0..*" Envase : describe
Envase "1" *--> "0..*" MovimientoEnvase : registra
Envase "1" *--> "0..*" RevisionEnvase : se somete a
Pedido "0..1" -- "0..*" MovimientoEnvase : origina
Usuario "0..1" -- "0..*" MovimientoEnvase : ejecuta
Cliente "0..1" -- "0..*" Envase : tiene en su poder
Pedido "0..1" -- "0..*" Envase : despacha
Pedido ..> Producto

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
