@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

class Pedido {
  - estado: EstadoPedido
  - /total: Moneda
  - modalidadDeEntrega: ModalidadDeEntrega
  - fechaAgendada: Fecha
  - metodoDePago: MetodoDePago
  - senia: Moneda
  - codigoDeEntrega: Cadena
  - nombreDeQuienRecibe: Cadena
  - documentoDeQuienRecibe: Cadena
  - vinculoConQuienRecibe: Cadena
  - estadoDelCobro: EstadoDelPago
  - cobroConfirmadoEl: FechaHora
  - cobroResueltoEl: FechaHora
  - notaDeResolucionDelCobro: Cadena
  - subtotalDeItems: Moneda
  - recargoDeZona: Moneda
  - recargoPorMedioDePago: Moneda
  - recargoExpress: Moneda
  - seniaPagada: Booleano
  - aceptadoEl: FechaHora
  - nombreDeLaZonaAplicada: Cadena
  - patenteDelVehiculo: Cadena
  - marcaDelVehiculo: Cadena
  - modeloDelVehiculo: Cadena
  + «create» Pedido(cliente: Cliente,\n      direccion: DireccionEntrega, franja: FranjaHoraria,\n      zona: ZonaCobertura, fechaAgendada: Fecha,\n      metodoDePago: MetodoDePago)
  + aceptar(chofer: Chofer, vehiculo: Vehiculo)
  + agregarItem(producto: Producto, cantidad: Entero,\n      precioUnitario: Moneda, subtotal: Moneda)
  + aplicarRecargoDePago()
  + calcularTotal(): Moneda
  + cancelar(motivo: Cadena)
  + confirmarCobro(chofer: Chofer)
  + confirmarSenia()
  + entregar(motivo: Cadena)
  + esDelChofer(chofer: Chofer): Booleano
  + esDelCliente(cliente: Cliente): Booleano
  + esReofertable(): Booleano
  + generarCodigoDeEntrega(): Cadena
  + getChofer(): Chofer
  + getCodigoDeEntrega(): Cadena
  + getEnvases(): Envase[*]
  + getEstadoDeLasOfertas(ahora: FechaHora,\n      enfriamiento: Entero): Cadena
  + getPago(identificadorDelPago: Identificador): Pago
  + getPuntoDeEntrega(): Coordenada
  + marcarPagado(identificadorDelPago: Identificador)
  + ofrecerA(chofer: Chofer, venceEn: Entero)
  + resolverTransferencia(administrador: Usuario,\n      recibida: Booleano, motivo: Cadena)
  + retirarOtrasOfertas(chofer: Chofer)
  + tieneOfertaVigente(): Booleano
  + transicionar(estadoDestino: EstadoPedido)
  + validarCobroPendiente()
  + validarCodigo(codigo: Cadena): Booleano
  + validarTransferencia(recibida: Booleano)
  + validarTransicion(estadoDestino: EstadoPedido)
}
class ItemPedido {
  - cantidad: Entero
  - precioUnitario: Moneda
  - /subtotal: Moneda
  + «create» ItemPedido(producto: Producto, cantidad: Entero,\n      precioUnitario: Moneda, subtotal: Moneda)
  + getSubtotal(): Moneda
  + restituirStock()
}
class CambioEstadoPedido {
  - desde: EstadoPedido
  - hacia: EstadoPedido
  - motivo: Cadena
  - fecha: FechaHora
  + «create» CambioEstadoPedido(estadoPedido: EstadoPedido = ninguno,\n      motivo: Cadena = ninguno,\n      aceptado: EstadoPedido = ninguno)
}
class Pago {
  - importe: Moneda
  - pasarela: Pasarela
  - estado: EstadoDelCobroEnPasarela
  - esSenia: Booleano
  - fecha: FechaHora
  + registrarResultado(identificadorDelPago: Identificador,\n      estado: Cadena)
}
class Reclamo {
  - motivo: Cadena
  - descripcion: Cadena
  - estado: EstadoDelReclamo
  - resolucion: Cadena
  - fotografia: Cadena
  + «create» Reclamo(pedido: Pedido, motivo: Cadena,\n      evidencia: Archivo)
  + resolver(resolucion: Cadena,\n      estadoDestino: EstadoDelReclamo)
  + validarTransicion(estadoDestino: EstadoDelReclamo)
}
class Cliente <<referencia>>
class Chofer <<referencia>>
class Producto <<referencia>>
class Usuario <<referencia>>
class Envase <<referencia>>

Usuario <|-- Cliente : {overlapping, incomplete}
Usuario <|-- Chofer
Cliente "1" <-- "0..*" Pedido : realiza
Pedido "1" *--> "1..*" ItemPedido : contiene
ItemPedido "0..*" --> "1" Producto : corresponde a
Pedido "1" *--> "0..*" CambioEstadoPedido : registra
Usuario "0..1" -- "0..*" CambioEstadoPedido : efectúa
Usuario "0..1" -- "0..*" Pedido : confirmó el cobro de
Usuario "0..1" -- "0..*" Pedido : resolvió el cobro de
Chofer "0..1" -- "0..*" Pedido : entrega
Pedido "1" -- "0..*" Pago : se salda con
Pedido "0..1" -- "0..*" Envase : despacha
Pedido "1" -- "0..*" Reclamo : origina
Cliente "1" --> "0..*" Reclamo : presenta

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
