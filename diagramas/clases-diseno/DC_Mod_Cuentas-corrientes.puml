@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class CustomerAccountService <<fachada>> {
  + consultarAntiguedadDeDeuda(): Registro
  + consultarEstadoDeCuenta(cuentaId: Identificador,\n      fechaDesde: Fecha,\n      fechaHasta: Fecha): AsientoCuentaCorriente[*]
  + habilitarCuentaCorriente(clienteId: Identificador,\n      razonSocial: Cadena, cuit: Cadena,\n      condicionFiscal: CondicionFiscal,\n      limiteDeCredito: Moneda,\n      plazoEnDias: Entero): CuentaCorriente
  + modificarCuentaCorriente(cuentaId: Identificador,\n      datos: Registro): CuentaCorriente
  + registrarAjusteDeCuentaCorriente(cuentaId: Identificador,\n      tipo: TipoDeAsiento, importe: Moneda,\n      motivo: Cadena): AsientoCuentaCorriente
  + registrarCargoDeCuentaCorriente(pedidoId: Identificador)
  + registrarPagoDeCuentaCorriente(cuentaId: Identificador,\n      importe: Moneda, medio: MedioDeCaja,\n      cajaId: Identificador): AsientoCuentaCorriente
}
class "Map<String, CuentaCorriente>" as Map_String_CuentaCorriente <<colección>> {
  + get(clave: Cadena): Registro
}
class "List<CuentaCorriente>" as List_CuentaCorriente <<colección>> {
  + getConSaldo(): CuentaCorriente[*]
}
class "List<AsientoCuentaCorriente>" as List_AsientoCuentaCorriente <<colección>> {
  + filtrar(cuentaCorriente: CuentaCorriente,\n      fechaDesde: Fecha,\n      fechaHasta: Fecha): AsientoCuentaCorriente[*]
}
class CuentaCorriente <<referencia>>
class AsientoCuentaCorriente <<referencia>>
class "Map<String, Cliente>" as Map_String_Cliente <<referencia>>
class "Map<String, Pedido>" as Map_String_Pedido <<referencia>>
class "Map<String, RendicionChofer>" as Map_String_RendicionChofer <<referencia>>
class CashLedgerService <<referencia>>
class Cliente <<referencia>>
class Distribuidora <<referencia>>
class Pedido <<referencia>>
class RendicionChofer <<referencia>>

Map_String_CuentaCorriente "1" o--> "0..*" CuentaCorriente
List_AsientoCuentaCorriente "1" o--> "0..*" AsientoCuentaCorriente
List_CuentaCorriente "1" o--> "0..*" CuentaCorriente
CustomerAccountService --> "1" List_AsientoCuentaCorriente
CustomerAccountService --> "1" List_CuentaCorriente
CustomerAccountService --> "1" Map_String_Cliente
CustomerAccountService --> "1" Map_String_CuentaCorriente
CustomerAccountService --> "1" Map_String_Pedido
CustomerAccountService --> "1" Map_String_RendicionChofer
CustomerAccountService ..> CashLedgerService
CustomerAccountService ..> Cliente
CustomerAccountService ..> CuentaCorriente
CustomerAccountService ..> Distribuidora
CustomerAccountService ..> Pedido
CustomerAccountService ..> RendicionChofer

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
