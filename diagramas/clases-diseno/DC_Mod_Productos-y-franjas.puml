@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam genericDisplay old
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #F3E9CF
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #DCEBDD
}
skinparam interface {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBDD
  FontSize 14
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class GasCylinderService <<fachada>> {
  + actualizarProducto(productoId: Identificador,\n      datos: Registro): Producto
  + actualizarStock(productoId: Identificador,\n      variacion: Entero): Producto
  + consultarCatalogo(pagina: Entero, limite: Entero,\n      distribuidora: Cadena,\n      out total: Entero): Producto[*]
  + consultarProducto(productoId: Identificador): Producto
  + consultarProductosDisponibles(distribuidora: Cadena,\n      out mediosDePago: MetodoDePago[*]): Producto[*]
  + consultarProductosInactivos(): Producto[*]
  + crearProducto(tipo: Cadena, peso: Decimal,\n      precio: Moneda, stockInicial: Entero,\n      descripcion: Cadena, promociones: Lista): Producto
  + desactivarProducto(productoId: Identificador): Cadena
  + reactivarProducto(productoId: Identificador): Producto
}
class "Map<String, Producto>" as Map_String_Producto <<colección>> {
  + get(clave: Cadena): Producto
}
class "List<Producto>" as List_Producto <<colección>> {
  + buscarInactivos(): Producto[*]
  + getActivos(): Producto[*]
}
class TimeSlotService <<fachada>> {
  + consultarDisponibilidadDeFranjas(fecha: Fecha,\n      distribuidora: Cadena): Registro
  + consultarFranjasHorarias(): FranjaHoraria[*]
  + crearFranjaHoraria(nombre: Cadena, horaInicio: Hora,\n      horaFin: Hora, capacidad: Entero): FranjaHoraria
  + eliminarFranjaHoraria(franjaId: Identificador): FranjaHoraria
  + listarFranjas(distribuidora: Cadena): FranjaHoraria[*]
  + modificarFranjaHoraria(franjaId: Identificador,\n      nombre: Cadena, horaInicio: Hora, horaFin: Hora,\n      capacidad: Entero): FranjaHoraria
}
class "Map<String, FranjaHoraria>" as Map_String_FranjaHoraria <<colección>> {
  + get(clave: Cadena): FranjaHoraria
}
class Producto <<referencia>>
class FranjaHoraria <<referencia>>
class "Map<String, Distribuidora>" as Map_String_Distribuidora <<referencia>>
class Distribuidora <<referencia>>

Map_String_Producto "1" o--> "0..*" Producto
Map_String_FranjaHoraria "1" o--> "0..*" FranjaHoraria
List_Producto "1" o--> "0..*" Producto
GasCylinderService --> "1" List_Producto
GasCylinderService --> "1" Map_String_Distribuidora
GasCylinderService --> "1" Map_String_Producto
TimeSlotService --> "1" Map_String_Distribuidora
TimeSlotService --> "1" Map_String_FranjaHoraria
GasCylinderService ..> Distribuidora
GasCylinderService ..> "<<create>>" Producto
TimeSlotService ..> Distribuidora
TimeSlotService ..> FranjaHoraria

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran sólo como referencia.
endlegend
@enduml
