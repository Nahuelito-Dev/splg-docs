@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam genericDisplay old
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #F3E9CF
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #DCEBDD
}
skinparam interface {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBDD
  FontSize 14
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide empty members

class Deposito {
  - nombre: Cadena
  - codigo: Cadena
  - tipo: TipoDeDeposito
  - direccion: Cadena
  - predeterminado: Booleano
  - activo: Booleano
  + «create» Deposito(nombre: Cadena, codigo: Cadena,\n      tipo: Cadena, direccion: Cadena)
  + actualizar(datos: Registro): Deposito
  + bloquearCompartido()
  + darDeBaja()
  + estaActivo(): Booleano
  + fijarMinimo(producto: Producto, minimoDeLlenas: Entero)
  + getLlenas(producto: Producto): CondicionDeStock
  + getUbicacion(): UbicacionDeStock
  + getUmbral(producto: Producto): UmbralDeStock
  + marcarPredeterminado()
  + quitarPredeterminado(): Booleano
  + quitarUmbrales()
  + tieneLlenas(producto: Producto,\n      cantidad: Entero): Booleano
  + validarCodigoSinUsar(codigo: Cadena)
  + validarNoEsElPredeterminado()
  + validarPuedeDesactivarse(activo: Booleano)
  + validarQueEstaActivo(): Booleano
  + validarSinConteoInicial(): Booleano
  + validarSinSaldo(conSaldo: Booleano)
}
class UbicacionDeStock {
  - tipo: TipoDeUbicacion
  + «create» UbicacionDeStock(depositoDeStock: Deposito)
  + acreditar(producto: Producto,\n      condicionDestino: CondicionDeStock,\n      cantidad: Entero)
  + ajustar(motivoConciliacion: MotivoDeAjuste, nota: Cadena,\n      correccionDeVendible: Entero,\n      administrador: Usuario): AjusteDeStock
  + ajustar(motivo: Cadena, nota: Cadena, items: Registro,\n      lote: Identificador,\n      administrador: Usuario): AjusteDeStock
  + ajustar(motivoConteoInicial: MotivoDeAjuste,\n      nota: Cadena,\n      renglonesDeAjuste: ItemAjusteDeStock[*],\n      lote: Identificador,\n      administrador: Usuario): AjusteDeStock
  + descontar(producto: Producto,\n      condicionOrigen: CondicionDeStock,\n      cantidad: Entero): Booleano
  + diferenciasContra(items: Registro): ItemAjusteDeStock[*]
  + getSaldos(productoId: Identificador): SaldoDeStock[*]
  + tieneSaldo(): Booleano
  + validarTransferenciaA(ubicacionDestino: UbicacionDeStock): Booleano
  + validarVacia()
}
class SaldoDeStock {
  - condicion: CondicionDeStock
  - cantidad: Entero
  + «create» SaldoDeStock(producto: Producto,\n      condicionDestino: CondicionDeStock,\n      cantidad: Entero)
  + getCantidad(): Entero
  + restar(cantidad: Entero)
  + sumar(cantidad: Entero)
}
class MovimientoDeStock {
  - cantidad: Entero
  - condicionDeOrigen: CondicionDeStock
  - condicionDeDestino: CondicionDeStock
  - motivo: MotivoDeMovimiento
  - documentoDeOrigen: Registro
  - observacion: Cadena
  - fecha: FechaHora
  + «create» MovimientoDeStock(ubicacionOrigen: UbicacionDeStock,\n      ubicacionDestino: UbicacionDeStock,\n      producto: Producto,\n      condicionOrigen: CondicionDeStock,\n      condicionDestino: CondicionDeStock,\n      cantidad: Entero, motivo: Cadena)
  + getDetalle()
  + validarEsDeTransferencia(): Booleano
}
class UmbralDeStock {
  - minimoDeLlenas: Entero
  - avisadoEl: FechaHora
  + «create» UmbralDeStock(producto: Producto,\n      minimoDeLlenas: Entero)
  + actualizar(minimoDeLlenas: Entero)
  + estaPorDebajoDelMinimo(): Booleano
  + getLlenasActuales()
  + limpiarAviso()
  + marcarAvisado(ahora: FechaHora)
}
class AjusteDeStock {
  - numero: Entero
  - motivo: MotivoDeAjuste
  - nota: Cadena
  - fecha: FechaHora
  + «create» AjusteDeStock(motivoConciliacion: MotivoDeAjuste,\n      nota: Cadena, administrador: Usuario)
  + «create» AjusteDeStock(motivo: Cadena, nota: Cadena,\n      lote: Identificador, administrador: Usuario)
  + «create» AjusteDeStock(motivoConteoInicial: MotivoDeAjuste,\n      nota: Cadena, lote: Identificador,\n      administrador: Usuario)
  + getDetalle()
  + getRenglones(): ItemAjusteDeStock[*]
}
class ItemAjusteDeStock {
  - condicion: CondicionDeStock
  - diferencia: Entero
  + «create» ItemAjusteDeStock(producto: Producto,\n      condicionDeStock: CondicionDeStock,\n      diferencia: Entero)
}
class Producto <<referencia>>
class Vehiculo <<referencia>>
class Usuario <<referencia>>
class Distribuidora <<referencia>>

Distribuidora "1" --> "0..*" Deposito : dispone de
Deposito "1" --> "0..1" UbicacionDeStock : se registra como {xor}
Vehiculo "1" -- "0..1" UbicacionDeStock : se registra como {xor}
UbicacionDeStock "1" *--> "0..*" SaldoDeStock : acumula
SaldoDeStock "0..*" -- "1" Producto : corresponde a
MovimientoDeStock "0..*" -- "1" Producto : corresponde a
MovimientoDeStock "0..*" -- "0..1" UbicacionDeStock : sale de
MovimientoDeStock "0..*" -- "0..1" UbicacionDeStock : entra en
Usuario "0..1" -- "0..*" MovimientoDeStock : ejecuta
Deposito "1" *-- "0..*" UmbralDeStock : fija
UmbralDeStock "0..*" -- "1" Producto : controla
UbicacionDeStock "1" --> "0..*" AjusteDeStock : se corrige con
AjusteDeStock "1" *--> "1..*" ItemAjusteDeStock : contiene
ItemAjusteDeStock "0..*" -- "1" Producto : corresponde a
Usuario "1" -- "0..*" AjusteDeStock : registra
MovimientoDeStock "0..1" -- "0..1" MovimientoDeStock : corrige a

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml
