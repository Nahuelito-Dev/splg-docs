@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class NotificationsService <<fachada>> {
  + enviarNotificacionDePrueba(token: Cadena, titulo: Cadena,\n      mensaje: Cadena): Cadena
  + escalateToAdmin(caso: CasoRecupero)
  + reenviarConfirmacionDePedido(usuario: Usuario,\n      pedidoId: Identificador): Cadena
  + sendBatchOffer(chofer: Chofer, recorrido: LoteRecorrido)
  + sendOfferPushToDriver(chofer: Chofer, pedido: Pedido)
  + sendOrderConfirmation(cliente: Cliente, pedido: Pedido)
  + sendRecoveryStep(caso: CasoRecupero, escalon: Entero)
  + sendRepurchaseInvitation(cliente: Cliente,\n      invitacion: InvitacionRecompra)
  + sendWindowProposal(propuesta: PropuestaVentanaTaller)
}
class EmailService <<fachada>> {
  + cambiarCorreo(correoActual: Cadena,\n      correoNuevo: Cadena): Cadena
  + probarServicioDeCorreo(destinatario: Cadena): Cadena
  + solicitarRecuperacionDeClave(correo: Cadena): Cadena
}
interface EmailSenderPort <<puerto>> {
  + send(destinatario: Cadena = ninguno,\n      administrador: Usuario = ninguno,\n      vencimientos: Registro = ninguno,\n      administradores: Administrador[*] = ninguno,\n      detalle: Registro = ninguno,\n      rendiciones: RendicionChofer[*] = ninguno,\n      verificacionDeCorreo: Registro = ninguno)
}
class FirebaseAuthPort <<referencia>>
class "Map<String, Usuario>" as Map_String_Usuario <<referencia>>
class FcmPort <<referencia>>
class "Map<String, Cliente>" as Map_String_Cliente <<referencia>>
class Usuario <<referencia>>
class Cliente <<referencia>>

EmailService --> "1" EmailSenderPort
EmailService --> "1" FirebaseAuthPort
EmailService --> "1" Map_String_Usuario
NotificationsService --> "1" FcmPort
NotificationsService --> "1" Map_String_Cliente
EmailService ..> Usuario
NotificationsService ..> Cliente

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
