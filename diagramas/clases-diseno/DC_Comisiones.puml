@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

class ReglaComision {
  - base: BaseDeComision
  - valor: Decimal
  - vigenteDesde: Fecha
  - vigenteHasta: Fecha
  - activa: Booleano
  + «create» ReglaComision(empleado: Empleado,\n      producto: Producto, base: BaseDeComision,\n      valor: Decimal, vigenteDesde: Fecha)
  + calcularImporte(pedido: Pedido): Moneda
  + modificar(datos: Registro)
  + validarSinSolapamiento(datos: Registro)
}
class AsientoComision {
  - tipo: TipoDeAsientoDeComision
  - importe: Moneda
  - fecha: FechaHora
  - descripcion: Cadena
  + «create» AsientoComision(tipoDeAsientoDeComision: TipoDeAsientoDeComision = ninguno,\n      importe: Moneda = ninguno,\n      rendicion: RendicionChofer = ninguno,\n      pedido: Pedido = ninguno,\n      regla: ReglaComision = ninguno,\n      saldoDeudor: Moneda = ninguno,\n      liquidacion: LiquidacionComisiones = ninguno)
  + asignarALiquidacion(liquidacion: LiquidacionComisiones)
  + liberar()
}
class LiquidacionComisiones {
  - numero: Entero
  - periodoDesde: Fecha
  - periodoHasta: Fecha
  - bruto: Moneda
  - deducciones: Moneda
  - neto: Moneda
  - estado: EstadoDeLaLiquidacion
  - aprobadaEl: FechaHora
  - pagadaEl: FechaHora
  + «create» LiquidacionComisiones(fechaDesde: Fecha,\n      fechaHasta: Fecha)
  + anular()
  + aprobar(administrador: Usuario)
  + calcularTotales()
  + cerrarSinPago()
  + incluir(asientoDeComision: AsientoComision)
  + marcarAprobada()
  + pagar(caja: Caja): Moneda
  + validarAprobada()
  + validarBorrador()
  + validarNoPagada()
}
class Empleado <<referencia>>
class Producto <<referencia>>
class Pedido <<referencia>>
class MovimientoDeCaja <<referencia>>
class Distribuidora <<referencia>>
class RendicionChofer <<referencia>>

Distribuidora "1" *--> "0..*" ReglaComision : define
ReglaComision "0..*" <-- "0..1" Empleado : se aplica a
ReglaComision "0..*" -- "0..1" Producto : se aplica a
Empleado "1" *--> "0..*" AsientoComision : devenga
Empleado "1" *-- "0..*" LiquidacionComisiones : percibe
AsientoComision "0..*" -- "0..1" Pedido : corresponde a
ReglaComision "0..1" -- "0..*" AsientoComision : determina
LiquidacionComisiones "0..1" --> "0..*" AsientoComision : incluye
RendicionChofer "0..1" -- "0..*" AsientoComision : origina
LiquidacionComisiones "0..1" -- "0..1" MovimientoDeCaja : se paga con

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
