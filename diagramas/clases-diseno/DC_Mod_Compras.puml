@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam genericDisplay old
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #F3E9CF
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #DCEBDD
}
skinparam interface {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBDD
  FontSize 14
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class SupplierService <<fachada>> {
  + actualizarProveedor(proveedorId: Identificador,\n      datos: Registro): Proveedor
  + consultarProveedor(proveedorId: Identificador): Proveedor
  + consultarProveedores(termino: Cadena, tipo: Cadena,\n      incluirInactivos: Booleano): Proveedor[*]
  + darDeBajaProveedor(proveedorId: Identificador)
  + registrarProveedor(razonSocial: Cadena, cuit: Cadena,\n      tipo: Cadena, datosDeContacto: Registro,\n      plazoDePago: Entero): Proveedor
}
class "Map<String, Proveedor>" as Map_String_Proveedor <<colección>> {
  + get(clave: Cadena): Proveedor
}
class PurchaseOrderService <<fachada>> {
  + cancelarOrdenDeCompra(ordenId: Identificador,\n      motivo: Cadena): OrdenDeCompra
  + cerrarOrdenDeCompraConFaltante(ordenId: Identificador,\n      motivo: Cadena): OrdenDeCompra
  + emitirOrdenDeCompra(proveedorId: Identificador,\n      depositoId: Identificador, items: Lista,\n      fechaEsperada: Fecha): OrdenDeCompra
  + enviarOrdenDeCompra(ordenId: Identificador): OrdenDeCompra
  + modificarOrdenDeCompra(ordenId: Identificador,\n      datos: Registro): OrdenDeCompra
}
class "Map<String, OrdenDeCompra>" as Map_String_OrdenDeCompra <<colección>> {
  + get(clave: Cadena): OrdenDeCompra
}
class ReceivePurchaseUseCase <<controlador>> {
  + registrarRecepcionDeCompra(ordenId: Identificador,\n      proveedorId: Identificador,\n      depositoId: Identificador,\n      tipoDeComprobante: Cadena,\n      numeroDeComprobante: Cadena,\n      items: Lista): RecepcionDeCompra
}
class VoidPurchaseReceiptUseCase <<controlador>> {
  + anularRecepcionDeCompra(recepcionId: Identificador,\n      motivo: Cadena): RecepcionDeCompra
}
class "Map<String, RecepcionDeCompra>" as Map_String_RecepcionDeCompra <<colección>> {
  + get(clave: Cadena): RecepcionDeCompra
}
class PurchaseReceiptService <<fachada>> {
  + marcarPagoDeRecepcion(recepcionId: Identificador,\n      estadoDePago: Cadena): RecepcionDeCompra
}
class PurchaseQueryService <<fachada>> {
  + consultarCostoPromedio(): Registro
  + consultarHistorialDeCompras(proveedorId: Identificador,\n      desde: Fecha, hasta: Fecha): Registro
  + consultarOrdenDeCompra(ordenId: Identificador): OrdenDeCompra
  + consultarOrdenesDeCompra(estado: Cadena,\n      proveedorId: Identificador, desde: Fecha,\n      hasta: Fecha): OrdenDeCompra[*]
  + consultarPendienteDeRecibir(ordenId: Identificador): EstadoPedido
  + consultarRecepcionDeCompra(recepcionId: Identificador): RecepcionDeCompra
  + consultarRecepcionesDeCompra(proveedorId: Identificador,\n      ordenId: Identificador, estadoDePago: Cadena,\n      estado: Cadena, desde: Fecha,\n      hasta: Fecha): RecepcionDeCompra[*]
}
class "List<OrdenDeCompra>" as List_OrdenDeCompra <<colección>> {
  + buscar(estado: Cadena, proveedorId: Identificador,\n      desde: FechaHora,\n      hasta: FechaHora): OrdenDeCompra[*]
}
class "List<RecepcionDeCompra>" as List_RecepcionDeCompra <<colección>> {
  + buscar(proveedorId: Identificador,\n      ordenId: Identificador, estadoDePago: Cadena,\n      estado: Cadena, desde: FechaHora,\n      hasta: FechaHora): RecepcionDeCompra[*]
}
class Proveedor <<referencia>>
class OrdenDeCompra <<referencia>>
class RecepcionDeCompra <<referencia>>
class "List<Producto>" as List_Producto <<referencia>>
class Distribuidora <<referencia>>
class Producto <<referencia>>
class StockLedgerService <<referencia>>
class ItemRecepcion <<referencia>>

Map_String_Proveedor "1" o--> "0..*" Proveedor
Map_String_OrdenDeCompra "1" o--> "0..*" OrdenDeCompra
Map_String_RecepcionDeCompra "1" o--> "0..*" RecepcionDeCompra
List_OrdenDeCompra "1" o--> "0..*" OrdenDeCompra
List_RecepcionDeCompra "1" o--> "0..*" RecepcionDeCompra
PurchaseOrderService --> "1" Map_String_OrdenDeCompra
PurchaseQueryService --> "1" List_OrdenDeCompra
PurchaseQueryService --> "1" List_Producto
PurchaseQueryService --> "1" List_RecepcionDeCompra
PurchaseQueryService --> "1" Map_String_OrdenDeCompra
PurchaseQueryService --> "1" Map_String_Proveedor
PurchaseQueryService --> "1" Map_String_RecepcionDeCompra
PurchaseReceiptService --> "1" Map_String_RecepcionDeCompra
ReceivePurchaseUseCase --> "1" Map_String_OrdenDeCompra
SupplierService --> "1" Map_String_Proveedor
VoidPurchaseReceiptUseCase --> "1" Map_String_RecepcionDeCompra
List_OrdenDeCompra ..> OrdenDeCompra
List_RecepcionDeCompra ..> RecepcionDeCompra
PurchaseOrderService ..> Distribuidora
PurchaseOrderService ..> OrdenDeCompra
PurchaseOrderService ..> Proveedor
PurchaseQueryService ..> OrdenDeCompra
PurchaseQueryService ..> Proveedor
PurchaseQueryService ..> RecepcionDeCompra
PurchaseReceiptService ..> RecepcionDeCompra
ReceivePurchaseUseCase ..> OrdenDeCompra
ReceivePurchaseUseCase ..> Producto
ReceivePurchaseUseCase ..> "<<create>>" RecepcionDeCompra
ReceivePurchaseUseCase ..> StockLedgerService
SupplierService ..> Distribuidora
SupplierService ..> Proveedor
VoidPurchaseReceiptUseCase ..> ItemRecepcion
VoidPurchaseReceiptUseCase ..> OrdenDeCompra
VoidPurchaseReceiptUseCase ..> Producto
VoidPurchaseReceiptUseCase ..> RecepcionDeCompra
VoidPurchaseReceiptUseCase ..> StockLedgerService

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran sólo como referencia.
endlegend
@enduml
