@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class "Map<String, Usuario>" as Map_String_Usuario <<colección>> {
  + get(clave: Cadena): Usuario
  + verificarDisponibilidad(correo: Cadena = ninguno,\n      telefono: Cadena = ninguno,\n      correoNuevo: Cadena = ninguno): Booleano
}
class UsersService <<fachada>> {
  + actualizarPerfil(usuario: Usuario,\n      datos: Registro): Usuario
  + bloquearUsuario(usuario: Usuario): Usuario
  + buscarUsuarioPorCorreo(correo: Cadena): Usuario
  + buscarUsuarioPorTelefono(telefono: Cadena): Usuario
  + consultarPerfil(usuario: Usuario): Usuario
  + desbloquearUsuario(usuario: Usuario): Usuario
  + editarDatosDelCliente(cliente: Cliente,\n      cambios: Registro): Usuario
  + eliminarUsuario(usuario: Usuario): Cadena
  + listarUsuarios(pagina: Entero, limite: Entero,\n      textoDeBusqueda: Cadena): Registro
}
class "List<Usuario>" as List_Usuario <<colección>> {
  + buscar(textoDeBusqueda: Cadena, pagina: Entero,\n      limite: Entero): Registro
}
class RoleService <<fachada>> {
  + actualizarRol(rolId: Identificador, datos: Registro): Rol
  + crearRol(tipo: Cadena): Rol
  + eliminarRol(rolId: Identificador)
  + listarRoles(): Rol[*]
}
class "List<Rol>" as List_Rol <<colección>> {
  + listar(): Rol[*]
}
class "Map<String, Rol>" as Map_String_Rol <<colección>> {
  + get(clave: Cadena): Rol
  + remove(clave: Cadena)
}
class "List<Administrador>" as List_Administrador <<colección>> {
  + existeAdministradorGeneral(): Booleano
  + listar(): Administrador[*]
}
class AdminService <<fachada>> {
  + buscarAdministrador(termino: Cadena): Usuario
  + darDeBajaAdministrador(administradorId: Identificador): Cadena
  + listarAdministradores(): Administrador[*]
  + modificarAdministrador(administradorId: Identificador,\n      nombreCompleto: Cadena, telefono: Cadena): Usuario
}
class "Map<String, Administrador>" as Map_String_Administrador <<colección>> {
  + get(clave: Cadena): Usuario
}
class AuditService <<fachada>> {
  + consultarAuditoria(autor: Identificador,\n      tipoDeRecurso: Cadena, recurso: Cadena,\n      desde: FechaHora, hasta: FechaHora,\n      resultado: Cadena, limite: Entero,\n      desplazamiento: Entero): Registro
}
class "List<AsientoAuditoria>" as List_AsientoAuditoria <<colección>> {
  + filtrar(autor: Usuario, tipoDeRecurso: Cadena,\n      recurso: Cadena, desde: FechaHora,\n      hasta: FechaHora, resultado: Cadena,\n      limite: Entero,\n      desplazamiento: Entero): AsientoAuditoria[*]
}
class DataAuditService <<fachada>> {
  + consultarAuditoriaDeDatos(entidad: Cadena,\n      registro: Cadena, autor: Identificador,\n      tipoDeAccion: Entero, desde: FechaHora,\n      hasta: FechaHora, pagina: Entero,\n      limite: Entero): Registro
}
class "List<Auditoria>" as List_Auditoria <<colección>> {
  + filtrar(entidad: Cadena, registro: Cadena,\n      autor: Usuario, tipoDeAccion: Entero,\n      desde: FechaHora, hasta: FechaHora, pagina: Entero,\n      limite: Entero): Auditoria[*]
}
class Usuario <<referencia>>
class Administrador <<referencia>>
class Rol <<referencia>>
class AsientoAuditoria <<referencia>>
class Auditoria <<referencia>>
class FirebaseAuthPort <<referencia>>
class Chofer <<referencia>>
class UbicacionGPS <<referencia>>

Map_String_Usuario "1" o--> "0..*" Usuario
List_Usuario "1" o--> "0..*" Usuario
List_Administrador "1" o--> "0..*" Administrador
Map_String_Administrador "1" o--> "0..*" Administrador
List_Rol "1" o--> "0..*" Rol
List_AsientoAuditoria "1" o--> "0..*" AsientoAuditoria
List_Auditoria "1" o--> "0..*" Auditoria
Map_String_Rol "1" o--> "0..*" Rol
AdminService --> "1" List_Administrador
AdminService --> "1" Map_String_Administrador
AuditService --> "1" List_AsientoAuditoria
DataAuditService --> "1" List_Auditoria
RoleService --> "1" List_Rol
RoleService --> "1" Map_String_Rol
UsersService --> "1" FirebaseAuthPort
UsersService --> "1" List_Usuario
UsersService --> "1" Map_String_Usuario
AdminService ..> Usuario
DataAuditService ..> Auditoria
RoleService ..> "<<create>>" Rol
UsersService ..> Chofer
UsersService ..> UbicacionGPS
UsersService ..> Usuario

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
