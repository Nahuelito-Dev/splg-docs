@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class FleetMaintenancePlannerService <<fachada>> {
  + aceptarVentanaDeMantenimiento(propuestaId: Identificador): PropuestaVentanaTaller
  + confirmarVentanaDeTaller(tareaId: Identificador,\n      ventanaElegida: Registro,\n      gastoEstimado: Moneda): TareaMantenimiento
  + planificarMantenimientoDeFlota()
}
class DemandForecastService <<fabricación pura>> {
  + demandaProyectada(ventanas: PropuestaVentanaTaller[*]): Registro
}
class FleetCoverageService <<fabricación pura>> {
  + ventanasFactibles(vehiculo: Vehiculo,\n      ventanas: PropuestaVentanaTaller[*]): PropuestaVentanaTaller[*]
}
interface FleetAvailabilityPort <<puerto>> {
  + blockVehicleWindow(tarea: TareaMantenimiento,\n      ventanaElegida: PropuestaVentanaTaller)
}
class "Map<String, PropuestaVentanaTaller>" as Map_String_PropuestaVentanaTaller <<colección>> {
  + get(clave: Cadena): PropuestaVentanaTaller
}
class PropuestaVentanaTaller <<referencia>>
class "Map<String, TareaMantenimiento>" as Map_String_TareaMantenimiento <<referencia>>
class NotificationsService <<referencia>>
class TareaMantenimiento <<referencia>>
class Vehiculo <<referencia>>

Map_String_PropuestaVentanaTaller "1" o--> "0..*" PropuestaVentanaTaller
FleetMaintenancePlannerService --> "1" DemandForecastService
FleetMaintenancePlannerService --> "1" FleetAvailabilityPort
FleetMaintenancePlannerService --> "1" FleetCoverageService
FleetMaintenancePlannerService --> "1" Map_String_PropuestaVentanaTaller
FleetMaintenancePlannerService --> "1" Map_String_TareaMantenimiento
FleetMaintenancePlannerService --> "1" NotificationsService
FleetMaintenancePlannerService ..> PropuestaVentanaTaller
FleetMaintenancePlannerService ..> TareaMantenimiento
FleetMaintenancePlannerService ..> Vehiculo

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
