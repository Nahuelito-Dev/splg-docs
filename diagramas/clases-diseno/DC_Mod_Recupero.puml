@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class CylinderRecoveryService <<fachada>> {
  + aceptarRetiroEnLaEntrega(ofertaId: Identificador): Envase
  + gestionarEnvasesNoDevueltos()
  + resolverCasoDeRecupero(casoId: Identificador,\n      decision: Cadena): CasoRecupero
}
class DepositLedgerService <<fabricación pura>> {
  + registerDecision(caso: CasoRecupero, decision: Cadena)
}
class "Map<String, AvisoRecupero>" as Map_String_AvisoRecupero <<colección>> {
  + get(clave: Cadena): AvisoRecupero
}
class "Map<String, CasoRecupero>" as Map_String_CasoRecupero <<colección>> {
  + get(clave: Cadena): CasoRecupero
}
class AvisoRecupero <<referencia>>
class CasoRecupero <<referencia>>
class CylinderLifecyclePort <<referencia>>
class NotificationsService <<referencia>>
class Envase <<referencia>>
class Pedido <<referencia>>

Map_String_AvisoRecupero "1" o--> "0..*" AvisoRecupero
Map_String_CasoRecupero "1" o--> "0..*" CasoRecupero
CylinderRecoveryService --> "1" CylinderLifecyclePort
CylinderRecoveryService --> "1" DepositLedgerService
CylinderRecoveryService --> "1" Map_String_AvisoRecupero
CylinderRecoveryService --> "1" Map_String_CasoRecupero
CylinderRecoveryService --> "1" NotificationsService
CylinderRecoveryService ..> AvisoRecupero
CylinderRecoveryService ..> CasoRecupero
CylinderRecoveryService ..> Envase
CylinderRecoveryService ..> Pedido

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
