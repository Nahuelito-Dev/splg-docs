@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam genericDisplay old
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #F3E9CF
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #DCEBDD
}
skinparam interface {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBDD
  FontSize 14
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class PaymentsService <<fachada>> {
  + crearCheckoutDePago(pedidoId: Identificador,\n      metodoDePago: MetodoDePago): Cadena
}
interface PaymentGatewayPort <<interface>> <<puerto>> {
  + createCheckout(pedido: Pedido, items: ItemPedido[*],\n      pagador: Cadena): Cadena
  + getPayment(identificadorDelPago: Identificador): Cadena
  + refundPayment(pago: Pago, importe: Moneda): Cadena
  + verifyWebhookSignature(firma: Cadena,\n      identificadorDelPago: Identificador): Booleano
}
class RefundPaymentUseCase <<controlador>> {
  + reintegrarPagoDelPedido(pedidoId: Identificador,\n      importe: Moneda): Booleano
}
class ConfirmPaymentUseCase <<controlador>> {
  + notificarResultadoDePago(tipoDeNotificacion: Cadena,\n      identificadorDelPago: Cadena, firma: Cadena)
}
class RefundPaymentUseCase <<controlador>> {
  + reintegrarPagoDelPedido(pedidoId: Identificador,\n      importe: Moneda): Booleano
}
class ReservationService <<fachada>> {
  + activarReservasDelDia()
  + confirmarSenia(pedidoId: Identificador): Pedido
  + expirarPedidosSinPagar()
  + expirarReservasSinSenia()
  + listarReservas(): Pedido[*]
}
class "Map<String, Pedido>" as Map_String_Pedido <<referencia>>
class RealtimeDispatchPort <<referencia>>
class "List<Pedido>" as List_Pedido <<referencia>>
class Pedido <<referencia>>
class Pago <<referencia>>
class NotificationPort <<referencia>>

ConfirmPaymentUseCase --> "1" Map_String_Pedido
PaymentsService --> "1" Map_String_Pedido
PaymentsService --> "1" PaymentGatewayPort
RefundPaymentUseCase --> "1" Map_String_Pedido
RefundPaymentUseCase --> "1" PaymentGatewayPort
RefundPaymentUseCase --> "1" RealtimeDispatchPort
ReservationService --> "1" List_Pedido
ReservationService --> "1" Map_String_Pedido
ConfirmPaymentUseCase ..> NotificationPort
ConfirmPaymentUseCase ..> Pago
ConfirmPaymentUseCase ..> PaymentGatewayPort
ConfirmPaymentUseCase ..> Pedido
ConfirmPaymentUseCase ..> RealtimeDispatchPort
PaymentsService ..> Pago : <<create>>
PaymentsService ..> Pedido
RefundPaymentUseCase ..> Pago
RefundPaymentUseCase ..> Pedido
ReservationService ..> Pedido

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran sólo como referencia.
endlegend
@enduml
