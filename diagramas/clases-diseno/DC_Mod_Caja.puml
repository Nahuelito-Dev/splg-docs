@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class CashBoxService <<fachada>> {
  + abrirCaja(cajaId: Identificador,\n      montoInicial: Moneda): SesionDeCaja
  + cerrarCajaConArqueo(sesionId: Identificador,\n      montoContado: Moneda): SesionDeCaja
  + crearCaja(nombre: Cadena, tipo: TipoDeCaja,\n      requiereSesion: Booleano): Caja
  + modificarCaja(cajaId: Identificador,\n      datos: Registro): Caja
}
class CashLedgerService <<fachada>> {
  + anularMovimientoDeCaja(movimientoId: Identificador,\n      motivo: Cadena): MovimientoDeCaja
  + consultarMovimientosDeCaja(cajaId: Identificador,\n      desde: Fecha, hasta: Fecha): MovimientoDeCaja[*]
  + registrarEntradaDeDinero(cajaId: Identificador,\n      importe: Moneda, categoriaId: Identificador,\n      medio: MedioDeCaja,\n      motivo: Cadena): MovimientoDeCaja
  + registrarMovimientoDeCaja(cajaId: Identificador,\n      sentido: SentidoDeCaja = ninguno,\n      diferencia: Entero = ninguno,\n      diferenciaDeCaja: CategoriaDeCaja = ninguno,\n      enEfectivo: MedioDeCaja = ninguno,\n      sentidoDeCaja: SentidoDeCaja = ninguno,\n      total: Moneda = ninguno,\n      cobroDePedido: CategoriaDeCaja = ninguno,\n      medioDeCaja: MedioDeCaja = ninguno,\n      ingreso: SentidoDeCaja = ninguno,\n      importe: Moneda = ninguno,\n      motivo: Cadena = ninguno): MovimientoDeCaja
  + registrarSalidaDeDinero(cajaId: Identificador,\n      importe: Moneda, categoriaId: Identificador,\n      medio: MedioDeCaja,\n      motivo: Cadena): MovimientoDeCaja
  + transferirEntreCajas(cajaOrigenId: Identificador,\n      cajaDestinoId: Identificador,\n      importe: Moneda): MovimientoDeCaja[*]
}
class CashCategoryService <<fachada>> {
  + crearCategoriaDeCaja(nombre: Cadena,\n      sentido: SentidoDeCaja): CategoriaDeCaja
  + modificarCategoriaDeCaja(categoriaId: Identificador,\n      datos: Registro): CategoriaDeCaja
}
class FinanceService <<fachada>> {
  + consultarTableroFinanciero(fecha: Fecha): Registro
}
class "Map<String, Caja>" as Map_String_Caja <<colección>> {
  + get(clave: Cadena): Caja
}
class "Map<String, SesionDeCaja>" as Map_String_SesionDeCaja <<colección>> {
  + get(clave: Cadena): SesionDeCaja
}
class "Map<String, CategoriaDeCaja>" as Map_String_CategoriaDeCaja <<colección>> {
  + get(clave: Cadena): CategoriaDeCaja
}
class "Map<String, MovimientoDeCaja>" as Map_String_MovimientoDeCaja <<colección>> {
  + get(clave: Cadena): MovimientoDeCaja
}
class "List<Caja>" as List_Caja <<colección>> {
  + getActivas(): Caja[*]
}
class Caja <<referencia>>
class SesionDeCaja <<referencia>>
class CategoriaDeCaja <<referencia>>
class MovimientoDeCaja <<referencia>>
class "List<AsientoComision>" as List_AsientoComision <<referencia>>
class "List<CuentaCorriente>" as List_CuentaCorriente <<referencia>>
class "List<RendicionChofer>" as List_RendicionChofer <<referencia>>
class Distribuidora <<referencia>>

Map_String_Caja "1" o--> "0..*" Caja
Map_String_SesionDeCaja "1" o--> "0..*" SesionDeCaja
Map_String_CategoriaDeCaja "1" o--> "0..*" CategoriaDeCaja
Map_String_MovimientoDeCaja "1" o--> "0..*" MovimientoDeCaja
List_Caja "1" o--> "0..*" Caja
CashBoxService --> "1" Map_String_Caja
CashBoxService --> "1" Map_String_SesionDeCaja
CashCategoryService --> "1" Map_String_CategoriaDeCaja
CashLedgerService --> "1" Map_String_Caja
CashLedgerService --> "1" Map_String_CategoriaDeCaja
CashLedgerService --> "1" Map_String_MovimientoDeCaja
FinanceService --> "1" List_AsientoComision
FinanceService --> "1" List_Caja
FinanceService --> "1" List_CuentaCorriente
FinanceService --> "1" List_RendicionChofer
CashBoxService ..> Caja
CashBoxService ..> CashLedgerService
CashBoxService ..> Distribuidora
CashBoxService ..> SesionDeCaja
CashCategoryService ..> CategoriaDeCaja
CashCategoryService ..> Distribuidora
CashLedgerService ..> Caja
CashLedgerService ..> MovimientoDeCaja

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
