@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

class RendicionChofer {
  - numero: Entero
  - fechaDeNegocio: Fecha
  - estado: EstadoDeLaRendicion
  - efectivoEsperado: Moneda
  - efectivoDeclarado: Moneda
  - /gastosDelChofer: Moneda
  - /diferencia: Moneda
  - resolucionDeLaDiferencia: ResolucionDeDiferencia
  - presentadaEl: FechaHora
  - aprobadaEl: FechaHora
  - observaciones: Cadena
  - avisoEnviadoEl: FechaHora
  + «create» RendicionChofer(hoy: Fecha)
  + absorberDiferencia()
  + agregarCobro(cobro: AsientoCuentaCorriente)
  + agregarPedido(pedido: Pedido)
  + aprobar(caja: Caja,\n      resolucionDeDiferencia: ResolucionDeDiferencia)
  + calcularDiferencia(): Moneda
  + calcularEfectivoEsperado(): Moneda
  + marcarAvisada(ahora: FechaHora)
  + presentar(efectivoDeclarado: Moneda,\n      gastos: GastoDeRendicion[*])
  + reabrir()
  + recalcularEfectivoEsperado(): Moneda
  + validarAbierta()
  + validarPresentada()
}
class PedidoRendido {
  - importe: Moneda
  - medioDePago: MetodoDePago
  + «create» PedidoRendido(pedido: Pedido)
}
class GastoDeRendicion {
  - importe: Moneda
  - descripcion: Cadena
  + «create» GastoDeRendicion(categoria: CategoriaDeCaja,\n      importe: Moneda, descripcion: Cadena)
}
class Chofer <<referencia>>
class Empleado <<referencia>>
class Pedido <<referencia>>
class Caja <<referencia>>
class MovimientoDeCaja <<referencia>>
class CategoriaDeCaja <<referencia>>
class AsientoComision <<referencia>>

Chofer "1" *-- "0..*" RendicionChofer : presenta
RendicionChofer "0..*" --> "0..1" Caja : ingresa en
RendicionChofer "0..1" -- "0..1" MovimientoDeCaja : genera
RendicionChofer "1" *--> "0..*" PedidoRendido : rinde
PedidoRendido "0..1" -- "1" Pedido : corresponde a
RendicionChofer "1" *--> "0..*" GastoDeRendicion : declara
GastoDeRendicion "0..*" -- "1" CategoriaDeCaja : se clasifica en
RendicionChofer "0..1" -- "0..*" AsientoComision : origina
RendicionChofer ..> Empleado

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
