@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

class Calificacion {
  - puntaje: Entero
  - comentario: Cadena
  + «create» Calificacion(pedido: Pedido,\n      calificado: Usuario, estrellas: Entero,\n      comentario: Cadena)
  + getEstrellas(): Entero
}
class Incidencia {
  - tipo: TipoDeIncidencia
  - momento: MomentoDeIncidencia
  - descripcion: Cadena
  - estado: EstadoDeIncidencia
  - resolucion: Cadena
  - fotografia: Cadena
  + «create» Incidencia(chofer: Chofer, nota: Cadena)
  + «create» Incidencia(administrador: Usuario,\n      motivo: Cadena)
  + «create» Incidencia(usuario: Usuario, tipo: Cadena,\n      descripcion: Cadena, foto: Archivo)
  + getResumen(): Registro
  + resolver(nota: Cadena)
}
class Reclamo {
  - motivo: Cadena
  - descripcion: Cadena
  - estado: EstadoDelReclamo
  - resolucion: Cadena
  - fotografia: Cadena
  + «create» Reclamo(pedido: Pedido, motivo: Cadena,\n      evidencia: Archivo)
  + adjuntarFoto(clave: Cadena): Cadena
  + esDelCliente(cliente: Cliente): Booleano
  + getFoto(): Cadena
  + getResumen(): Registro
  + reabrir(motivo: Cadena)
  + resolver(resolucion: Cadena,\n      estadoDestino: EstadoDelReclamo)
  + tomar()
  + validarTransicion(estadoDestino: EstadoDelReclamo)
}
class Usuario <<referencia>>
class Pedido <<referencia>>
class Cliente <<referencia>>

Usuario <|-- Cliente : {overlapping, incomplete}
Pedido "1" -- "0..*" Reclamo : origina
Cliente "1" --> "0..*" Reclamo : presenta
Pedido "1" --> "0..*" Incidencia : origina
Usuario "1" -- "0..*" Incidencia : reporta
Pedido "1" -- "0..2" Calificacion : recibe
Usuario "1" --> "0..*" Calificacion : emite
Usuario "1" --> "0..*" Calificacion : recibe

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
