@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

class CasoRecupero {
  - escalon: Entero
  - depositoComprometido: Moneda
  - estado: EstadoDelCasoDeRecupero
  - resolucion: Cadena
  + «create» CasoRecupero(cliente: Cliente, deposito: Moneda)
  + avisar(escalon: Entero)
  + cerrar(devuelto: Booleano)
  + escalar()
  + resolver(decision: Cadena)
  + validarEscalado()
}
class AvisoRecupero {
  - escalon: Entero
  - tipo: TipoDeAviso
  - vence: FechaHora
  + «create» AvisoRecupero(escalon: Entero)
  + aceptar(pedido: Pedido)
  + getEnvase(): Envase
  + getPedidoDeEntrega(): Pedido
}
class Envase <<referencia>>
class Cliente <<referencia>>
class Usuario <<referencia>>

Usuario <|-- Cliente : {overlapping, incomplete}
Envase "1" <--> "0..*" CasoRecupero : motiva
CasoRecupero "0..*" -- "1" Cliente : se abre contra
Usuario "0..1" -- "0..*" CasoRecupero : resuelve
CasoRecupero "1" *--> "0..*" AvisoRecupero : emite

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
