@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

skinparam nodesep 18
skinparam ranksep 35
class Distribuidora
class Usuario
class Cliente
class InvitacionRecompra
class ItemSugerido
class Producto
class Envase
class CasoRecupero
class AvisoRecupero
class Carrito
class Pedido
class ItemPedido
class CambioEstadoPedido
class ZonaCobertura
class FranjaHoraria
class Pago
class OfertaDespacho
class LoteRecorrido
class ParadaLote
class OfertaLote
class Chofer
class Vehiculo
class TareaMantenimiento
class PropuestaVentanaTaller
class UbicacionGPS
class Reclamo

Usuario <|-- Cliente : {overlapping, incomplete}
Usuario <|-- Chofer
Distribuidora "1" -- "0..*" Chofer
Distribuidora "1" -- "0..*" Producto
Distribuidora "1" -- "0..*" Envase
Distribuidora "1" -- "0..*" Pedido
Distribuidora "1" *-- "0..*" ZonaCobertura
Distribuidora "1" *-- "0..*" FranjaHoraria
Cliente "1" <-- "0..*" Pedido
Cliente "1" *-- "0..*" Carrito
Cliente "1" -- "0..*" InvitacionRecompra
Cliente "0..*" -- "0..1" Producto
InvitacionRecompra "0..1" -- "0..1" Pedido
InvitacionRecompra "1" *--> "1..*" ItemSugerido
ItemSugerido "0..*" -- "1" Producto
Pedido "1" *--> "1..*" ItemPedido
ItemPedido "0..*" --> "1" Producto
Pedido "0..*" --> "0..1" FranjaHoraria
Pedido "0..*" --> "0..1" ZonaCobertura
Pedido "0..*" -- "0..1" Vehiculo
Pedido "1" *--> "0..*" CambioEstadoPedido
Usuario "0..1" -- "0..*" Pedido : confirmó el cobro de
Usuario "0..1" -- "0..*" Pedido : resolvió el cobro de
Chofer "0..1" -- "0..*" Pedido
Pedido "1" -- "0..*" Pago
Pedido "1" *--> "0..*" OfertaDespacho
OfertaDespacho "0..*" -- "1" Chofer
LoteRecorrido "1" *--> "1..*" ParadaLote
ParadaLote "0..*" -- "1" Pedido
LoteRecorrido "1" *--> "0..*" OfertaLote
OfertaLote "0..*" -- "1" Chofer
Chofer "0..1" -- "0..*" LoteRecorrido
Chofer "1" -- "0..*" Vehiculo : tiene registrado
Chofer "0..*" -- "0..*" Vehiculo : usa
Chofer "1" --> "0..1" UbicacionGPS
TareaMantenimiento "0..*" <-- "0..1" Vehiculo
TareaMantenimiento "0..*" -- "0..1" Chofer
TareaMantenimiento "1" *--> "0..*" PropuestaVentanaTaller
PropuestaVentanaTaller "0..*" -- "1" Chofer
Producto "0..1" -- "0..*" Envase
Cliente "0..1" -- "0..*" Envase
Pedido "0..1" -- "0..*" Envase
Envase "1" --> "0..*" CasoRecupero
CasoRecupero "0..*" -- "1" Cliente
CasoRecupero "1" *--> "0..*" AvisoRecupero
Pedido "1" -- "0..*" Reclamo
Cliente "1" --> "0..*" Reclamo

legend bottom right
  Vista de conjunto: sin miembros; solo llevan nombre las asociaciones que comparten par. La flecha abierta marca
  la navegabilidad que piden los diagramas de interacción; se omiten las asociaciones
  de Usuario que solo registran la autoría de un hecho, que figuran en su área.
endlegend
@enduml
