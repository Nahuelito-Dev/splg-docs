@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam genericDisplay old
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #F3E9CF
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #DCEBDD
}
skinparam interface {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBDD
  FontSize 14
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide empty members

class Caja {
  - nombre: Cadena
  - tipo: TipoDeCaja
  - saldo: Moneda
  - requiereSesion: Booleano
  - activa: Booleano
  + «create» Caja(nombre: Cadena, tipoDeCaja: TipoDeCaja,\n      requiereSesion: Booleano)
  + abrirSesion(montoInicial: Moneda,\n      administrador: Administrador): SesionDeCaja
  + actualizarSaldo(sentido: SentidoDeCaja, importe: Moneda)
  + calcularDiferencia(montoContado: Moneda): Moneda
  + contraasentar(movimiento: MovimientoDeCaja,\n      motivo: Cadena): MovimientoDeCaja
  + modificar(datos: Registro)
  + registrarMovimiento(sentido: SentidoDeCaja,\n      importe: Moneda, categoria: CategoriaDeCaja,\n      medio: MedioDeCaja, descripcion: Cadena,\n      referencia: OrigenDelMovimiento): MovimientoDeCaja
  + validarCambio(datos: Registro)
  + validarPuedeAbrirse()
  + validarSaldoSuficiente(sentido: SentidoDeCaja,\n      importe: Moneda)
  + validarSesionAbierta()
}
class SesionDeCaja {
  - estado: EstadoDeLaSesion
  - abiertaEl: FechaHora
  - montoInicial: Moneda
  - cerradaEl: FechaHora
  - montoEsperado: Moneda
  - montoContado: Moneda
  - diferencia: Moneda
  - observaciones: Cadena
  + «create» SesionDeCaja(montoInicial: Moneda,\n      administrador: Administrador)
  + cerrar(montoContado: Moneda, diferencia: Moneda,\n      administrador: Administrador)
  + getCaja(): Caja
  + validarAbierta()
}
class CategoriaDeCaja {
  - nombre: Cadena
  - sentido: SentidoDeCaja
  - codigoDeSistema: CodigoDeSistema
  - activa: Booleano
  + «create» CategoriaDeCaja(nombre: Cadena,\n      sentido: SentidoDeCaja)
  + modificar(datos: Registro)
  + validarQueNoEsDeSistema()
}
class MovimientoDeCaja {
  - sentido: SentidoDeCaja
  - importe: Moneda
  - medio: MedioDeCaja
  - fecha: FechaHora
  - descripcion: Cadena
  - origen: OrigenDelMovimiento
  + «create» MovimientoDeCaja(movimiento: MovimientoDeCaja,\n      motivo: Cadena)
  + «create» MovimientoDeCaja(sentido: SentidoDeCaja,\n      importe: Moneda, categoria: CategoriaDeCaja,\n      medio: MedioDeCaja, descripcion: Cadena,\n      referencia: OrigenDelMovimiento)
  + getCaja(): Caja
  + validarAnulable()
}
class Distribuidora <<referencia>>
class RendicionChofer <<referencia>>
class AsientoCuentaCorriente <<referencia>>
class LiquidacionComisiones <<referencia>>

Distribuidora "1" *--> "0..*" Caja : define
Distribuidora "1" *--> "0..*" CategoriaDeCaja : define
Caja "1" *--> "0..*" SesionDeCaja : registra
Caja "1" *--> "0..*" MovimientoDeCaja : asienta
SesionDeCaja "0..1" -- "0..*" MovimientoDeCaja : agrupa
CategoriaDeCaja "1" -- "0..*" MovimientoDeCaja : clasifica
MovimientoDeCaja "0..1" -- "0..1" MovimientoDeCaja : anula a
RendicionChofer "0..*" -- "0..1" Caja : ingresa en
RendicionChofer "0..1" -- "0..1" MovimientoDeCaja : genera
AsientoCuentaCorriente "0..1" -- "0..1" MovimientoDeCaja : se asienta en
LiquidacionComisiones "0..1" -- "0..1" MovimientoDeCaja : se paga con

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml
