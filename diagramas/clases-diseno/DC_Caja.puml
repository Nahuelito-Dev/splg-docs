@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

class Caja {
  - nombre: Cadena
  - tipo: TipoDeCaja
  - saldo: Moneda
  - requiereSesion: Booleano
  - activa: Booleano
  + «create» Caja(nombre: Cadena, tipoDeCaja: TipoDeCaja,\n      requiereSesion: Booleano)
  + abrirSesion(montoInicial: Moneda,\n      administrador: Usuario): Registro
  + actualizarSaldo(importe: Moneda,\n      sentido: SentidoDeCaja = ninguno,\n      entrada: MovimientoDeCaja = ninguno)
  + calcularDiferencia(montoContado: Moneda): Moneda
  + contraasentar(movimiento: MovimientoDeCaja,\n      motivo: Cadena): MovimientoDeCaja
  + getMovimientos(desde: FechaHora,\n      hasta: FechaHora): MovimientoDeCaja[*]
  + modificar(datos: Registro)
  + registrarMovimiento(referencia: OrigenDelMovimiento,\n      sentido: SentidoDeCaja = ninguno,\n      importe: Moneda = ninguno,\n      categoria: CategoriaDeCaja = ninguno,\n      medio: MedioDeCaja = ninguno,\n      descripcion: Cadena = ninguno,\n      entrada: MovimientoDeCaja = ninguno,\n      saldoACobrar: Moneda = ninguno,\n      cobroDePedido: CategoriaDeCaja = ninguno,\n      enEfectivo: MedioDeCaja = ninguno,\n      motivo: Cadena = ninguno): MovimientoDeCaja
  + validarCambio(datos: Registro)
  + validarPuedeAbrirse()
  + validarSaldoSuficiente(sentido: SentidoDeCaja,\n      importe: Moneda)
  + validarSesionAbierta()
}
class SesionDeCaja {
  - estado: EstadoDeLaSesion
  - abiertaEl: FechaHora
  - montoInicial: Moneda
  - cerradaEl: FechaHora
  - /montoEsperado: Moneda
  - montoContado: Moneda
  - /diferencia: Moneda
  - observaciones: Cadena
  + «create» SesionDeCaja(montoInicial: Moneda,\n      administrador: Usuario)
  + cerrar(montoContado: Moneda, administrador: Usuario)
  + validarAbierta()
}
class CategoriaDeCaja {
  - nombre: Cadena
  - sentido: SentidoDeCaja
  - codigoDeSistema: CodigoDeSistema
  - activa: Booleano
  + «create» CategoriaDeCaja(nombre: Cadena,\n      sentido: SentidoDeCaja)
  + modificar(datos: Registro)
  + validarQueNoEsDeSistema()
}
class MovimientoDeCaja {
  - sentido: SentidoDeCaja
  - importe: Moneda
  - medio: MedioDeCaja
  - fecha: FechaHora
  - descripcion: Cadena
  - origen: OrigenDelMovimiento
  + «create» MovimientoDeCaja(sentido: SentidoDeCaja = ninguno,\n      importe: Moneda = ninguno,\n      categoria: CategoriaDeCaja = ninguno,\n      medio: MedioDeCaja = ninguno,\n      descripcion: Cadena = ninguno,\n      referencia: OrigenDelMovimiento = ninguno,\n      movimiento: MovimientoDeCaja = ninguno,\n      motivo: Cadena = ninguno,\n      entrada: MovimientoDeCaja = ninguno,\n      saldoACobrar: Moneda = ninguno,\n      cobroDePedido: CategoriaDeCaja = ninguno,\n      enEfectivo: MedioDeCaja = ninguno)
  + getCaja(): Caja
  + validarAnulable()
}
class Distribuidora <<referencia>>
class Usuario <<referencia>>
class RendicionChofer <<referencia>>
class AsientoCuentaCorriente <<referencia>>
class LiquidacionComisiones <<referencia>>

Distribuidora "1" *--> "0..*" Caja : define
Distribuidora "1" *--> "0..*" CategoriaDeCaja : define
Caja "1" *-- "0..*" SesionDeCaja : registra
Caja "1" *--> "0..*" MovimientoDeCaja : asienta
SesionDeCaja "0..1" -- "0..*" MovimientoDeCaja : agrupa
CategoriaDeCaja "1" -- "0..*" MovimientoDeCaja : clasifica
MovimientoDeCaja "0..1" -- "0..1" MovimientoDeCaja : anula a
Usuario "1" -- "0..*" MovimientoDeCaja : registró
RendicionChofer "0..*" --> "0..1" Caja : ingresa en
RendicionChofer "0..1" -- "0..1" MovimientoDeCaja : genera
AsientoCuentaCorriente "0..1" -- "0..1" MovimientoDeCaja : se asienta en
LiquidacionComisiones "0..1" -- "0..1" MovimientoDeCaja : se paga con

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
