@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class FleetTaskService <<fachada>> {
  + assertVehiculoHabilitado(vehiculo: Vehiculo)
  + cerrarTareaDeFlota(tareaId: Identificador, fecha: Fecha,\n      kilometraje: Entero, costo: Moneda,\n      observacion: Cadena): TareaMantenimiento
  + motivosDeInhabilitacionDeVehiculo(vehiculo: Vehiculo): Cadena[*]
  + programarMantenimientoDeVehiculo(planId: Identificador,\n      recursoId: Identificador, vencimiento: Fecha,\n      detalle: Registro): TareaMantenimiento
  + registrarAltaEnLaART(empleadoId: Identificador,\n      planId: Identificador, vencimiento: Fecha,\n      detalle: Registro): TareaMantenimiento
  + registrarCursoDeMercanciasPeligrosas(empleadoId: Identificador,\n      planId: Identificador, vencimiento: Fecha,\n      detalle: Registro): TareaMantenimiento
  + registrarExamenPsicofisico(empleadoId: Identificador,\n      planId: Identificador, vencimiento: Fecha,\n      detalle: Registro): TareaMantenimiento
  + registrarHabilitacionDeMercanciasPeligrosas(planId: Identificador,\n      recursoId: Identificador, vencimiento: Fecha,\n      detalle: Registro): TareaMantenimiento
  + registrarLicenciaDeConducir(planId: Identificador,\n      recursoId: Identificador, vencimiento: Fecha,\n      detalle: Registro): TareaMantenimiento
  + registrarSeguroDelVehiculo(planId: Identificador,\n      recursoId: Identificador, vencimiento: Fecha,\n      detalle: Registro): TareaMantenimiento
  + registrarVerificacionTecnica(planId: Identificador,\n      recursoId: Identificador, vencimiento: Fecha,\n      detalle: Registro): TareaMantenimiento
}
class FleetAttachmentService <<fachada>> {
  + adjuntarArchivoALaTarea(tareaId: Identificador,\n      archivo: Archivo): AdjuntoTarea
  + consultarAdjuntosDeLaTarea(tareaId: Identificador): AdjuntoTarea[*]
  + descargarAdjunto(tareaId: Identificador,\n      adjuntoId: Identificador): Cadena
  + eliminarAdjunto(tareaId: Identificador,\n      adjuntoId: Identificador)
  + validarArchivo(archivo: Archivo)
}
class FleetExpirationsService <<fachada>> {
  + consultarVencimientosDeLaFlota(dias: Entero): Registro
  + consultarVencimientosDelPersonal(dias: Entero,\n      categoria: CategoriaDePuesto): Registro
}
class FleetAlertsCron <<fachada>> {
  + avisarVencimientosDeLaFlota()
  + avisarVencimientosDelPersonal()
}
class FleetDispatchLockService <<fachada>> {
  + assertChoferHabilitado(chofer: Chofer)
  + assertEnMoto(chofer: Chofer)
  + vehiculoEnUsoDelChofer(chofer: Chofer): Vehiculo
  + verificarHabilitacionLaboral(chofer: Chofer): Booleano
}
class "Map<String, PlanMantenimiento>" as Map_String_PlanMantenimiento <<colección>> {
  + get(clave: Cadena): PlanMantenimiento
}
class "Map<String, TareaMantenimiento>" as Map_String_TareaMantenimiento <<colección>> {
  + get(clave: Cadena): TareaMantenimiento
}
class "List<TareaMantenimiento>" as List_TareaMantenimiento <<colección>> {
  + getAbiertasDeEmpleadosHasta(dias: Entero,\n      categoria: CategoriaDePuesto): TareaMantenimiento[*]
  + getAbiertasDeEmpleadosPorEstado(): TareaMantenimiento[*]
  + getAbiertasHasta(dias: Entero): TareaMantenimiento[*]
  + getSinAvisar(): TareaMantenimiento[*]
}
class TareaMantenimiento <<referencia>>
class PlanMantenimiento <<referencia>>
class EmailSenderPort <<referencia>>
class S3Service <<referencia>>
class "Map<String, Chofer>" as Map_String_Chofer <<referencia>>
class "Map<String, Empleado>" as Map_String_Empleado <<referencia>>
class "Map<String, Vehiculo>" as Map_String_Vehiculo <<referencia>>
class Distribuidora <<referencia>>
class Empleado <<referencia>>
class Chofer <<referencia>>
class Vehiculo <<referencia>>

Map_String_TareaMantenimiento "1" o--> "0..*" TareaMantenimiento
Map_String_PlanMantenimiento "1" o--> "0..*" PlanMantenimiento
List_TareaMantenimiento "1" o--> "0..*" TareaMantenimiento
FleetAlertsCron --> "1" EmailSenderPort
FleetAlertsCron --> "1" List_TareaMantenimiento
FleetAttachmentService --> "1" Map_String_TareaMantenimiento
FleetAttachmentService --> "1" S3Service
FleetExpirationsService --> "1" List_TareaMantenimiento
FleetTaskService --> "1" Map_String_Chofer
FleetTaskService --> "1" Map_String_Empleado
FleetTaskService --> "1" Map_String_PlanMantenimiento
FleetTaskService --> "1" Map_String_TareaMantenimiento
FleetTaskService --> "1" Map_String_Vehiculo
FleetAlertsCron ..> Distribuidora
FleetAlertsCron ..> Empleado
FleetAlertsCron ..> TareaMantenimiento
FleetAttachmentService ..> TareaMantenimiento
FleetDispatchLockService ..> Chofer
FleetDispatchLockService ..> Empleado
FleetExpirationsService ..> Chofer
FleetExpirationsService ..> Empleado
FleetExpirationsService ..> TareaMantenimiento
FleetExpirationsService ..> Vehiculo
FleetTaskService ..> Empleado
FleetTaskService ..> PlanMantenimiento
FleetTaskService ..> TareaMantenimiento

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
