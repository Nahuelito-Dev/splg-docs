@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class OrderService <<fachada>> {
  + asignarChoferAPedido(pedidoId: Identificador,\n      choferId: Identificador): Pedido
  + avisarLlegada(pedidoId: Identificador)
  + calcularValorPromedio(ventasDelDia: Registro,\n      entregadosDelDia: Entero): Moneda
  + cambiarDireccionDeEntrega(pedidoId: Identificador,\n      direccionId: Identificador, motivo: Cadena): Pedido
  + completarDiasSinVentas(ventasPorDia: Registro): Registro
  + consultarGraficoDeVentas(): Cadena
  + consultarHistorialDeEstados(pedidoId: Identificador): CambioEstadoPedido[*]
  + consultarHistorialDePedidos(cliente: Cliente,\n      pagina: Entero, limite: Entero): Registro
  + consultarModalidadesDeEntrega(direccionId: Identificador): ModalidadDeEntrega[*]
  + consultarPedido(pedidoId: Identificador): Pedido
  + consultarPedidoEnCurso(): Pedido
  + consultarPedidosAsignados(choferId: Identificador,\n      pagina: Entero, limite: Entero): Registro
  + consultarPedidosDisponibles(pagina: Entero,\n      limite: Entero): Cadena
  + consultarResumenDePedidos(): Registro
  + despacharPedidoExpress(pedidoId: Identificador): Booleano
  + distribuidorasConPedidosDisponibles(): Distribuidora[*]
  + findAvailableOrders(distribuidora: Distribuidora): Pedido[*]
  + indicarQuienRecibe(pedidoId: Identificador,\n      nombre: Cadena, documento: Cadena,\n      relacion: Cadena): Pedido
  + listarPedidos(pagina: Entero, limite: Entero): Registro
  + obtenerCodigoDeEntrega(pedidoId: Identificador): Cadena
  + realizarCompraExpress(tipoGarrafa: Cadena,\n      metodoDePago: MetodoDePago): Pedido
  + rechazarOferta(pedidoId: Identificador): Booleano
  + verificarCoberturaExpress(direccion: DireccionEntrega): Booleano
}
class UpdateOrderStatusUseCase <<controlador>> {
  + aceptarPedido(pedidoId: Identificador): Pedido
  + confirmarEntrega(pedidoId: Identificador,\n      motivo: Cadena): Pedido
  + marcarPedidoEnCamino(pedidoId: Identificador): Pedido
}
class ConfirmDeliveryUseCase <<controlador>> {
  + confirmarEntregaConCodigo(pedidoId: Identificador,\n      codigo: Cadena, motivo: Cadena): Pedido
}
class CashCollectionUseCase <<controlador>> {
  + confirmarCobroEnEfectivo(pedidoId: Identificador): Pedido
  + confirmarTransferencia(pedidoId: Identificador,\n      recibida: Booleano, motivo: Cadena): Pedido
  + registrarCobroEnEfectivoPorAdmin(pedidoId: Identificador,\n      motivo: Cadena, cajaId: Identificador): Pedido
  + resolverCobroImpago(pedidoId: Identificador,\n      resolucion: Cadena, nota: Cadena,\n      cajaId: Identificador): Pedido
}
class QuoteOrderUseCase <<controlador>> {
  + cotizarPedido(items: Lista, metodoDePago: MetodoDePago,\n      direccionId: Identificador, cliente: Cliente,\n      pedidoId: Identificador): Registro
}
class OrderStatusHistorySubscriber <<fachada>> {
  + registrarCambioDeEstado(pedidoId: Identificador,\n      estadoAnterior: Cadena, estadoNuevo: Cadena,\n      autor: Identificador,\n      motivo: Cadena): CambioEstadoPedido
}
class "Map<String, Pedido>" as Map_String_Pedido <<colección>> {
  + get(clave: Cadena): Pedido
}
class "List<Pedido>" as List_Pedido <<colección>> {
  + buscarDeLaDistribuidora(distribuidoraId: Identificador,\n      pagina: Entero, limite: Entero): Registro
  + buscarDelCliente(cliente: Cliente, pagina: Entero,\n      limite: Entero): Registro
  + buscarDisponibles(distribuidoraId: Identificador,\n      pagina: Entero, limite: Entero): Registro
  + buscarPendientesConMercadoPagoAnterioresA(plazo: Entero): Pedido[*]
  + buscarReservas(distribuidoraId: Identificador): Pedido[*]
  + buscarReservasConSeniaPagaHasta(hoy: Fecha): Pedido[*]
  + buscarReservasSinSeniaAnterioresA(plazo: Entero): Pedido[*]
  + contarEntregadosDelDia(distribuidoraId: Identificador): Entero
  + contarEntregadosDelMesPorMetodo(distribuidoraId: Identificador): Registro
  + contarPorEstado(distribuidoraId: Identificador): Registro
  + entregadosEntre(fechaDesde: Fecha,\n      fechaHasta: Fecha): Pedido[*]
  + getCanceladosYPagados(desde: FechaHora,\n      hasta: FechaHora): Registro
  + getConCobroPendiente(desde: FechaHora,\n      hasta: FechaHora): AsientoCuentaCorriente[*]
  + getEnCursoDelChofer(chofer: Chofer,\n      inicioDelDia: FechaHora): Pedido
  + getEntregados(): Pedido[*]
  + getEntregadosSinMovimiento(): Pedido[*]
  + getReservado(producto: Producto): Entero
  + getUltimoEntregado(cliente: Cliente,\n      distribuidoraId: Identificador): Fecha
  + totalEntregado(periodo: Cadena): Registro
  + totalEntregadoPorDia(distribuidoraId: Identificador,\n      desde: FechaHora, hasta: FechaHora): Registro
}
class Pedido <<referencia>>
class DeliveryService <<referencia>>
class DispatchOrchestratorService <<referencia>>
class FleetDispatchLockService <<referencia>>
class "List<Chofer>" as List_Chofer <<referencia>>
class "Map<String, Chofer>" as Map_String_Chofer <<referencia>>
class NotificationPort <<referencia>>
class RealtimeDispatchPort <<referencia>>
class CreateOrderUseCase <<referencia>>
class CashLedgerService <<referencia>>
class Incidencia <<referencia>>
class Chofer <<referencia>>
class Cliente <<referencia>>
class NotificationsService <<referencia>>
class OfertaDespacho <<referencia>>
class PaymentsService <<referencia>>
class Producto <<referencia>>
class RefundsService <<referencia>>
class TruckLoadGateService <<referencia>>
class ZonaCobertura <<referencia>>
class Envase <<referencia>>
class StockDeliveryService <<referencia>>
class UbicacionGPS <<referencia>>

Map_String_Pedido "1" o--> "0..*" Pedido
List_Pedido "1" o--> "0..*" Pedido
CashCollectionUseCase --> "1" Map_String_Pedido
ConfirmDeliveryUseCase --> "1" Map_String_Pedido
OrderService --> "1" DeliveryService
OrderService --> "1" DispatchOrchestratorService
OrderService --> "1" FleetDispatchLockService
OrderService --> "1" List_Chofer
OrderService --> "1" List_Pedido
OrderService --> "1" Map_String_Chofer
OrderService --> "1" Map_String_Pedido
OrderService --> "1" NotificationPort
OrderService --> "1" RealtimeDispatchPort
QuoteOrderUseCase --> "1" CreateOrderUseCase
QuoteOrderUseCase --> "1" Map_String_Pedido
UpdateOrderStatusUseCase --> "1" FleetDispatchLockService
UpdateOrderStatusUseCase --> "1" Map_String_Pedido
UpdateOrderStatusUseCase --> "1" NotificationPort
CashCollectionUseCase ..> CashLedgerService
CashCollectionUseCase ..> Incidencia
CashCollectionUseCase ..> Pedido
ConfirmDeliveryUseCase ..> NotificationPort
ConfirmDeliveryUseCase ..> Pedido
ConfirmDeliveryUseCase ..> RealtimeDispatchPort
List_Pedido ..> Pedido
OrderService ..> Chofer
OrderService ..> Cliente
OrderService ..> NotificationsService
OrderService ..> OfertaDespacho
OrderService ..> PaymentsService
OrderService ..> "<<create>>" Pedido
OrderService ..> Producto
OrderService ..> RefundsService
OrderService ..> TruckLoadGateService
OrderService ..> ZonaCobertura
OrderStatusHistorySubscriber ..> Pedido
QuoteOrderUseCase ..> Cliente
QuoteOrderUseCase ..> Pedido
QuoteOrderUseCase ..> Producto
UpdateOrderStatusUseCase ..> Chofer
UpdateOrderStatusUseCase ..> Envase
UpdateOrderStatusUseCase ..> OrderStatusHistorySubscriber
UpdateOrderStatusUseCase ..> Pedido
UpdateOrderStatusUseCase ..> StockDeliveryService
UpdateOrderStatusUseCase ..> TruckLoadGateService
UpdateOrderStatusUseCase ..> UbicacionGPS

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
