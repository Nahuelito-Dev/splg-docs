@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

class Chofer {
  - disponible: Booleano
  - habilitado: Booleano
  - validado: Booleano
  - /calificacion: Decimal
  + «create» Chofer(usuario: Usuario,\n      distribuidoraId: Identificador,\n      datosDelChofer: Registro)
  + abrirRendicion(hoy: Fecha): RendicionChofer
  + activarDisponibilidad(verdadero: Booleano)
  + actualizarPerfil(datos: Registro)
  + actualizarUbicacion(latitud: Decimal, longitud: Decimal)
  + ajustarSaldo(monto: Moneda)
  + assertElegibleParaAsignacion()
  + assertSinCargaAbierta()
  + assertSinPedidoEnCurso()
  + assertSinPedidosEnCurso()
  + cambiarEstado(falso: Booleano)
  + darDeBaja()
  + desactivarDisponibilidad(falso: Booleano)
  + desconectar()
  + deshabilitar()
  + estaActivo(): Booleano
  + estaInhabilitado(tareas: TareaMantenimiento[*]): Booleano
  + getAsignacionAbierta(): AsignacionVehiculo
  + getCapacidadDeCarga(): Entero
  + getCargaAbierta(): CargaDeCamion
  + getEmpleado(): Empleado
  + getHistorialDeVehiculos(pagina: Entero): AsignacionVehiculo[*]
  + getPedidoEnCurso(): Pedido
  + getPedidos(pagina: Entero, limite: Entero): Registro
  + getPedidosEnCurso(): Entero
  + getRendicionAbierta()
  + getSaldo(): Moneda
  + getUbicacion(): UbicacionGPS
  + getUsuario(): Usuario
  + getVehiculoEnUso(): Vehiculo
  + getVehiculos(): Vehiculo[*]
  + invalidar()
  + liberarVehiculo()
  + puedeRecibirOferta(distribuidora: Distribuidora): Booleano
  + recalcularPromedio()
  + registrarVehiculo(tipo: Cadena, capacidad: Entero,\n      patente: Cadena, marca: Cadena, modelo: Cadena,\n      anio: Entero, color: Cadena): Vehiculo
  + usarVehiculo(vehiculo: Vehiculo, nota: Cadena,\n      administrador: Usuario)
  + validar()
  + validarHabilitacion()
  + validarSinCargaAbierta()
  + validarSinPedidosEnCurso()
}
class Vehiculo {
  - patente: Cadena
  - tipo: Cadena
  - cargaMaxima: Decimal
  - kilometraje: Entero
  - estadoEnLaFlota: EstadoEnLaFlota
  - tipoDeCombustible: TipoDeCombustible
  - capacidadDelTanque: Decimal
  + «create» Vehiculo(tipo: Cadena, capacidad: Entero,\n      patente: Cadena, marca: Cadena, modelo: Cadena,\n      anio: Entero, color: Cadena)
  + actualizarKilometraje(kilometraje: Entero)
  + assertFueraDeServicio()
  + assertKilometrajeCreciente(kilometraje: Entero)
  + assertLibre()
  + assertLitrosDentroDelTanque(litros: Decimal)
  + assertPatenteUnica(patente: Cadena)
  + darDeBaja()
  + editar(datos: Registro)
  + estaInhabilitado(tareas: TareaMantenimiento[*]): Booleano
  + estimarKilometrajeDiario(): Entero
  + getCargas(fechaDesde: Fecha,\n      fechaHasta: Fecha): CargaCombustible[*]
  + getChofer(): Chofer
  + getChoferEnUso(): Chofer
  + getCostoTotal(fechaDesde: Fecha,\n      fechaHasta: Fecha): Registro
  + getHistorialDeChoferes(pagina: Entero): AsignacionVehiculo[*]
  + getKilometrosRecorridos(fechaDesde: Fecha,\n      fechaHasta: Fecha): Entero
  + ponerFueraDeServicio()
  + proyectarVencimientos(): TareaMantenimiento[*]
  + reactivar()
  + recalcularKilometraje()
  + registrarCarga(datos: Registro): CargaCombustible
  + registrarMulta(datos: Registro,\n      empleado: Empleado): MultaTransito
  + registrarSiniestro(datos: Registro): Siniestro
  + tieneLlenas(producto: Producto,\n      cantidad: Entero): Booleano
  + validarEnUsoPor(chofer: Chofer)
  + validarSinCargaAbierta()
}
class AsignacionVehiculo {
  - asignadoEl: FechaHora
  - liberadoEl: FechaHora
  - nota: Cadena
  + «create» AsignacionVehiculo(chofer: Chofer,\n      vehiculo: Vehiculo, administrador: Usuario,\n      nota: Cadena)
  + cerrar(ahora: FechaHora)
  + liberar(administrador: Usuario)
}
class UbicacionGPS {
  - latitud: Decimal
  - longitud: Decimal
  + «create» UbicacionGPS(latitud: Decimal, longitud: Decimal)
  + abrirSeguimiento(pedido: Pedido)
  + actualizar(latitud: Decimal, longitud: Decimal)
  + cerrarSeguimiento()
  + eliminar()
  + getPosicionReciente(): Coordenada
}
class RegistroUsoVehiculo {
  - dia: Fecha
  - kilometros: Entero
  - pedidos: Entero
}
class Usuario <<referencia>>
class Distribuidora <<referencia>>
class Pedido <<referencia>>

Usuario <|-- Chofer : {overlapping, incomplete}
Distribuidora "1" --> "0..*" Chofer : emplea
Pedido "0..*" --> "0..1" Vehiculo : se entrega con
Chofer "0..1" <-- "0..*" Pedido : entrega
Chofer "1" --> "0..*" Vehiculo : tiene registrado
Chofer "0..*" --> "0..*" Vehiculo : usa
Chofer "1" --> "0..1" UbicacionGPS : se ubica en
Vehiculo "1" *-- "0..*" RegistroUsoVehiculo : acumula
Chofer ..> "<<create>>" AsignacionVehiculo
Vehiculo ..> AsignacionVehiculo
(Chofer, Vehiculo) .. AsignacionVehiculo

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
