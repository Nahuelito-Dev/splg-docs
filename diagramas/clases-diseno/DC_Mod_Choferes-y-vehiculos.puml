@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class DeliveryService <<fachada>> {
  + activarChofer(choferId: Identificador): Chofer
  + activarDisponibilidad(usuario: Usuario): Registro
  + actualizarPerfilDelChofer(choferId: Identificador,\n      datos: Registro): Chofer
  + ajustarSaldoDelChofer(choferId: Identificador,\n      monto: Moneda): Chofer
  + buscarChoferPorUsuario(usuario: Usuario): Chofer
  + consultarDetalleDelChofer(choferId: Identificador): Registro
  + consultarPerfilDelChofer(usuario: Usuario): Chofer
  + desactivarChofer(choferId: Identificador): Chofer
  + desactivarDisponibilidad(usuario: Usuario): Registro
  + eliminarChofer(choferId: Identificador)
  + findById(choferId: Identificador): Chofer
  + invalidarChofer(choferId: Identificador): Chofer
  + listarChoferes(pagina: Entero, limite: Entero): Chofer[*]
  + listarChoferesActivos(pagina: Entero,\n      limite: Entero): Chofer[*]
  + validarChofer(choferId: Identificador): Chofer
}
class "Map<String, Chofer>" as Map_String_Chofer <<colección>> {
  + get(clave: Cadena): Chofer
}
class "List<Chofer>" as List_Chofer <<colección>> {
  + buscarEnMotoDisponibles(direccion: DireccionEntrega): Chofer[*]
  + contarEnLinea(distribuidoraId: Identificador): Entero
  + contarHabilitados(distribuidoraId: Identificador): Entero
  + getConEfectivoOCobrosSinRendir(hoy: Fecha): Chofer[*]
}
class CarService <<fachada>> {
  + buscarVehiculoPorPatente(patente: Cadena): Vehiculo
  + consultarDetalleDelVehiculo(vehiculoId: Identificador): Registro
  + consultarVehiculosDelChofer(usuario: Usuario): Vehiculo[*]
  + editarVehiculo(vehiculoId: Identificador,\n      datos: Registro): Vehiculo
  + eliminarVehiculo(vehiculoId: Identificador)
  + listarVehiculos(): Vehiculo[*]
  + reactivarVehiculo(vehiculoId: Identificador): Vehiculo
  + registrarVehiculo(usuario: Usuario, tipo: Cadena,\n      capacidad: Decimal, patente: Cadena, marca: Cadena,\n      modelo: Cadena, anio: Entero,\n      color: Cadena): Vehiculo
}
class "List<Vehiculo>" as List_Vehiculo <<colección>> {
  + getActivos(): Vehiculo[*]
  + getVehiculosDe(distribuidora: Distribuidora): Vehiculo[*]
}
class "Map<String, Vehiculo>" as Map_String_Vehiculo <<colección>> {
  + get(clave: Cadena): Vehiculo
}
class VehicleAssignmentService <<fachada>> {
  + consultarHistorialDeChoferesDelVehiculo(vehiculoId: Identificador,\n      pagina: Entero): AsignacionVehiculo[*]
  + consultarHistorialDeVehiculosDelChofer(choferId: Identificador,\n      pagina: Entero): AsignacionVehiculo[*]
  + consultarMiVehiculoEnUso(): Registro
  + consultarVehiculoEnUso(choferId: Identificador): Registro
  + getEmpleadoAl(vehiculo: Vehiculo,\n      fechaYHora: FechaHora): Empleado
  + liberarVehiculoEnUso(choferId: Identificador)
  + ponerVehiculoEnUso(choferId: Identificador,\n      vehiculoId: Identificador,\n      nota: Cadena): AsignacionVehiculo
}
class "List<AsignacionVehiculo>" as List_AsignacionVehiculo <<colección>> {
  + cerrarAbiertas(chofer: Chofer, vehiculo: Vehiculo,\n      administrador: Usuario)
  + getAbierta(): AsignacionVehiculo
}
class Chofer <<referencia>>
class Vehiculo <<referencia>>
class AsignacionVehiculo <<referencia>>
class "Map<String, Usuario>" as Map_String_Usuario <<referencia>>
class FleetTaskService <<referencia>>
class Distribuidora <<referencia>>
class UbicacionGPS <<referencia>>
class Usuario <<referencia>>

Map_String_Chofer "1" o--> "0..*" Chofer
List_Chofer "1" o--> "0..*" Chofer
List_Vehiculo "1" o--> "0..*" Vehiculo
Map_String_Vehiculo "1" o--> "0..*" Vehiculo
List_AsignacionVehiculo "1" o--> "0..*" AsignacionVehiculo
CarService --> "1" List_Vehiculo
CarService --> "1" Map_String_Chofer
CarService --> "1" Map_String_Vehiculo
DeliveryService --> "1" Map_String_Chofer
DeliveryService --> "1" Map_String_Usuario
VehicleAssignmentService --> "1" Map_String_Chofer
VehicleAssignmentService --> "1" Map_String_Vehiculo
CarService ..> Chofer
CarService ..> FleetTaskService
CarService ..> Vehiculo
DeliveryService ..> Chofer
DeliveryService ..> Distribuidora
DeliveryService ..> UbicacionGPS
DeliveryService ..> Usuario
VehicleAssignmentService ..> AsignacionVehiculo
VehicleAssignmentService ..> Chofer
VehicleAssignmentService ..> FleetTaskService
VehicleAssignmentService ..> Vehiculo

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
