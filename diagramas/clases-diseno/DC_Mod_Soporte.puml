@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam genericDisplay old
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #F3E9CF
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #DCEBDD
}
skinparam interface {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBDD
  FontSize 14
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class ReportsService <<fachada>> {
  + agruparPorChofer(pedidos: Pedido[*]): Registro
  + agruparPorMetodoDePago(pedidos: Pedido[*]): Registro
  + agruparPorPeriodo(pedidos: Pedido[*],\n      granularidad: Cadena): Registro
  + agruparPorProducto(items: Registro): Registro
  + consultarCobrosPendientes(desde: Fecha,\n      hasta: Fecha): Registro
  + consultarEvolucionDeVentas(fechaDesde: Fecha,\n      fechaHasta: Fecha, granularidad: Cadena): Registro
  + consultarVentasPorChofer(fechaDesde: Fecha,\n      fechaHasta: Fecha): Registro
  + consultarVentasPorMetodoDePago(fechaDesde: Fecha,\n      fechaHasta: Fecha): Registro
  + consultarVentasPorProducto(fechaDesde: Fecha,\n      fechaHasta: Fecha): Registro
}
class FleetCostReportService <<fachada>> {
  + consultarCostoDeUnVehiculo(vehiculoId: Identificador,\n      fechaDesde: Fecha, fechaHasta: Fecha): Registro
  + consultarTableroDeCostosDeLaFlota(fechaDesde: Fecha,\n      fechaHasta: Fecha): Registro
  + ordenarPorCostoPorKilometro(costos: Registro): Registro
}
class HealthCheckService <<fachada>> {
  + verificarDisponibilidad(): Registro
  + verificarSalud(): Registro
  + verificarVida(): Registro
}
class RedisHealthIndicator <<fabricación pura>> {
  + isHealthy(redis: Registro): Booleano
}
class RedisService <<fabricación pura>> {
  + del(marcasDeUltimaEjecucion: Registro)
  + ping(): Booleano
}
class S3Service <<fabricación pura>> {
  + getSignedDownload(adjunto: AdjuntoTarea): Cadena
  + getSignedDownload(clave: Cadena,\n      nombreDeDescarga: Cadena): Cadena
  + put(clave: Cadena, archivo: Archivo, tipo: Cadena)
}
class S3CleanupService <<fabricación pura>> {
  + removeInBackground(claveAnterior: Cadena)
}
class "List<Vehiculo>" as List_Vehiculo <<referencia>>
class "Map<String, Vehiculo>" as Map_String_Vehiculo <<referencia>>
class "List<Pedido>" as List_Pedido <<referencia>>
class Vehiculo <<referencia>>
class ItemPedido <<referencia>>
class Pedido <<referencia>>
class AttachmentService <<referencia>>
class ClaimsService <<referencia>>
class FleetAttachmentService <<referencia>>

FleetCostReportService --> "1" List_Vehiculo
FleetCostReportService --> "1" Map_String_Vehiculo
HealthCheckService --> "1" RedisHealthIndicator
RedisHealthIndicator --> "1" RedisService
ReportsService --> "1" List_Pedido
FleetCostReportService ..> Vehiculo
ReportsService ..> ItemPedido
ReportsService ..> Pedido
AttachmentService --> "1" S3Service
ClaimsService --> "1" S3Service
FleetAttachmentService --> "1" S3Service
ClaimsService --> "1" S3CleanupService

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran sólo como referencia.
endlegend
@enduml
