@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam genericDisplay old
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #F3E9CF
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #DCEBDD
}
skinparam interface {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBDD
  FontSize 14
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide empty members

class Carrito {
  - ultimaModificacion: FechaHora
  + «create» Carrito(distribuidora: Distribuidora)
  + agregarItem(producto: Producto, cantidad: Entero)
  + calcularTotal(): Moneda
  + getItem(itemId: Identificador): ItemCarrito
  + modificarCantidad(itemId: Identificador, cantidad: Entero)
  + quitarItem(itemId: Identificador)
  + vaciar()
}
class ItemCarrito {
  - cantidad: Entero
  - precioUnitario: Moneda
  + «create» ItemCarrito(producto: Producto,\n      cantidad: Entero, precioUnitario: Moneda)
  + cambiarCantidad(cantidad: Entero)
  + getDiferenciaDePrecio(): Moneda
  + getSubtotal(): Moneda
  + sumarCantidad(cantidad: Entero)
}
class FranjaHoraria {
  - desde: Hora
  - hasta: Hora
  - cupo: Entero
  - activa: Booleano
  + «create» FranjaHoraria(nombre: Cadena, horaInicio: Hora,\n      horaFin: Hora, capacidad: Entero)
  + cuposLibres(fecha: Fecha): Registro
  + desactivar()
  + modificar(nombre: Cadena, horaInicio: Hora,\n      horaFin: Hora, capacidad: Entero)
  + tieneCupo(fechaAgendada: Fecha): Booleano
  + validarCapacidad(capacidad: Entero)
}
class ZonaCobertura {
  - nombre: Cadena
  - area: Poligono
  - recargo: Moneda
  - tipoDeRecargo: TipoDeRecargo
  - vigenteHasta: FechaHora
  + «create» ZonaCobertura(nombre: Cadena,\n      poligono: Poligono, recargo: Moneda,\n      activa: Booleano)
  + calcularRecargo(subtotalItems: Moneda): Moneda
  + cubre(direccion: DireccionEntrega): Booleano
  + cubre(latitud: Decimal, longitud: Decimal): Booleano
  + darDeBaja()
  + desactivar()
  + getRecargo(): Moneda
  + programarVigencia(vigenteHasta: FechaHora)
  + validarPoligono()
  + validarRecargo()
  + validarVigencia()
}
class Cliente <<referencia>>
class Producto <<referencia>>
class Distribuidora <<referencia>>
class Pedido <<referencia>>

Distribuidora "1" *--> "0..*" ZonaCobertura : define
Distribuidora "1" *--> "0..*" FranjaHoraria : define
Cliente "1" *--> "0..*" Carrito : arma
Carrito "1" *--> "0..*" ItemCarrito : contiene
ItemCarrito "0..*" --> "1" Producto : corresponde a
Pedido "0..*" -- "0..1" FranjaHoraria : se programa en
Pedido "0..*" --> "0..1" ZonaCobertura : aplica el recargo de
Carrito ..> Producto

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml
