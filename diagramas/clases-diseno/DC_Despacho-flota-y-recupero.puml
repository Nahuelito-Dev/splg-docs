@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

class OfertaDespacho {
  + «create» OfertaDespacho(chofer: Chofer, venceEn: Entero)
  + aceptar()
  + getPedido(): Pedido
  + vencer()
}
class LoteRecorrido {
  - estado: EstadoDelLote
  - /pesoTotal: Decimal
  + «create» LoteRecorrido(chofer: Chofer,\n      vehiculo: Vehiculo, fecha: Fecha)
}
class PropuestaVentanaTaller {
  - desde: FechaHora
  - hasta: FechaHora
  + «create» PropuestaVentanaTaller(chofer: Chofer,\n      ventana: PropuestaVentanaTaller,\n      vigencia: FechaHora)
}
class TareaMantenimiento {
  - estado: EstadoDeLaTarea
  - vence: Fecha
  - vencimientoProyectado: FechaHora
  - prestador: Cadena
  - numero: Cadena
  - costo: Moneda
  - vigenteDesde: Fecha
  - detalle: Registro
  + proponerVentana(chofer: Chofer,\n      ventana: PropuestaVentanaTaller): PropuestaVentanaTaller
}
class Chofer {
  - disponible: Booleano
  - habilitado: Booleano
  - validado: Booleano
  - /calificacion: Decimal
  + activarDisponibilidad(verdadero: Booleano)
  + actualizarUbicacion(latitud: Decimal, longitud: Decimal)
  + assertElegibleParaAsignacion()
  + getPedidoEnCurso(): Pedido
  + getUbicacion(): UbicacionGPS
  + puedeRecibirOferta(distribuidora: Distribuidora): Booleano
  + validarHabilitacion()
}
class Vehiculo {
  - patente: Cadena
  - tipo: Cadena
  - cargaMaxima: Decimal
  - kilometraje: Entero
  - estadoEnLaFlota: EstadoEnLaFlota
  - tipoDeCombustible: TipoDeCombustible
  - capacidadDelTanque: Decimal
  + ponerFueraDeServicio()
}
class UbicacionGPS {
  - latitud: Decimal
  - longitud: Decimal
  + «create» UbicacionGPS(latitud: Decimal, longitud: Decimal)
  + actualizar(latitud: Decimal, longitud: Decimal)
  + eliminar()
}
class CasoRecupero {
  - escalon: Entero
  - depositoComprometido: Moneda
  - estado: EstadoDelCasoDeRecupero
  - resolucion: Cadena
  + «create» CasoRecupero(cliente: Cliente, deposito: Moneda)
  + avisar(escalon: Entero)
  + cerrar(devuelto: Booleano)
  + escalar()
}
class AvisoRecupero {
  - escalon: Entero
  - tipo: TipoDeAviso
  - vence: FechaHora
  + «create» AvisoRecupero(escalon: Entero)
}
class Pedido <<referencia>>
class Cliente <<referencia>>
class Envase <<referencia>>
class Usuario <<referencia>>
class Distribuidora <<referencia>>

Usuario <|-- Cliente : {overlapping, incomplete}
Usuario <|-- Chofer
Distribuidora "1" -- "0..*" Chofer : emplea
Distribuidora "1" -- "0..*" Vehiculo : posee
Pedido "0..*" -- "0..1" Vehiculo : se entrega con
Chofer "0..1" -- "0..*" Pedido : entrega
Pedido "1" *--> "0..*" OfertaDespacho : genera
OfertaDespacho "0..*" -- "1" Chofer : se dirige a
Chofer "0..1" -- "0..*" LoteRecorrido : acepta
Chofer "0..*" -- "0..*" Vehiculo : usa
Chofer "0..1" -- "0..*" Vehiculo : tiene registrado
Chofer "1" --> "0..1" UbicacionGPS : se ubica en
TareaMantenimiento "0..*" -- "0..1" Vehiculo : habilita
TareaMantenimiento "0..*" -- "0..1" Chofer : habilita
TareaMantenimiento "1" *--> "0..*" PropuestaVentanaTaller : origina
PropuestaVentanaTaller "0..*" -- "1" Chofer : se dirige a
Envase "1" --> "0..*" CasoRecupero : motiva
CasoRecupero "0..*" -- "1" Cliente : se abre contra
Usuario "0..1" -- "0..*" CasoRecupero : resuelve
CasoRecupero "1" *--> "0..*" AvisoRecupero : emite

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
