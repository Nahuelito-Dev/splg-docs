@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam genericDisplay old
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #F3E9CF
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #DCEBDD
}
skinparam interface {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBDD
  FontSize 14
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide empty members

class PuestoDeTrabajo {
  - nombre: Cadena
  - categoria: CategoriaDePuesto
  - activo: Booleano
  + «create» PuestoDeTrabajo(nombre: Cadena,\n      categoria: CategoriaDeCaja)
  + assertSinEmpleadosActivos()
  + contarEmpleadosActivos()
  + darDeBaja()
  + getNombre(): Cadena
  + getRolDeAcceso(): Rol
  + modificar(datos: Registro)
}
class Empleado {
  - legajo: Cadena
  - nombre: Cadena
  - apellido: Cadena
  - documento: Cadena
  - cuil: Cadena
  - fechaDeNacimiento: Fecha
  - domicilio: Cadena
  - telefono: Cadena
  - contactoDeEmergencia: Cadena
  - fechaDeIngreso: Fecha
  - fechaDeEgreso: Fecha
  - motivoDeEgreso: MotivoDeEgreso
  - modalidadDeContratacion: ModalidadDeContratacion
  - estado: EstadoDelEmpleado
  + «create» Empleado(datos: Registro,\n      puesto: PuestoDeTrabajo)
  + abrirJornada(origenDeJornada: OrigenDeLaJornada): JornadaDeTrabajo
  + adjuntar(clave: Cadena, archivo: Archivo,\n      etiqueta: Cadena): Adjunto
  + assertActivo()
  + assertEgresado()
  + assertEsAltaErronea()
  + assertFechaNoAnteriorAlIngreso(fechaDeEgreso: Fecha)
  + assertSinJornadaAbierta()
  + assertSinSuperposicion(fechaDesde: Fecha,\n      fechaHasta: Fecha)
  + assertSinSuperposicionExcepto(fechaDesde: Fecha,\n      fechaHasta: Fecha, licencia: LicenciaLaboral)
  + calcularSaldoSinLiquidar(): Moneda
  + cerrarJornada()
  + darDeBaja()
  + egresar(fechaDeEgreso: Fecha,\n      motivoDeEgreso: MotivoDeEgreso): Usuario
  + estaActivo(): Booleano
  + estaInhabilitado(tareas: TareaMantenimiento[*]): Booleano
  + getCuenta(): Registro
  + getDiasTomados(anio: Entero): Entero
  + getFechaDeIngreso(): Fecha
  + getLegajo(): Cadena
  + getLicenciasAprobadas(): LicenciaLaboral[*]
  + getNombre(): Cadena
  + getPeorVencimiento()
  + getPlanesFaltantes(): PlanMantenimiento[*]
  + getPuesto(): PuestoDeTrabajo
  + getTareas(): TareaMantenimiento[*]
  + getTareasBloqueantesVencidas(): TareaMantenimiento[*]
  + liquidar(fechaDesde: Fecha,\n      fechaHasta: Fecha): LiquidacionComisiones
  + modificar(datos: Registro)
  + registrarArrastre(liquidacion: LiquidacionComisiones,\n      saldoDeudor: Moneda)
  + registrarComision(pedido: Pedido, regla: ReglaComision)
  + registrarFaltante(rendicion: RendicionChofer,\n      importe: Moneda)
  + registrarJornada(ingreso: FechaHora, egreso: FechaHora,\n      origenDeJornada: OrigenDeLaJornada): JornadaDeTrabajo
  + reingresar(fechaDeIngreso: Fecha)
  + solicitarLicencia(tipoDeLicencia: TipoDeLicencia,\n      fechaDesde: Fecha, fechaHasta: Fecha,\n      motivo: Cadena): LicenciaLaboral
  + validarSinComisionPrevia(pedido: Pedido)
  + vincularCuenta(usuario: Usuario)
}
class JornadaDeTrabajo {
  - dia: Fecha
  - ingreso: FechaHora
  - egreso: FechaHora
  - origen: OrigenDeLaJornada
  - observacion: Cadena
  + «create» JornadaDeTrabajo(ahora: FechaHora,\n      origenDeJornada: OrigenDeLaJornada)
  + «create» JornadaDeTrabajo(ingreso: FechaHora,\n      egreso: FechaHora,\n      origenDeJornada: OrigenDeLaJornada)
  + assertNotaObligatoria(nota: Cadena)
  + cerrar(ahora: FechaHora)
  + corregir(datos: Registro, nota: Cadena)
  + getDuracion()
}
class LicenciaLaboral {
  - tipo: TipoDeLicencia
  - desde: Fecha
  - hasta: Fecha
  - /dias: Entero
  - estado: EstadoDeLaLicencia
  - motivo: Cadena
  - motivoDeRechazo: Cadena
  - resueltaEl: FechaHora
  + «create» LicenciaLaboral(tipoDeLicencia: TipoDeLicencia,\n      fechaDesde: Fecha, fechaHasta: Fecha,\n      motivo: Cadena)
  + aprobar(usuario: Usuario)
  + assertMotivoObligatorio(motivoDeRechazo: Cadena)
  + assertNoTerminada()
  + assertSolicitada()
  + cancelar()
  + cubre(hoy: Fecha)
  + getDias(): Entero
  + getEmpleado(): Empleado
  + modificar(datos: Registro)
  + rechazar(usuario: Usuario, motivoDeRechazo: Cadena)
  + validarTransicion(estadoNuevoDeLicencia: EstadoDeLaLicencia)
}
class Adjunto {
  - nombreOriginal: Cadena
  - tipoDeArchivo: Cadena
  - etiqueta: Cadena
  - fechaDeCarga: FechaHora
  + «create» Adjunto(clave: Cadena, archivo: Archivo,\n      etiqueta: Cadena)
}
class Distribuidora <<referencia>>
class Usuario <<referencia>>
class TareaMantenimiento <<referencia>>
class Chofer <<referencia>>

Usuario <|-- Chofer : {overlapping, incomplete}
Distribuidora "1" --> "0..*" Empleado : emplea
Distribuidora "1" *--> "0..*" PuestoDeTrabajo : define
Empleado "0..*" --> "1" PuestoDeTrabajo : ocupa
Empleado "0..1" --> "0..1" Usuario : accede con
Empleado "1" *--> "0..*" JornadaDeTrabajo : registra
Empleado "1" *--> "0..*" LicenciaLaboral : solicita
Usuario "0..1" -- "0..*" LicenciaLaboral : resuelve
Empleado "1" *--> "0..*" Adjunto : conserva
TareaMantenimiento "0..*" <--> "0..1" Empleado : habilita
Empleado "0..1" -- "0..1" Chofer : actúa como

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml
