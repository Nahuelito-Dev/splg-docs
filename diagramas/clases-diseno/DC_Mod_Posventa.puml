@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class ClaimsService <<fachada>> {
  + adjuntarFotoAlReclamo(reclamoId: Identificador,\n      imagen: Archivo): Reclamo
  + consultarFotoDelReclamo(reclamoId: Identificador): DireccionEntrega
  + listarReclamos(): Reclamo[*]
  + reabrirReclamo(reclamoId: Identificador,\n      motivo: Cadena): Reclamo
  + registrarReclamo(pedidoId: Identificador, motivo: Cadena,\n      evidencia: Archivo): Reclamo
  + resolverReclamo(reclamoId: Identificador,\n      resolucion: Cadena, estadoFinal: Cadena): Reclamo
  + tomarReclamo(reclamoId: Identificador): Reclamo
}
class "Map<String, Reclamo>" as Map_String_Reclamo <<colección>> {
  + get(clave: Cadena): Reclamo
  + values(distribuidora: Distribuidora): Reclamo[*]
}
class IncidentService <<fachada>> {
  + consultarIncidenciasDelPedido(pedidoId: Identificador): Incidencia[*]
  + listarIncidencias(): Incidencia[*]
  + registrarIncidencia(pedidoId: Identificador,\n      tipo: Cadena, descripcion: Cadena,\n      foto: Archivo): Incidencia
  + resolverIncidencia(incidenciaId: Identificador,\n      notaDeResolucion: Cadena): Incidencia
}
class "Map<String, Incidencia>" as Map_String_Incidencia <<colección>> {
  + get(clave: Cadena): Incidencia
  + values(distribuidora: Distribuidora): Incidencia[*]
}
class UnpaidCashService <<fachada>> {
  + informarCobroImpago(pedidoId: Identificador,\n      nota: Cadena): Incidencia
  + registrarCobroImpagoPorAdmin(pedidoId: Identificador,\n      motivo: Cadena): Incidencia
}
class RatingService <<fachada>> {
  + calificarPedido(pedidoId: Identificador,\n      estrellas: Entero, comentario: Cadena): Calificacion
  + consultarHistorialDeCalificaciones(usuario: Usuario): Calificacion[*]
  + consultarResumenDeCalificaciones(usuario: Usuario): Registro
}
class Reclamo <<referencia>>
class Incidencia <<referencia>>
class "Map<String, Pedido>" as Map_String_Pedido <<referencia>>
class S3CleanupService <<referencia>>
class S3Service <<referencia>>
class AdminGateway <<referencia>>
class Cliente <<referencia>>
class Pedido <<referencia>>
class Chofer <<referencia>>
class Usuario <<referencia>>

Map_String_Reclamo "1" o--> "0..*" Reclamo
Map_String_Incidencia "1" o--> "0..*" Incidencia
ClaimsService --> "1" Map_String_Pedido
ClaimsService --> "1" Map_String_Reclamo
ClaimsService --> "1" S3CleanupService
ClaimsService --> "1" S3Service
IncidentService --> "1" Map_String_Incidencia
IncidentService --> "1" Map_String_Pedido
RatingService --> "1" Map_String_Pedido
UnpaidCashService --> "1" AdminGateway
UnpaidCashService --> "1" Map_String_Pedido
ClaimsService ..> Cliente
ClaimsService ..> Pedido
ClaimsService ..> Reclamo
IncidentService ..> Incidencia
IncidentService ..> Pedido
RatingService ..> Chofer
RatingService ..> Pedido
RatingService ..> Usuario
UnpaidCashService ..> Pedido

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
