@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class FuelLoadService <<fachada>> {
  + anularCargaDeCombustible(cargaId: Identificador): CargaCombustible
  + consultarCargasDeCombustible(filtros: Registro): CargaCombustible[*]
  + consultarConsumoDeCombustible(vehiculoId: Identificador,\n      fechaDesde: Fecha, fechaHasta: Fecha): Registro
  + modificarCargaDeCombustible(cargaId: Identificador,\n      datos: Registro): CargaCombustible
  + registrarCargaDeCombustible(vehiculoId: Identificador,\n      datos: Registro): CargaCombustible
}
class FuelConsumptionCalculator <<fabricación pura>> {
  + calcularConsumo(cargas: CargaCombustible[*]): Registro
  + calcularDesvio(cargaCombustible: CargaCombustible,\n      vehiculo: Vehiculo): Decimal
}
class TrafficFineService <<fachada>> {
  + anularMultaDeTransito(multaId: Identificador,\n      motivo: Cadena): MultaTransito
  + consultarMultasDeTransito(filtros: Registro): MultaTransito[*]
  + imputarMultaAlChofer(multaId: Identificador,\n      empleadoId: Identificador): MultaTransito
  + modificarMultaDeTransito(multaId: Identificador,\n      datos: Registro): MultaTransito
  + registrarMultaDeTransito(vehiculoId: Identificador,\n      datos: Registro): MultaTransito
  + registrarPagoDeMulta(multaId: Identificador,\n      fechaDePago: FechaHora,\n      importePagado: Moneda): MultaTransito
}
class "Map<String, MultaTransito>" as Map_String_MultaTransito <<colección>> {
  + containsKey(clave: Cadena): Booleano
  + get(clave: Cadena): MultaTransito
}
class VehicleAccidentService <<fachada>> {
  + cerrarSiniestro(siniestroId: Identificador,\n      costoDeReparacion: Moneda,\n      reintegroDelSeguro: Moneda,\n      franquicia: Moneda): Siniestro
  + consultarSiniestros(filtros: Registro): Siniestro[*]
  + modificarSiniestro(siniestroId: Identificador,\n      datos: Registro): Siniestro
  + registrarSiniestro(vehiculoId: Identificador,\n      datos: Registro): Siniestro
}
class "Map<String, Siniestro>" as Map_String_Siniestro <<colección>> {
  + get(clave: Cadena): Siniestro
}
class TireService <<fachada>> {
  + registrarMovimientoDeNeumatico(neumaticoId: Identificador,\n      datos: Registro): MovimientoNeumatico
  + registrarNeumatico(datos: Registro): Neumatico
}
class "Map<String, Neumatico>" as Map_String_Neumatico <<colección>> {
  + containsKey(clave: Cadena): Booleano
  + get(clave: Cadena): Neumatico
}
class "Map<String, CargaCombustible>" as Map_String_CargaCombustible <<colección>> {
  + get(clave: Cadena): CargaCombustible
}
class "List<CargaCombustible>" as List_CargaCombustible <<colección>> {
  + getVigentes(filtros: Registro): CargaCombustible[*]
}
class "List<MultaTransito>" as List_MultaTransito <<colección>> {
  + filtrar(filtros: Registro): MultaTransito[*]
  + getPendientesPorVencer(dias: Entero): MultaTransito[*]
}
class FleetExpenseAlertsCron <<fachada>> {
  + avisarMultasPorVencer()
}
class "List<Siniestro>" as List_Siniestro <<colección>> {
  + filtrar(filtros: Registro): Siniestro[*]
}
class "Map<String, Empleado>" as Map_String_Empleado <<colección>> {
  + get(clave: Cadena): Empleado
}
class FleetCostReportService <<fachada>> {
  + consultarCostoDeUnVehiculo(vehiculoId: Identificador,\n      fechaDesde: Fecha, fechaHasta: Fecha): Registro
  + consultarTableroDeCostosDeLaFlota(fechaDesde: Fecha,\n      fechaHasta: Fecha): Registro
  + ordenarPorCostoPorKilometro(costos: Registro): Registro
}
class "List<Vehiculo>" as List_Vehiculo <<colección>> {
  + getActivos(): Vehiculo[*]
  + getVehiculosDe(distribuidora: Distribuidora): Vehiculo[*]
}
class Vehiculo <<referencia>>
class Empleado <<referencia>>
class MultaTransito <<referencia>>
class Siniestro <<referencia>>
class Neumatico <<referencia>>
class CargaCombustible <<referencia>>
class "Map<String, Vehiculo>" as Map_String_Vehiculo <<referencia>>
class EmailSenderPort <<referencia>>
class VehicleAssignmentService <<referencia>>
class Distribuidora <<referencia>>

List_Vehiculo "1" o--> "0..*" Vehiculo
Map_String_Empleado "1" o--> "0..*" Empleado
Map_String_MultaTransito "1" o--> "0..*" MultaTransito
Map_String_Siniestro "1" o--> "0..*" Siniestro
Map_String_Neumatico "1" o--> "0..*" Neumatico
Map_String_CargaCombustible "1" o--> "0..*" CargaCombustible
List_CargaCombustible "1" o--> "0..*" CargaCombustible
List_MultaTransito "1" o--> "0..*" MultaTransito
List_Siniestro "1" o--> "0..*" Siniestro
FleetCostReportService --> "1" List_Vehiculo
FleetCostReportService --> "1" Map_String_Vehiculo
FleetExpenseAlertsCron --> "1" EmailSenderPort
FleetExpenseAlertsCron --> "1" List_MultaTransito
FuelLoadService --> "1" EmailSenderPort
FuelLoadService --> "1" FuelConsumptionCalculator
FuelLoadService --> "1" List_CargaCombustible
FuelLoadService --> "1" Map_String_CargaCombustible
FuelLoadService --> "1" Map_String_Vehiculo
TireService --> "1" Map_String_Neumatico
TireService --> "1" Map_String_Vehiculo
TrafficFineService --> "1" List_MultaTransito
TrafficFineService --> "1" Map_String_Empleado
TrafficFineService --> "1" Map_String_MultaTransito
TrafficFineService --> "1" Map_String_Vehiculo
TrafficFineService --> "1" VehicleAssignmentService
VehicleAccidentService --> "1" EmailSenderPort
VehicleAccidentService --> "1" List_Siniestro
VehicleAccidentService --> "1" Map_String_Siniestro
VehicleAccidentService --> "1" Map_String_Vehiculo
FleetCostReportService ..> Vehiculo
FleetExpenseAlertsCron ..> Distribuidora
FleetExpenseAlertsCron ..> MultaTransito
FuelLoadService ..> CargaCombustible
FuelLoadService ..> Vehiculo
TireService ..> Distribuidora
TireService ..> Neumatico
TrafficFineService ..> MultaTransito
TrafficFineService ..> Vehiculo
VehicleAccidentService ..> Siniestro
VehicleAccidentService ..> Vehiculo

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
