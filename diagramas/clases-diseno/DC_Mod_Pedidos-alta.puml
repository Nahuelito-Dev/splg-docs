@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class CreateOrderUseCase <<controlador>> {
  + calcularTotales(subtotal: Moneda, zona: ZonaCobertura,\n      metodoDePago: MetodoDePago): Registro
  + crearPedido(items: Lista, direccionId: Identificador,\n      franjaId: Identificador, fechaAgendada: Fecha,\n      metodoDePago: Cadena)
  + crearReserva(items: Lista, direccionId: Identificador,\n      fechaAgendada: Fecha, franjaId: Identificador,\n      metodoDePago: Cadena,\n      montoDeLaSenia: Moneda): Registro
  + resolverZona(direccion: DireccionEntrega): ZonaCobertura
  + valorizarRenglon(producto: Producto,\n      item: ItemPedido): Registro
  + venderACuentaCorriente(cliente: Cliente,\n      direccionId: Identificador, items: Lista): Pedido
}
class CancelOrderUseCase <<controlador>> {
  + cancelarMiPedido(pedidoId: Identificador,\n      motivo: Cadena): Pedido
  + cancelarPedido(pedidoId: Identificador,\n      motivo: Cadena): Pedido
}
class ReleaseOrderUseCase <<controlador>> {
  + liberarPedido(pedidoId: Identificador,\n      motivo: Cadena): Pedido
}
class UpdateOrderUseCase <<controlador>> {
  + modificarMiPedido(pedidoId: Identificador,\n      datos: Registro): Pedido
  + modificarPedido(pedidoId: Identificador,\n      datos: Registro): Pedido
}
interface NotificationPort <<puerto>> {
  + sendArrivalPushToCustomer(cliente: Cliente,\n      pedido: Pedido, nombreDelChofer: Cadena)
  + sendOrderConfirmation(cliente: Cliente, pedido: Pedido)
  + sendPaymentApprovedPush(cliente: Cliente, pedido: Pedido,\n      esSena: Booleano)
}
class "Map<String, Pedido>" as Map_String_Pedido <<referencia>>
class RealtimeDispatchPort <<referencia>>
class PaymentsService <<referencia>>
class Pedido <<referencia>>
class Carrito <<referencia>>
class Cliente <<referencia>>
class CuentaCorriente <<referencia>>
class Distribuidora <<referencia>>
class FranjaHoraria <<referencia>>
class Producto <<referencia>>
class ZonaCobertura <<referencia>>
class OfertaDespacho <<referencia>>

CancelOrderUseCase --> "1" Map_String_Pedido
CancelOrderUseCase --> "1" RealtimeDispatchPort
CreateOrderUseCase --> "1" NotificationPort
CreateOrderUseCase --> "1" PaymentsService
ReleaseOrderUseCase --> "1" Map_String_Pedido
ReleaseOrderUseCase --> "1" RealtimeDispatchPort
UpdateOrderUseCase --> "1" Map_String_Pedido
CancelOrderUseCase ..> Pedido
CreateOrderUseCase ..> Carrito
CreateOrderUseCase ..> Cliente
CreateOrderUseCase ..> CuentaCorriente
CreateOrderUseCase ..> Distribuidora
CreateOrderUseCase ..> FranjaHoraria
CreateOrderUseCase ..> "<<create>>" Pedido
CreateOrderUseCase ..> Producto
CreateOrderUseCase ..> ZonaCobertura
ReleaseOrderUseCase ..> OfertaDespacho
ReleaseOrderUseCase ..> Pedido
UpdateOrderUseCase ..> Pedido

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
