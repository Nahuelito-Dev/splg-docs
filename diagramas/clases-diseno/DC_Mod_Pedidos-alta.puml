@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam genericDisplay old
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #F3E9CF
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #DCEBDD
}
skinparam interface {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBDD
  FontSize 14
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class CreateOrderUseCase <<controlador>> {
  + crearPedido(items: Lista, direccionId: Identificador,\n      franjaId: Identificador, fechaAgendada: Fecha,\n      metodoDePago: Cadena,\n      out enlaceDePago: Cadena): Pedido
  + crearReserva(items: Lista, direccionId: Identificador,\n      fechaAgendada: Fecha, franjaId: Identificador,\n      metodoDePago: Cadena, montoDeLaSenia: Moneda,\n      out enlaceDePago: Cadena): Pedido
  + venderACuentaCorriente(cliente: Cliente,\n      direccionId: Identificador, items: Lista): Pedido
}
class CancelOrderUseCase <<controlador>> {
  + cancelarPedido(pedidoId: Identificador,\n      motivo: Cadena): Pedido
  + cancelarPedidoForzado(pedidoId: Identificador): Pedido
}
class ReleaseOrderUseCase <<controlador>> {
  + liberarPedido(pedidoId: Identificador,\n      motivo: Cadena): Pedido
}
interface NotificationPort <<interface>> <<puerto>> {
  + sendArrivalPushToCustomer(cliente: Cliente,\n      pedido: Pedido, nombreDelChofer: Cadena)
  + sendOrderConfirmation(cliente: Cliente, pedido: Pedido)
  + sendPaymentApprovedPush(cliente: Cliente, pedido: Pedido,\n      esSena: Booleano)
}
class OrderStatusHistoryService <<fachada>> {
  + consultarHistorialDeEstados(pedidoId: Identificador): CambioEstadoPedido[*]
  + registrarCambioDeEstado(pedidoId: Identificador,\n      estadoAnterior: Cadena, estadoNuevo: Cadena,\n      autor: Identificador,\n      motivo: Cadena): CambioEstadoPedido
}
class "Map<String, Pedido>" as Map_String_Pedido <<referencia>>
class RealtimeDispatchPort <<referencia>>
class PaymentsService <<referencia>>
class Pedido <<referencia>>
class Cliente <<referencia>>
class Producto <<referencia>>
class FranjaHoraria <<referencia>>
class OfertaDespacho <<referencia>>
class CuentaCorriente <<referencia>>
class ZonaCobertura <<referencia>>

CancelOrderUseCase --> "1" Map_String_Pedido
CancelOrderUseCase --> "1" RealtimeDispatchPort
CreateOrderUseCase --> "1" NotificationPort
CreateOrderUseCase --> "1" PaymentsService
OrderStatusHistoryService --> "1" Map_String_Pedido
ReleaseOrderUseCase --> "1" Map_String_Pedido
ReleaseOrderUseCase --> "1" RealtimeDispatchPort
CancelOrderUseCase ..> Pedido
CreateOrderUseCase ..> Cliente
CreateOrderUseCase ..> CuentaCorriente
CreateOrderUseCase ..> FranjaHoraria
CreateOrderUseCase ..> Pedido : <<create>>
CreateOrderUseCase ..> Producto
CreateOrderUseCase ..> ZonaCobertura
OrderStatusHistoryService ..> Pedido
ReleaseOrderUseCase ..> OfertaDespacho
ReleaseOrderUseCase ..> Pedido

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran sólo como referencia.
endlegend
@enduml
