@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class StockDeliveryService <<fachada>> {
  + descartarGarrafa(producto: Producto)
  + elegirOrigen(ubicacionDelCamion: UbicacionDeStock)
  + registrarEntrega(entrega: MotivoDeMovimiento = ninguno,\n      pedido: Pedido = ninguno,\n      items: Registro = ninguno): Booleano
}
class CatalogStockAdjustmentUseCase <<controlador>> {
  + actualizarStock(productoId: Identificador,\n      variacion: Entero): Producto
}
class StockAdjustmentUseCase <<controlador>> {
  + registrarAjusteDeStock(nota: Cadena,\n      ubicacionDeStock: UbicacionDeStock = ninguno,\n      motivoRecuento: MotivoDeAjuste = ninguno,\n      producto: Producto = ninguno,\n      variacion: Entero = ninguno,\n      ubicacionId: Identificador = ninguno,\n      motivo: Cadena = ninguno,\n      items: Lista = ninguno): AjusteDeStock
  + validarItemsDeAjuste(motivo: Cadena, items: Registro)
}
class WarehouseService <<fachada>> {
  + actualizarDeposito(depositoId: Identificador,\n      datos: Registro): Deposito
  + consultarDeposito(depositoId: Identificador): Registro
  + consultarDepositos(incluirInactivos: Booleano): Deposito[*]
  + darDeBajaDeposito(depositoId: Identificador)
  + marcarDepositoPredeterminado(depositoId: Identificador): Deposito
  + registrarDeposito(nombre: Cadena, codigo: Cadena,\n      tipo: Cadena, direccion: Cadena): Deposito
}
class "Map<String, Deposito>" as Map_String_Deposito <<colección>> {
  + get(clave: Cadena): Deposito
}
class StockQueryService <<fachada>> {
  + consultarAjusteDeStock(ajusteId: Identificador): Registro
  + consultarAjustesDeStock(desde: FechaHora,\n      hasta: FechaHora, motivo: Cadena): Registro
  + consultarMovimientosDeStock(productoId: Identificador,\n      ubicacionId: Identificador, motivo: Cadena,\n      desde: FechaHora, hasta: FechaHora,\n      pagina: Entero): Registro
  + consultarResumenDeStock(): Registro
  + consultarStockPorUbicacion(ubicacionId: Identificador,\n      productoId: Identificador): SaldoDeStock[*]
  + saldos(ubicacionDeStock: UbicacionDeStock): SaldoDeStock[*]
}
class "Map<String, UbicacionDeStock>" as Map_String_UbicacionDeStock <<colección>> {
  + get(clave: Cadena): UbicacionDeStock
}
class StockLocationService <<fachada>> {
  + consultarUbicacionesDeStock(): UbicacionDeStock[*]
}
class "List<MovimientoDeStock>" as List_MovimientoDeStock <<colección>> {
  + filtrar(productoId: Identificador,\n      ubicacionId: Identificador, motivo: Cadena,\n      desde: FechaHora, hasta: FechaHora,\n      pagina: Entero): MovimientoDeCaja[*]
  + getLote(loteId: Identificador): MovimientoDeCaja
}
class StockThresholdService <<fachada>> {
  + configurarStockMinimo(minimos: Lista): UmbralDeStock[*]
  + consultarStockMinimo(): UmbralDeStock[*]
}
class StockLowCron <<fachada>> {
  + avisarStockBajo()
}
class "List<UmbralDeStock>" as List_UmbralDeStock <<colección>> {
  + getConMinimo(): UmbralDeStock[*]
  + getMinimoDeLlenas(producto: Producto): Entero
  + getTodos(): UmbralDeStock[*]
}
class StockAdminNotifier <<fabricación pura>> {
  + avisar(distribuidora: Distribuidora, stockBajo: Registro)
}
class StockTransferUseCase <<controlador>> {
  + transferirStock(origenId: Identificador,\n      destinoId: Identificador, items: Lista,\n      nota: Cadena): Identificador
}
class StockLedgerService <<fachada>> {
  + aplicar(ubicacionOrigen: UbicacionDeStock = ninguno,\n      ubicacionDestino: UbicacionDeStock = ninguno,\n      items: Registro = ninguno,\n      traslado: MotivoDeMovimiento = ninguno,\n      ubicacionDeStock: UbicacionDeStock = ninguno,\n      motivo: Cadena = ninguno,\n      itemsRecibidos: ItemRecepcion[*] = ninguno,\n      renglones: MovimientoDeStock[*] = ninguno,\n      movimientos: MovimientoDeCaja[*] = ninguno,\n      plan: PlanMantenimiento = ninguno,\n      operacion: Cadena = ninguno,\n      renglonesDeAjuste: ItemAjusteDeStock[*] = ninguno): Identificador
  + contraasentar(loteId: Identificador = ninguno,\n      nota: Cadena = ninguno,\n      loteDeLaRecepcion: Identificador = ninguno): Identificador
  + validarMovimiento(movimiento: MovimientoDeCaja)
}
class StockReconciliationCron <<fachada>> {
  + borrarAviso(distribuidora: Distribuidora)
  + coincideConElUltimoAviso(firma: Cadena)
  + conciliarStock()
  + guardarAviso(firma: Cadena)
}
class StockReconciliationService <<fachada>> {
  + conciliar(distribuidora: Distribuidora): MotivoDeAjuste
  + consultarConciliacionDeStock(): MotivoDeAjuste
}
class InitialCountUseCase <<controlador>> {
  + registrarConteoInicial(depositoId: Identificador,\n      items: Lista, nota: Cadena): AjusteDeStock
}
class "Map<String, AjusteDeStock>" as Map_String_AjusteDeStock <<colección>> {
  + get(clave: Cadena): AjusteDeStock
}
class "List<AjusteDeStock>" as List_AjusteDeStock <<colección>> {
  + filtrar(desde: FechaHora, hasta: FechaHora,\n      motivo: Cadena): Registro
}
class ReverseBatchUseCase <<controlador>> {
  + anularTransferenciaDeStock(loteId: Identificador,\n      nota: Cadena)
}
class ReconciliationAdjustmentUseCase <<controlador>> {
  + registrarAjusteDeConciliacion(productoId: Identificador,\n      nota: Cadena,\n      diferenciaEsperada: Entero): AjusteDeStock
}
class ReapplyDeliveriesUseCase <<controlador>> {
  + reaplicarEntregasDeStock(): Registro
}
class "List<UbicacionDeStock>" as List_UbicacionDeStock <<colección>> {
  + getSaldos(producto: Producto): SaldoDeStock[*]
}
class Deposito <<referencia>>
class UbicacionDeStock <<referencia>>
class MovimientoDeStock <<referencia>>
class UmbralDeStock <<referencia>>
class AjusteDeStock <<referencia>>
class "Map<String, Producto>" as Map_String_Producto <<referencia>>
class "List<Pedido>" as List_Pedido <<referencia>>
class "List<Producto>" as List_Producto <<referencia>>
class Distribuidora <<referencia>>
class Pedido <<referencia>>
class Producto <<referencia>>
class Vehiculo <<referencia>>

Map_String_Deposito "1" o--> "0..*" Deposito
Map_String_UbicacionDeStock "1" o--> "0..*" UbicacionDeStock
List_MovimientoDeStock "1" o--> "0..*" MovimientoDeStock
List_UmbralDeStock "1" o--> "0..*" UmbralDeStock
Map_String_AjusteDeStock "1" o--> "0..*" AjusteDeStock
List_AjusteDeStock "1" o--> "0..*" AjusteDeStock
List_UbicacionDeStock "1" o--> "0..*" UbicacionDeStock
CatalogStockAdjustmentUseCase --> "1" Map_String_Producto
CatalogStockAdjustmentUseCase --> "1" StockAdjustmentUseCase
InitialCountUseCase --> "1" Map_String_Deposito
ReapplyDeliveriesUseCase --> "1" List_Pedido
ReapplyDeliveriesUseCase --> "1" StockDeliveryService
ReconciliationAdjustmentUseCase --> "1" Map_String_Producto
ReverseBatchUseCase --> "1" List_MovimientoDeStock
StockAdjustmentUseCase --> "1" Map_String_UbicacionDeStock
StockLowCron --> "1" List_UmbralDeStock
StockLowCron --> "1" StockAdminNotifier
StockQueryService --> "1" List_AjusteDeStock
StockQueryService --> "1" List_MovimientoDeStock
StockQueryService --> "1" List_Pedido
StockQueryService --> "1" List_Producto
StockQueryService --> "1" List_UbicacionDeStock
StockQueryService --> "1" List_UmbralDeStock
StockQueryService --> "1" Map_String_AjusteDeStock
StockQueryService --> "1" Map_String_UbicacionDeStock
StockReconciliationCron --> "1" StockAdminNotifier
StockReconciliationCron --> "1" StockReconciliationService
StockReconciliationService --> "1" List_Pedido
StockReconciliationService --> "1" List_Producto
StockThresholdService --> "1" List_UmbralDeStock
StockThresholdService --> "1" Map_String_Deposito
StockThresholdService --> "1" Map_String_Producto
StockTransferUseCase --> "1" Map_String_UbicacionDeStock
WarehouseService --> "1" Map_String_Deposito
CatalogStockAdjustmentUseCase ..> Distribuidora
InitialCountUseCase ..> Deposito
InitialCountUseCase ..> StockLedgerService
InitialCountUseCase ..> UbicacionDeStock
List_AjusteDeStock ..> AjusteDeStock
List_MovimientoDeStock ..> MovimientoDeStock
List_UmbralDeStock ..> UmbralDeStock
ReapplyDeliveriesUseCase ..> Pedido
ReconciliationAdjustmentUseCase ..> Distribuidora
ReconciliationAdjustmentUseCase ..> Producto
ReconciliationAdjustmentUseCase ..> UbicacionDeStock
ReverseBatchUseCase ..> MovimientoDeStock
ReverseBatchUseCase ..> StockLedgerService
StockAdjustmentUseCase ..> StockLedgerService
StockAdjustmentUseCase ..> UbicacionDeStock
StockDeliveryService ..> Deposito
StockDeliveryService ..> Distribuidora
StockDeliveryService ..> Pedido
StockDeliveryService ..> StockLedgerService
StockDeliveryService ..> Vehiculo
StockLedgerService ..> Deposito
StockLedgerService ..> "<<create>>" MovimientoDeStock
StockLedgerService ..> Producto
StockLedgerService ..> UbicacionDeStock
StockLocationService ..> Distribuidora
StockLowCron ..> UmbralDeStock
StockQueryService ..> AjusteDeStock
StockQueryService ..> UbicacionDeStock
StockReconciliationService ..> Producto
StockThresholdService ..> Deposito
StockTransferUseCase ..> StockLedgerService
StockTransferUseCase ..> UbicacionDeStock
WarehouseService ..> Deposito
WarehouseService ..> Distribuidora
WarehouseService ..> StockQueryService

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
