@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam genericDisplay old
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #F3E9CF
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #DCEBDD
}
skinparam interface {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBDD
  FontSize 14
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class TruckLoadGateService <<fachada>> {
  + assertPuedeAceptar(chofer: Chofer)
  + assertPuedeAsignar(chofer: Chofer)
  + choferesQuePuedenRecibir(choferes: Chofer[*])
  + motivoParaNoRecibir(chofer: Chofer): Cadena
  + verificarCargaDeCamionAbierta(chofer: Chofer): Booleano
}
class UpdateTruckLoadItemsUseCase <<controlador>> {
  + corregirRenglonesDeLaCarga(cargaId: Identificador,\n      items: Lista): CargaDeCamion
}
class "Map<String, CargaDeCamion>" as Map_String_CargaDeCamion <<colección>> {
  + get(clave: Cadena): CargaDeCamion
}
class OpenTruckLoadUseCase <<controlador>> {
  + registrarCargaDelCamion(vehiculoId: Identificador,\n      choferId: Identificador, depositoId: Identificador,\n      ayudanteId: Identificador,\n      items: Lista): CargaDeCamion
}
class ReloadTruckLoadUseCase <<controlador>> {
  + reponerCargaDelCamion(cargaId: Identificador,\n      items: Lista): Booleano
}
class DepartTruckLoadUseCase <<controlador>> {
  + registrarSalidaDelCamion(cargaId: Identificador): Booleano
}
class ReturnTruckLoadUseCase <<controlador>> {
  + registrarRegresoDelCamion(cargaId: Identificador,\n      devueltos: Lista): Booleano
}
class CloseTruckLoadUseCase <<controlador>> {
  + cerrarRendicionDeStock(cargaId: Identificador,\n      nota: Cadena): Booleano
}
class TruckLoadQueryService <<fachada>> {
  + consultarCargaActual(out exigida: Booleano): CargaDeCamion
  + consultarCargaDelCamion(cargaId: Identificador): CargaDeCamion
  + consultarCargasDelCamion(estado: Cadena, desde: Fecha,\n      hasta: Fecha, vehiculoId: Identificador,\n      choferId: Identificador): CargaDeCamion[*]
}
class StockControlSettingsService <<fachada>> {
  + configurarControlDeCargaAbierta(exigirCargaDeCamionAbierta: Booleano): ConfiguracionModulo
  + consultarControlDeCargaAbierta(): Booleano
}
class CancelTruckLoadUseCase <<controlador>> {
  + cancelarCargaDelCamion(cargaId: Identificador,\n      motivo: Cadena): CargaDeCamion
}
class "List<CargaDeCamion>" as List_CargaDeCamion <<colección>> {
  + buscar(estado: Cadena, desde: FechaHora,\n      hasta: FechaHora, vehiculoId: Identificador,\n      choferId: Identificador): CargaDeCamion[*]
}
class CargaDeCamion <<referencia>>
class "Map<String, Chofer>" as Map_String_Chofer <<referencia>>
class "Map<String, Deposito>" as Map_String_Deposito <<referencia>>
class "Map<String, Vehiculo>" as Map_String_Vehiculo <<referencia>>
class ItemCarga <<referencia>>
class StockLedgerService <<referencia>>
class UbicacionDeStock <<referencia>>
class Chofer <<referencia>>
class Vehiculo <<referencia>>
class ConfiguracionModulo <<referencia>>
class Distribuidora <<referencia>>

Map_String_CargaDeCamion "1" o--> "0..*" CargaDeCamion
List_CargaDeCamion "1" o--> "0..*" CargaDeCamion
CancelTruckLoadUseCase --> "1" Map_String_CargaDeCamion
CloseTruckLoadUseCase --> "1" Map_String_CargaDeCamion
DepartTruckLoadUseCase --> "1" Map_String_CargaDeCamion
OpenTruckLoadUseCase --> "1" Map_String_Chofer
OpenTruckLoadUseCase --> "1" Map_String_Deposito
OpenTruckLoadUseCase --> "1" Map_String_Vehiculo
ReloadTruckLoadUseCase --> "1" Map_String_CargaDeCamion
ReturnTruckLoadUseCase --> "1" Map_String_CargaDeCamion
TruckLoadQueryService --> "1" List_CargaDeCamion
TruckLoadQueryService --> "1" Map_String_CargaDeCamion
TruckLoadQueryService --> "1" Map_String_Chofer
UpdateTruckLoadItemsUseCase --> "1" Map_String_CargaDeCamion
CancelTruckLoadUseCase ..> CargaDeCamion
CloseTruckLoadUseCase ..> CargaDeCamion
CloseTruckLoadUseCase ..> ItemCarga
CloseTruckLoadUseCase ..> StockLedgerService
DepartTruckLoadUseCase ..> CargaDeCamion
DepartTruckLoadUseCase ..> StockLedgerService
DepartTruckLoadUseCase ..> UbicacionDeStock
List_CargaDeCamion ..> CargaDeCamion
OpenTruckLoadUseCase ..> "<<create>>" CargaDeCamion
OpenTruckLoadUseCase ..> Chofer
OpenTruckLoadUseCase ..> Vehiculo
ReloadTruckLoadUseCase ..> CargaDeCamion
ReloadTruckLoadUseCase ..> ItemCarga
ReloadTruckLoadUseCase ..> StockLedgerService
ReturnTruckLoadUseCase ..> CargaDeCamion
ReturnTruckLoadUseCase ..> Chofer
StockControlSettingsService ..> ConfiguracionModulo
StockControlSettingsService ..> Distribuidora
TruckLoadGateService ..> CargaDeCamion
TruckLoadGateService ..> Chofer
TruckLoadGateService ..> Distribuidora
TruckLoadQueryService ..> CargaDeCamion
TruckLoadQueryService ..> Chofer
TruckLoadQueryService ..> Distribuidora
UpdateTruckLoadItemsUseCase ..> CargaDeCamion

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran sólo como referencia.
endlegend
@enduml
