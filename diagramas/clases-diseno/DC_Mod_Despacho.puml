@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class DispatchOrchestratorService <<fachada>> {
  + distribuidorasConOfertasVencidas(): Distribuidora[*]
  + ensureOffered(pedido: Pedido)
  + handleExpiredOffers(corren: Distribuidora[*])
  + ofrecerAlSiguienteChofer(pedidoId: Identificador = ninguno,\n      pedido: Pedido = ninguno): Chofer
}
class DispatchService <<fachada>> {
  + vencerOfertasExpiradas()
}
interface DispatchOfferRepositoryPort <<puerto>> {
  + findExpired(ahora: FechaHora): OfertaDespacho[*]
}
interface RealtimeDispatchPort <<puerto>> {
  + findNearbyDrivers(destino: Coordenada,\n      radioKm: Decimal): Chofer[*]
  + notifyAdmins(pedido: Pedido = ninguno,\n      evento: Registro = ninguno,\n      aviso: AvisoRecupero = ninguno)
  + notifyCustomer(cliente: Cliente, pedido: Pedido,\n      tipo: Cadena)
  + notifyDriverNewOrder(chofer: Chofer, pedido: Pedido)
  + notifyDriverOrderCancelled(choferAnterior: Chofer,\n      pedido: Pedido)
  + stopTracking(choferAnterior: Chofer)
}
class RouteBatchPlannerService <<fachada>> {
  + aceptarRecorrido(recorrido: LoteRecorrido)
  + agruparPedidosPorRecorrido()
  + agruparPorProximidad(pedidos: Pedido[*]): LoteRecorrido[*]
}
class DispatchSettingsService <<fabricación pura>> {
  + obtener(distribuidora: Distribuidora): Registro
}
class ScheduledTasksSettingsService <<fabricación pura>> {
  + distribuidorasQueCorren(tareaProgramada: Cadena,\n      distribuidoras: Distribuidora[*]): Distribuidora[*]
}
class DeliveryService <<fachada>> {
  + activarDisponibilidad(usuario: Usuario): Registro
}
class "Map<String, Chofer>" as Map_String_Chofer <<colección>> {
  + get(clave: Cadena): Chofer
}
class DriversGateway <<fachada>> {
  + actualizarUbicacion(usuario: Usuario, latitud: Decimal,\n      longitud: Decimal)
}
class CustomersGateway <<fabricación pura>> {
  + notifyCustomer(cliente: Cliente, evento: Registro,\n      posicion: UbicacionGPS)
}
class AdminGateway <<fabricación pura>> {
  + notifyAdmins(evento: Registro, posicion: UbicacionGPS)
}
class NotificationsService <<fabricación pura>> {
  + escalateToAdmin(caso: CasoRecupero)
  + sendBatchOffer(chofer: Chofer, recorrido: LoteRecorrido)
  + sendOfferPushToDriver(chofer: Chofer, pedido: Pedido)
  + sendRecoveryStep(caso: CasoRecupero, escalon: Entero)
  + sendRepurchaseInvitation(cliente: Cliente,\n      invitacion: InvitacionRecompra)
  + sendWindowProposal(propuesta: PropuestaVentanaTaller)
}
class Chofer <<referencia>>
class "Map<String, Pedido>" as Map_String_Pedido <<referencia>>
class OrderService <<referencia>>
class OrderRepositoryPort <<referencia>>
class UbicacionGPS <<referencia>>
class OfertaDespacho <<referencia>>
class Pedido <<referencia>>
class TruckLoadGateService <<referencia>>
class LoteRecorrido <<referencia>>

Map_String_Chofer "1" o--> "0..*" Chofer
DeliveryService --> "1" Map_String_Chofer
DispatchOrchestratorService --> "1" DispatchOfferRepositoryPort
DispatchOrchestratorService --> "1" DispatchSettingsService
DispatchOrchestratorService --> "1" Map_String_Pedido
DispatchOrchestratorService --> "1" NotificationsService
DispatchOrchestratorService --> "1" RealtimeDispatchPort
DispatchService --> "1" DispatchOrchestratorService
DispatchService --> "1" OrderService
DispatchService --> "1" ScheduledTasksSettingsService
DriversGateway --> "1" AdminGateway
DriversGateway --> "1" CustomersGateway
RouteBatchPlannerService --> "1" NotificationsService
RouteBatchPlannerService --> "1" OrderRepositoryPort
DeliveryService ..> Chofer
DeliveryService ..> UbicacionGPS
DispatchOrchestratorService ..> Chofer
DispatchOrchestratorService ..> OfertaDespacho
DispatchOrchestratorService ..> Pedido
DispatchOrchestratorService ..> TruckLoadGateService
DriversGateway ..> Chofer
RouteBatchPlannerService ..> Chofer
RouteBatchPlannerService ..> "<<create>>" LoteRecorrido

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
