@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class AuthService <<fachada>> {
  + iniciarSesion(correo: Cadena,\n      contrasena: Cadena): Registro
}
class RegistroService <<fachada>> {
  + autorizarAlta(solicitante: Usuario,\n      distribuidoraId: Identificador,\n      rolChofer: TipoDeRol = ninguno,\n      rol: Rol = ninguno): Usuario
  + crearPrimerSuperAdministrador(nombreCompleto: Cadena,\n      correo: Cadena, telefono: Cadena,\n      contrasena: Cadena): Usuario
  + registrar(datosPersonales: Registro, rol: Rol,\n      distribuidoraId: Identificador): Usuario
  + registrarAdministrador(nombreCompleto: Cadena,\n      correo: Cadena, telefono: Cadena,\n      contrasena: Cadena, rol: Cadena,\n      distribuidoraId: Identificador): Usuario
  + registrarChoferEnLaFlota(datosPersonales: Registro,\n      datosDelChofer: Registro,\n      distribuidoraId: Identificador): Usuario
  + registrarse(nombreCompleto: Cadena, correo: Cadena,\n      telefono: Cadena, contrasena: Cadena,\n      datosDelCliente: Registro): Usuario
}
interface FirebaseAuthPort <<puerto>> {
  + createUserSafe(correo: Cadena, contrasena: Cadena,\n      nombreCompleto: Cadena, telefono: Cadena): Registro
  + deleteUserSafe(cuenta: Registro)
  + generatePasswordResetLink(correo: Cadena,\n      ajustes: Registro): Cadena
  + signInWithEmailAndPassword(correo: Cadena,\n      contrasena: Cadena): Registro
  + updateUser(cuenta: Registro,\n      deshabilitada: Booleano = ninguno,\n      correoNuevo: Cadena = ninguno)
  + verifyIdToken(token: Cadena)
}
interface FcmPort <<puerto>> {
  + sendToToken(token: Cadena,\n      notificacion: Registro = ninguno,\n      confirmacion: Cadena = ninguno)
}
class "Map<String, Usuario>" as Map_String_Usuario <<referencia>>
class "List<Administrador>" as List_Administrador <<referencia>>
class Usuario <<referencia>>
class Administrador <<referencia>>
class Chofer <<referencia>>
class Cliente <<referencia>>
class Empleado <<referencia>>
class NotificationsService <<referencia>>

AuthService --> "1" FirebaseAuthPort
AuthService --> "1" Map_String_Usuario
RegistroService --> "1" FirebaseAuthPort
RegistroService --> "1" List_Administrador
RegistroService --> "1" Map_String_Usuario
AuthService ..> Usuario
RegistroService ..> "<<create>>" Administrador
RegistroService ..> "<<create>>" Chofer
RegistroService ..> "<<create>>" Cliente
RegistroService ..> Empleado
RegistroService ..> "<<create>>" Usuario
NotificationsService --> "1" FcmPort

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
