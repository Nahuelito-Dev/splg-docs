@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

class Cliente {
  - consumoMensualDeclarado: Decimal
  - diasDeAviso: Entero
  + «create» Cliente(usuario: Usuario,\n      datosDelCliente: Registro = ninguno,\n      ubicacion: UbicacionGPS = ninguno)
  + actualizarConsumo(cantidadPorMes: Decimal)
  + actualizarUbicacion(coordenadas: Coordenada)
  + configurarAviso(dias: Entero)
  + crearCarrito(distribuidoraId: Identificador): Carrito
  + darDeBaja()
  + declararConsumo(tipoGarrafa: Cadena,\n      cantidadPorMes: Decimal)
  + desmarcarLasDemas(direccion: DireccionEntrega)
  + desmarcarPredeterminadas()
  + getCarrito(distribuidoraId: Identificador): Carrito
  + getCuentaCorriente(distribuidoraId: Identificador): CuentaCorriente
  + getDireccion(direccionId: Identificador): DireccionEntrega
  + getDirecciones(): DireccionEntrega[*]
  + getDireccionPredeterminada(): DireccionEntrega
  + getFechaEstimadaDeRecompra(): Fecha
  + getToken(): Cadena
  + presentarReclamo(pedido: Pedido, motivo: Cadena,\n      evidencia: Archivo): Reclamo
  + promoverOtraPredeterminada()
  + registrarDireccion(datos: Registro): DireccionEntrega
  + registrarEstimacion(fechaEstimada: Fecha)
  + validarRango(cantidadPorMes: Decimal = ninguno,\n      dias: Entero = ninguno)
  + validarSinCuentaCorriente(distribuidoraId: Identificador)
}
class DireccionEntrega {
  - calleYAltura: Cadena
  - pisoYDepartamento: Cadena
  - punto: Coordenada
  - precision: PrecisionDeGeocodificacion
  - predeterminada: Booleano
  + «create» DireccionEntrega(datos: Registro,\n      punto: Coordenada,\n      precision: PrecisionDeGeocodificacion,\n      predeterminada: Booleano)
  + darDeBaja()
  + editar(cambios: Registro)
  + esDelUsuario(usuario: Usuario): Booleano
  + marcarPredeterminada()
  + validarCoordenadas(cambios: Registro)
}
class InvitacionRecompra {
  - agotamientoEstimado: FechaHora
  + «create» InvitacionRecompra(cliente: Cliente,\n      fechaEstimada: Fecha, vigencia: FechaHora)
  + aceptar(): Registro
  + validarVigencia()
}
class ItemSugerido {
  - cantidad: Entero
  + «create» ItemSugerido(producto: Producto,\n      cantidad: Entero)
}
class Usuario <<referencia>>
class Pedido <<referencia>>
class Producto <<referencia>>

Usuario <|-- Cliente : {overlapping, incomplete}
Cliente "1" *-- "0..*" DireccionEntrega : registra
Cliente "1" -- "0..*" Pedido : realiza
Cliente "1" -- "0..*" InvitacionRecompra : recibe
Cliente "0..*" -- "0..1" Producto : usa habitualmente
InvitacionRecompra "0..1" -- "0..1" Pedido : se convierte en
InvitacionRecompra "1" *--> "1..*" ItemSugerido : sugiere
InvitacionRecompra "0..*" -- "0..1" DireccionEntrega : sugiere entregar en
ItemSugerido "0..*" -- "1" Producto : corresponde a
Pedido "0..*" -- "1" DireccionEntrega : se entrega en

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
