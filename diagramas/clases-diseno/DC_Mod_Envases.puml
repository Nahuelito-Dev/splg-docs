@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class CylinderService <<fachada>> {
  + asignarEnvasesAPedido(pedidoId: Identificador,\n      numerosDeSerie: Lista): Envase[*]
  + consultarEnvase(envaseId: Identificador): Envase
  + consultarEnvasesProximosAVencer(dias: Entero): Envase[*]
  + consultarHistorialDelEnvase(envaseId: Identificador): MovimientoEnvase[*]
  + consultarVigenciaDelEnvase(envaseId: Identificador): FechaHora
  + darDeAltaEnvase(numeroDeSerie: Cadena,\n      tipoDeProducto: Cadena, deposito: Moneda): Envase
  + listarEnvases(estado: Cadena): Envase[*]
  + registrarMovimientoDeEnvase(envaseId: Identificador,\n      estadoDestino: EstadoDelEnvase,\n      pedidoId: Identificador,\n      observacion: Cadena): Envase
  + registrarRevisionDeEnvase(envaseId: Identificador,\n      fecha: Fecha, resultado: Cadena,\n      vencimiento: Fecha): Envase
  + verificarVigenciaAlAsignar(pedidoId: Identificador,\n      series: Lista): Envase[*]
}
class "Map<String, Envase>" as Map_String_Envase <<colección>> {
  + get(clave: Cadena): Envase
  + values(distribuidora: Distribuidora,\n      estado: Cadena): Envase[*]
}
class Envase <<referencia>>
class "Map<String, Pedido>" as Map_String_Pedido <<referencia>>
class Distribuidora <<referencia>>
class Pedido <<referencia>>

Map_String_Envase "1" o--> "0..*" Envase
CylinderService --> "1" Map_String_Envase
CylinderService --> "1" Map_String_Pedido
CylinderService ..> Distribuidora
CylinderService ..> Envase
CylinderService ..> Pedido

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
