@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

skinparam nodesep 30
skinparam ranksep 70
skinparam package {
  BackgroundColor #FFFFFF
}
package "Acceso" as area_Acceso #EEF3F8 {
  package "auth" as auth {
  }
  package "registro" as registro {
  }
  package "users" as users {
  }
  package "firebase" as firebase {
  }
}
package "Negocio" as area_Negocio #F7F3E8 {
  package "order" as order {
  }
  package "payments" as payments {
  }
  package "cart" as cart {
  }
  package "customer" as customer {
  }
  package "repurchase" as repurchase {
  }
  package "claims" as claims {
  }
  package "time-slot" as time_slot {
  }
  package "coverage-zone" as coverage_zone {
  }
  package "gascylinder" as gascylinder {
  }
  package "cylinder" as cylinder {
  }
  package "distributor" as distributor {
  }
}
package "Flota y despacho" as area_Flota_y_despacho #EEF5EF {
  package "delivery" as delivery {
  }
  package "car" as car {
  }
  package "fleet" as fleet {
  }
  package "gateways" as gateways {
  }
}
package "Personal" as area_Personal #F5EEF3 {
}
package "Soporte" as area_Soporte #F2F2F2 {
  package "notifications" as notifications {
  }
}
package "Stock y compras" as area_Stock_y_compras #F4EEF7 {
  package "stock" as stock {
  }
  package "truck-load" as truck_load {
  }
}
auth ..> firebase
auth ..> users
car ..> fleet
claims ..> customer
claims ..> order
customer ..> claims
cylinder ..> notifications
cylinder ..> order
fleet ..> car
fleet ..> notifications
gateways ..> delivery
order ..> cart
order ..> coverage_zone
order ..> customer
order ..> cylinder
order ..> delivery
order ..> distributor
order ..> fleet
order ..> gascylinder
order ..> notifications
order ..> payments
order ..> stock
order ..> time_slot
order ..> truck_load
registro ..> customer
registro ..> firebase
registro ..> users
repurchase ..> customer
repurchase ..> notifications

legend bottom right
  Cada flecha punteada es una dependencia entre módulos: alguna clase del origen le manda
  un mensaje, en algún DSD, a una clase del destino.
endlegend
@enduml
