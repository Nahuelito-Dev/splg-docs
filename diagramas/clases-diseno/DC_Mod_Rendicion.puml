@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class DriverSettlementService <<fachada>> {
  + aprobarRendicion(rendicionId: Identificador,\n      cajaDestinoId: Identificador,\n      resolucionDeDiferencia: ResolucionDeDiferencia): RendicionChofer
  + declararEfectivoRendido(rendicionId: Identificador,\n      efectivoDeclarado: Moneda,\n      gastos: GastoDeRendicion[*]): RendicionChofer
  + reabrirRendicion(rendicionId: Identificador): RendicionChofer
}
class DriverSettlementCron <<fachada>> {
  + avisarRendicionesSinCerrar()
  + generarRendicionesDelDia()
}
class "Map<String, RendicionChofer>" as Map_String_RendicionChofer <<colección>> {
  + get(clave: Cadena): RendicionChofer
}
class "List<RendicionChofer>" as List_RendicionChofer <<colección>> {
  + getPendientes(fecha: Fecha): RendicionChofer[*]
  + getSinCerrarDeDiasAnteriores(hoy: Fecha): RendicionChofer[*]
}
class RendicionChofer <<referencia>>
class EmailSenderPort <<referencia>>
class "List<Chofer>" as List_Chofer <<referencia>>
class "Map<String, Caja>" as Map_String_Caja <<referencia>>
class Chofer <<referencia>>
class Distribuidora <<referencia>>

Map_String_RendicionChofer "1" o--> "0..*" RendicionChofer
List_RendicionChofer "1" o--> "0..*" RendicionChofer
DriverSettlementCron --> "1" EmailSenderPort
DriverSettlementCron --> "1" List_Chofer
DriverSettlementCron --> "1" List_RendicionChofer
DriverSettlementService --> "1" Map_String_Caja
DriverSettlementService --> "1" Map_String_RendicionChofer
DriverSettlementCron ..> Chofer
DriverSettlementCron ..> Distribuidora
DriverSettlementCron ..> RendicionChofer
DriverSettlementService ..> RendicionChofer

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran solo como referencia.
endlegend
@enduml
