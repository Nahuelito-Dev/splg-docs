@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam genericDisplay old
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #F3E9CF
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #DCEBDD
}
skinparam interface {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBDD
  FontSize 14
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide empty members

left to right direction
skinparam nodesep 25
skinparam ranksep 90
class DriverSettlementService <<fachada>> {
  + aprobarRendicion(rendicionId: Identificador,\n      cajaDestinoId: Identificador,\n      resolucionDeDiferencia: ResolucionDeDiferencia): RendicionChofer
  + declararEfectivoRendido(rendicionId: Identificador,\n      efectivoDeclarado: Moneda,\n      gastos: GastoDeRendicion[*]): RendicionChofer
  + reabrirRendicion(rendicionId: Identificador): RendicionChofer
}
class DriverSettlementCron <<fachada>> {
  + generarRendicionesDelDia()
}
class SettlementOverdueCron <<fachada>> {
  + avisarRendicionesSinCerrar()
}
class "Map<String, RendicionChofer>" as Map_String_RendicionChofer <<colección>> {
  + get(clave: Cadena): RendicionChofer
}
class "List<RendicionChofer>" as List_RendicionChofer <<colección>> {
  + getPendientes(fecha: Fecha): RendicionChofer[*]
  + getSinCerrarDeDiasAnteriores(hoy: Fecha): RendicionChofer[*]
}
class RendicionChofer <<referencia>>
class "List<Chofer>" as List_Chofer <<referencia>>
class "Map<String, Caja>" as Map_String_Caja <<referencia>>
class EmailSenderPort <<referencia>>
class Chofer <<referencia>>
class Distribuidora <<referencia>>

Map_String_RendicionChofer "1" o--> "0..*" RendicionChofer
List_RendicionChofer "1" o--> "0..*" RendicionChofer
DriverSettlementCron --> "1" List_Chofer
DriverSettlementService --> "1" Map_String_Caja
DriverSettlementService --> "1" Map_String_RendicionChofer
SettlementOverdueCron --> "1" EmailSenderPort
SettlementOverdueCron --> "1" List_RendicionChofer
DriverSettlementCron ..> Chofer
DriverSettlementService ..> RendicionChofer
SettlementOverdueCron ..> Distribuidora
SettlementOverdueCron ..> RendicionChofer

legend bottom right
  Las clases en gris pertenecen a otra vista o a otro módulo; se muestran sólo como referencia.
endlegend
@enduml
