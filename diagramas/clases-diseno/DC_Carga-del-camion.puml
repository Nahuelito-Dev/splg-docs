@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam dpi 150
skinparam nodesep 40
skinparam ranksep 55
skinparam classAttributeIconSize 0
skinparam roundCorner 0
skinparam genericDisplay old
skinparam class {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  ArrowColor #2C4257
  FontSize 14
  AttributeFontSize 12
  HeaderBackgroundColor #E8EEF3
}
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #D6E4F0
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #F3E9CF
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #DCEBDD
}
skinparam interface {
  BorderColor #2C4257
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBDD
  FontSize 14
  AttributeFontSize 12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #2C4257
}
skinparam packageStyle rectangle
skinparam package {
  BorderColor #8A97A3
  FontSize 13
  FontColor #55616C
}
hide circle
hide empty members

class CargaDeCamion {
  - numero: Entero
  - dia: Fecha
  - estado: EstadoDeLaCarga
  - abiertaEl: FechaHora
  - salioEl: FechaHora
  - regresoEl: FechaHora
  - cerradaEl: FechaHora
  - notaDeDiferencia: Cadena
  + «create» CargaDeCamion(chofer: Chofer, deposito: Moneda,\n      ayudanteId: Identificador, autor: Usuario)
  + cancelar(): CargaDeCamion
  + cerrar(nota: Cadena, autor: Usuario): CargaDeCamion
  + getEstado(): EstadoDeLaCarga
  + getItems()
  + registrarRegreso(devueltos: Registro,\n      ahora: FechaHora): CargaDeCamion
  + reponer(items: Registro): CargaDeCamion
  + salir(ahora: FechaHora): CargaDeCamion
  + validarNotaDeDiferencia(nota: Cadena)
  + validarQueEstaAbierta()
  + validarQueEstaCargando()
  + validarQueEstaEnRuta()
  + validarQueRegreso()
}
class ItemCarga {
  - llenasCargadas: Entero
  - llenasRepuestas: Entero
  - vaciasCargadas: Entero
  - llenasDeclaradasAlRegreso: Entero
  - vaciasDeclaradasAlRegreso: Entero
  - llenasEntregadas: Entero
  - vaciasRecolectadas: Entero
  - /llenasEsperadas: Entero
  - /vaciasEsperadas: Entero
  - diferenciaDeLlenas: Entero
  - diferenciaDeVacias: Entero
  + «create» ItemCarga(producto: Producto,\n      llenasCargadas: Entero, vaciasCargadas: Entero)
  + calcularDiferencia()
  + calcularEsperado()
  + declararRegreso(llenasDevueltas: Entero,\n      vaciasDevueltas: Entero)
  + getEsperado()
  + getProducto(): Producto
  + sumarRepuesto(llenasRepuestas: Entero)
}
class Vehiculo <<referencia>>
class Chofer <<referencia>>
class UbicacionDeStock <<referencia>>
class Producto <<referencia>>
class Usuario <<referencia>>
class Pedido <<referencia>>

Usuario <|-- Chofer : {overlapping, incomplete}
Vehiculo "1" --> "0..*" CargaDeCamion : transporta
Chofer "1" -- "0..*" CargaDeCamion : reparte con
CargaDeCamion "0..*" -- "1" UbicacionDeStock : parte de
CargaDeCamion "1" *--> "1..*" ItemCarga : contiene
ItemCarga "0..*" -- "1" Producto : corresponde a
Usuario "1" -- "0..*" CargaDeCamion : abre
Usuario "0..1" -- "0..*" CargaDeCamion : cierra

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran sólo como referencia.
endlegend
@enduml
