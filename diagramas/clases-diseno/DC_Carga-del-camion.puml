@startuml
!include ../estilo-vp.iuml
skinparam nodesep 40
skinparam ranksep 55
skinparam genericDisplay old
skinparam class<<referencia>> {
  BackgroundColor #F1F1F1
  BorderColor #8A97A3
  FontColor #55616C
}
skinparam class<<fachada>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<controlador>> {
  HeaderBackgroundColor #B7CDE8
}
skinparam class<<fabricación pura>> {
  HeaderBackgroundColor #E4ECF6
}
skinparam class<<colección>> {
  HeaderBackgroundColor #E6E6E6
}
skinparam class<<adaptador>> {
  HeaderBackgroundColor #D5E3F3
}
skinparam packageStyle rectangle
hide circle
hide empty members

class CargaDeCamion {
  - numero: Entero
  - dia: Fecha
  - estado: EstadoDeLaCarga
  - abiertaEl: FechaHora
  - salioEl: FechaHora
  - regresoEl: FechaHora
  - cerradaEl: FechaHora
  - notaDeDiferencia: Cadena
  - motivoDeCancelacion: Cadena
  - notas: Cadena
  + «create» CargaDeCamion(vehiculo: Vehiculo,\n      chofer: Chofer, deposito: Deposito,\n      ayudanteId: Identificador, administrador: Usuario)
  + cancelar(motivo: Cadena): CargaDeCamion
  + cerrar(nota: Cadena): CargaDeCamion
  + declararRegreso(devueltos: Registro): CargaDeCamion
  + estaEnRutaCon(vehiculoEnUso: Vehiculo): Booleano
  + getChofer(): Chofer
  + getEntregasPosterioresALaDeclaracion(): Entero
  + getEstado(): EstadoDeLaCarga
  + getItems(): Registro
  + getMovimientos(): MovimientoDeCaja[*]
  + getPedidosEntregados(): Pedido[*]
  + getUbicacionDelCamion(): UbicacionDeStock
  + getUbicacionDelDeposito(): UbicacionDeStock
  + marcarEnRuta()
  + previsualizarCierre(): Booleano
  + reemplazarRenglones(items: Registro): CargaDeCamion
  + validarNotaDeDiferencia(nota: Cadena)
  + validarQueEstaDevuelta()
  + validarQueEstaEnCarga()
  + validarQueEstaEnRuta()
  + validarQuePuedeDeclararElRegreso()
  + validarQuePuedeSalir()
}
class ItemCarga {
  - llenasCargadas: Entero
  - llenasRepuestas: Entero
  - vaciasCargadas: Entero
  - llenasDeclaradasAlRegreso: Entero
  - vaciasDeclaradasAlRegreso: Entero
  - llenasEntregadas: Entero
  - vaciasRecolectadas: Entero
  - /llenasEsperadas: Entero
  - /vaciasEsperadas: Entero
  - diferenciaDeLlenas: Entero
  - diferenciaDeVacias: Entero
  + «create» ItemCarga(producto: Producto,\n      llenasCargadas: Entero, vaciasCargadas: Entero)
  + calcularDiferencia(): Entero
  + calcularEsperado(): Entero
  + declarar(llenasDeclaradas: Entero,\n      vaciasDeclaradas: Entero)
  + getEsperado(): Entero
  + sumarRepuesto(llenasRepuestas: Entero)
}
class Vehiculo <<referencia>>
class Chofer <<referencia>>
class UbicacionDeStock <<referencia>>
class Producto <<referencia>>
class Usuario <<referencia>>
class Empleado <<referencia>>

Usuario <|-- Chofer : {overlapping, incomplete}
Vehiculo "1" -- "0..*" CargaDeCamion : transporta
Chofer "1" -- "0..*" CargaDeCamion : reparte con
CargaDeCamion "0..*" -- "1" UbicacionDeStock : parte de
CargaDeCamion "1" *--> "1..*" ItemCarga : contiene
ItemCarga "0..*" -- "1" Producto : corresponde a
Usuario "1" -- "0..*" CargaDeCamion : abre
Usuario "0..1" -- "0..*" CargaDeCamion : cierra
Empleado "0..1" -- "0..*" CargaDeCamion : ayuda en

legend bottom right
  Las clases en gris pertenecen a otra vista; se muestran solo como referencia.
endlegend
@enduml
